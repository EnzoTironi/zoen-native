+/// Compact retained upstream tools, with the canonical host owning export/file lifetime.
+pub fn managed_bar(app: &mut PdfCraftApp, ui: &mut egui::Ui) {
+    let tokens = Tokens::get(ui.ctx());
+    egui::Panel::top("managed_pdf_tools")
+        .exact_size(48.0)
+        .frame(egui::Frame::NONE.fill(tokens.chrome).inner_margin(egui::Margin::symmetric(6, 2)))
+        .show(ui, |ui| {
+            egui::ScrollArea::horizontal().id_salt("managed_pdf_tools_scroll").auto_shrink([false, false]).show(ui, |ui| {
+                ui.horizontal_centered(|ui| {
+                    ui.spacing_mut().item_spacing.x = 2.0;
+                    for (id, icon, label, selected) in [
+                        ("edit.edit_text", "text-cursor-input", "Edit text & images", matches!(app.quick_tool, crate::QuickTool::EditText)),
+                        (
+                            "comment.highlight",
+                            "highlighter",
+                            "Highlight text",
+                            matches!(app.quick_tool, crate::QuickTool::Comment(crate::comments::CommentTool::Highlight)),
+                        ),
+                        (
+                            "comment.ink",
+                            "pencil",
+                            "Draw freehand",
+                            matches!(app.quick_tool, crate::QuickTool::Comment(crate::comments::CommentTool::Ink)),
+                        ),
+                        ("edit.undo", "undo-2", "Undo", false),
+                        ("edit.redo", "redo-2", "Redo", false),
+                        ("file.save", "share-2", "Share PDF", false),
+                    ] {
+                        let enabled = pdfcraft_engine::commands::command(id).is_some_and(|spec| app.command_enabled(spec));
+                        if ui.add_enabled_ui(enabled, |ui| icons::button(ui, icon, 44.0, selected, tl!(label))).inner.clicked() {
+                            app.execute(id);
+                        }
+                    }
+                    let more = icons::button(ui, "ellipsis", 44.0, false, tl!("More tools"));
+                    egui::Popup::menu(&more).show(|ui| {
+                        for (id, label) in [
+                            ("view.read_mode", "Read mode"),
+                            ("edit.text", "Add text"),
+                            ("page.organize", "Organize pages"),
+                            ("comment.list", "Comments"),
+                            ("file.properties", "Document properties"),
+                        ] {
+                            let enabled = pdfcraft_engine::commands::command(id).is_some_and(|spec| app.command_enabled(spec));
+                            if ui.add_enabled(enabled, egui::Button::new(tl!(label))).clicked() {
+                                app.execute(id);
+                                ui.close();
+                            }
+                        }
+                    });
+                });
+            });
+        });
+}
