 impl Session {
+    /// Retain real COS/Undo/Redo before an embedded operation can fail host validation.
+    pub fn managed_checkpoint(&self, id: DocId) -> Result<ManagedCheckpoint, EditError> {
+        let binding = self.managed_binding.ok_or(EditError::NoDocument)?;
+        if self.managed_document != Some(id) || self.docs.len() != 1 {
+            return Err(EditError::NoDocument);
+        }
+        let doc = self.get(id).ok_or(EditError::NoDocument)?;
+        if doc.xfa.is_some() || !doc.signatures.is_empty() {
+            return Err(EditError::ReadOnly("Unsupported managed checkpoint".into()));
+        }
+        Ok(ManagedCheckpoint {
+            binding,
+            id,
+            editor: doc.editor.as_ref().ok_or(EditError::NoDocument)?.clone(),
+            dirty: doc.dirty,
+            generation: doc.generation,
+            notices: doc.edit_notices.clone(),
+        })
+    }
+
+    /// Restore the same upstream editor after a refused proposal, including pre-existing redo.
+    /// This cannot cross a replaced document/host binding and grants no durable authorization.
+    pub fn managed_restore(&mut self, checkpoint: ManagedCheckpoint) -> Result<(), EditError> {
+        if self.managed_binding != Some(checkpoint.binding) || self.managed_document != Some(checkpoint.id) || self.docs.len() != 1 {
+            return Err(EditError::NoDocument);
+        }
+        let doc = self.docs.iter_mut().find(|doc| doc.id == checkpoint.id).ok_or(EditError::NoDocument)?;
+        doc.editor = Some(checkpoint.editor);
+        Self::refresh(doc)?;
+        doc.dirty = checkpoint.dirty;
+        doc.generation = checkpoint.generation;
+        doc.edit_notices = checkpoint.notices;
+        Ok(())
+    }
