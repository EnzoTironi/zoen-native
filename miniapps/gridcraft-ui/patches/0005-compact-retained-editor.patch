+//! A short embedded viewport keeps the existing live editor visible. No saved UI
+//! preference, document mutation, keyboard permission or synthetic focus is added.
+use crate::{SheetApp, formula_bar, grid, ribbon, tabs};
+use egui::{Context, Ui};
+use serde_json::json;
+
+pub(crate) fn active(app: &SheetApp, ctx: &Context) -> bool {
+    if app.chrome.title_bar || app.chrome.file_tab || app.editor.is_none() {
+        return false;
+    }
+    let formula = if app.session.prefs.formula_bar {
+        formula_bar::height(app)
+    } else {
+        0.0
+    };
+    let status = if app.ui.status_bar {
+        tabs::status_height(app)
+    } else {
+        0.0
+    };
+    let normal_chrome = ribbon::height(app) + formula + status + tabs::SHEET_TABS_HEIGHT;
+    // The real current safe canvas must fit the requested chrome plus column
+    // headings and an interaction row. No device model/orientation/keyboard guess.
+    let row = ctx.global_style().spacing.interact_size.y;
+    ctx.content_rect().height() < normal_chrome + grid::COL_HEADER_H + row
+}
+
+pub(crate) fn commands(app: &mut SheetApp, ui: &mut Ui) {
+    // The same catalog and run_or_alert boundary as the existing command palette.
+    // No auto-focused search field, fixed320pt dialog or new command authority.
+    let share = app.services.host_export_intent.is_some();
+    let label = app.ui.language.tr("Commands");
+    let menu = ui.menu_button(label, |ui| {
+        let catalog: Vec<_> = app
+            .session
+            .commands()
+            .into_iter()
+            .filter(|c| c.enabled)
+            .collect();
+
+        let safe = ui.ctx().content_rect();
+        let margin = ui.spacing().menu_margin.sum();
+        let height = (safe.height() - margin.y).max(1.0);
+        ui.set_max_width((safe.width() - margin.x).clamp(1.0, 420.0));
+        let row = ui.spacing().interact_size.y.max(20.0);
+        egui::ScrollArea::vertical()
+            .id_salt("compact_commands")
+            .min_scrolled_height(0.0)
+            .max_height(height)
+            .auto_shrink([false, true])
+            .show_rows(ui, row, catalog.len() + usize::from(share), |ui, rows| {
+                for index in rows {
+                    if share && index == 0 {
+                        if ui
+                            .add(
+                                egui::Button::new(app.ui.language.tr("Share"))
+                                    .min_size(egui::vec2(ui.available_width(), row)),
+                            )
+                            .clicked()
+                        {
+                            if let Some(export) = &app.services.host_export_intent {
+                                let _ = export("xlsx");
+                            }
+                            ui.close();
+                        }
+                        continue;
+                    }
+                    let Some(command) = index
+                        .checked_sub(usize::from(share))
+                        .and_then(|index| catalog.get(index))
+                    else {
+                        continue;
+                    };
+                    let response = ui.add(
+                        egui::Button::new(format!(
+                            "{}    {}",
+                            command.label,
+                            command.menu.join(" › ")
+                        ))
+                        .truncate()
+                        .min_size(egui::vec2(ui.available_width(), row)),
+                    );
+                    if response.clicked() {
+                        // Exactly the existing public UI command path, including
+                        // managed freeze/profile checks and ordinary refusals.
+                        app.run_or_alert(command.id, json!({}));
+                        ui.close();
+                    }
+                    response.on_hover_text(command.id);
+                }
+            });
+    });
+    if menu.inner.is_some() {
+        // Popup::show closes on Escape without consuming it. The same key must
+        // not also discard the retained editor behind this explicit menu.
+        ui.input_mut(|input| {
+            input.consume_key(egui::Modifiers::NONE, egui::Key::Escape);
+        });
+    }
+}
