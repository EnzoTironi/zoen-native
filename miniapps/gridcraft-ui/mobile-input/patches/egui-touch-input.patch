+//! Real TextEdit touch gestures must initialize the cursor in their release frame.
+use crate::text::CCursor;
+use crate::text_edit::TextEditOutput;
+use crate::{
+    Context, Event, FullOutput, Id, Modifiers, PointerButton, Pos2, RawInput, Rect, TextEdit,
+    TouchDeviceId, TouchId, TouchPhase, vec2,
+};
+
+struct Editor {
+    ctx: Context,
+    text: String,
+    time: f64,
+    multiline: bool,
+    enabled: bool,
+    interactive: bool,
+}
+impl Editor {
+    fn new(text: &str, multiline: bool) -> Self {
+        Self {
+            ctx: Context::default(),
+            text: text.into(),
+            time: 0.0,
+            multiline,
+            enabled: true,
+            interactive: true,
+        }
+    }
+    fn frame(
+        &mut self,
+        mut events: Vec<Event>,
+        modifiers: Modifiers,
+    ) -> (FullOutput, TextEditOutput) {
+        self.time += 0.05;
+        events.insert(0, Event::ModifiersChanged(modifiers));
+        let mut edit = None;
+        let mut full = self.ctx.run_ui(
+            RawInput {
+                screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(402.0, 874.0))),
+                events,
+                time: Some(self.time),
+                ..Default::default()
+            },
+            |ui| {
+                edit = Some(
+                    ui.add_enabled_ui(self.enabled, |ui| {
+                        let field = if self.multiline {
+                            TextEdit::multiline(&mut self.text)
+                        } else {
+                            TextEdit::singleline(&mut self.text)
+                        };
+                        field
+                            .id(Id::new("field"))
+                            .interactive(self.interactive)
+                            .hint_text("Add notes")
+                            .desired_rows(2)
+                            .show(ui)
+                    })
+                    .inner,
+                );
+            },
+        );
+        full.textures_delta.clear();
+        (full, edit.unwrap())
+    }
+    fn point(out: &TextEditOutput, index: usize) -> Pos2 {
+        out.galley_pos
+            + out
+                .galley
+                .pos_from_cursor(CCursor::new(index))
+                .center()
+                .to_vec2()
+    }
+    fn down(
+        &mut self,
+        at: Pos2,
+        touch: bool,
+        modifiers: Modifiers,
+    ) -> (FullOutput, TextEditOutput) {
+        let mut events = vec![
+            Event::PointerMoved(at),
+            Event::PointerButton {
+                pos: at,
+                button: PointerButton::Primary,
+                pressed: true,
+                modifiers,
+            },
+        ];
+        if touch {
+            events.push(touch_event(at, TouchPhase::Start));
+        }
+        self.frame(events, modifiers)
+    }
+    fn up(&mut self, at: Pos2, touch: bool, modifiers: Modifiers) -> (FullOutput, TextEditOutput) {
+        let mut events = vec![Event::PointerButton {
+            pos: at,
+            button: PointerButton::Primary,
+            pressed: false,
+            modifiers,
+        }];
+        if touch {
+            // This is eframe's real touch-end event order, not a synthetic click.
+            events.push(Event::PointerGone);
+            events.push(touch_event(at, TouchPhase::End));
+        }
+        self.frame(events, modifiers)
+    }
+    fn tap(&mut self, at: Pos2, touch: bool, modifiers: Modifiers) -> (FullOutput, TextEditOutput) {
+        self.down(at, touch, modifiers);
+        self.up(at, touch, modifiers)
+    }
+}
+fn touch_event(pos: Pos2, phase: TouchPhase) -> Event {
+    Event::Touch {
+        device_id: TouchDeviceId(0),
+        id: TouchId::from(7),
+        phase,
+        pos,
+        force: None,
+    }
+}
+fn selection(out: &TextEditOutput) -> std::ops::Range<usize> {
+    let range = out
+        .state
+        .cursor
+        .char_range()
+        .unwrap()
+        .as_sorted_char_range();
+    range.start.0..range.end.0
+}
+
+#[test]
+fn first_touch_on_empty_singleline_and_multiline_has_current_release_ime() {
+    for multiline in [false, true] {
+        let mut editor = Editor::new("", multiline);
+        let (_, field) = editor.frame(vec![], Modifiers::NONE);
+        let (full, field) = editor.tap(field.response.rect.center(), true, Modifiers::NONE);
+        assert!(field.response.clicked() && field.response.has_focus());
+        assert_eq!(selection(&field), 0..0);
+        assert!(
+            full.platform_output.ime.is_some(),
+            "the user-gesture release must publish IME now"
+        );
+        assert!(editor.text.is_empty(), "focus never inserts text");
+    }
+}
+
+#[test]
+fn first_touch_places_nonempty_cursor_at_real_pointer_not_default_end() {
+    let mut editor = Editor::new("alpha beta", true);
+    let (_, field) = editor.frame(vec![], Modifiers::NONE);
+    let at = Editor::point(&field, 2);
+    let (full, field) = editor.tap(at, true, Modifiers::NONE);
+    assert_eq!(selection(&field), 2..2);
+    assert!(full.platform_output.ime.is_some());
+    assert_eq!(editor.text, "alpha beta");
+}
+
+#[test]
+fn mouse_click_and_shift_extension_keep_their_cursor_semantics() {
+    let mut editor = Editor::new("alpha beta", true);
+    let (_, field) = editor.frame(vec![], Modifiers::NONE);
+    let at = Editor::point(&field, 2);
+    let (full, field) = editor.tap(at, false, Modifiers::NONE);
+    assert_eq!(selection(&field), 2..2);
+    assert!(full.platform_output.ime.is_some());
+    editor.time += 1.0; // A deliberate new single click, not a double click.
+    let at = Editor::point(&field, 7);
+    let modifiers = Modifiers {
+        shift: true,
+        ..Modifiers::NONE
+    };
+    let (_, field) = editor.tap(at, false, modifiers);
+    assert_eq!(selection(&field), 2..7);
+}
+
+#[test]
+fn touch_double_and_triple_click_keep_word_and_line_selection() {
+    let mut editor = Editor::new("alpha beta\nsecond", true);
+    let (_, field) = editor.frame(vec![], Modifiers::NONE);
+    let at = Editor::point(&field, 2);
+    editor.tap(at, true, Modifiers::NONE);
+    let (full, field) = editor.tap(at, true, Modifiers::NONE);
+    assert!(field.response.double_clicked());
+    assert_eq!(selection(&field), 0..5);
+    assert!(full.platform_output.ime.is_some());
+    let (full, field) = editor.tap(at, true, Modifiers::NONE);
+    assert!(field.response.triple_clicked());
+    assert_eq!(selection(&field), 0..10);
+    assert!(full.platform_output.ime.is_some());
+}
