+    /// Whether this widget was enabled and interactive in the last completed pass.
+    /// Unlike `read_response`, this observes output without replaying pointer
+    /// interaction or surrendering the current text owner on a trigger handoff.
+    #[must_use]
+    pub fn last_pass_widget_enabled(&self, id: Id) -> bool {
+        self.read(|ctx| {
+            let Some(viewport) = ctx.viewports.get(&ctx.viewport_id()) else {
+                return false;
+            };
+            viewport.prev_pass.widgets.get(id).is_some_and(|widget| {
+                widget.enabled && ctx.memory.allows_interaction(widget.layer_id)
+            })
+        })
+    }
