+//! A real custom field trigger may admit only its same document/cell editor on release.
+//! This is transient UI ownership, never workbook content or a keyboard permission clock.
+use crate::SheetApp;
+use egui::{Id, PointerButton, Response, Ui};
+use gridcraft_engine::core::CellRef;
+
+const PULSE: &str = "eframe.text_input_activation";
+
+pub(crate) fn scope(app: &SheetApp, cell: CellRef, formula: bool) -> Option<Id> {
+    let d = app.session.active()?;
+    let sh = d.wb.active()?;
+    let cell = sh.merge_at(cell).map_or(cell, |range| range.start);
+    Some(Id::new(("gridcraft-text", d.uid, d.wb.active_sheet, cell.row, cell.col, formula)))
+}
+
+fn cancelled(ui: &Ui) -> bool {
+    ui.input(|input| {
+        let mut first = None;
+        let multiple_starts = input.events.iter().any(|event| {
+            if let egui::Event::Touch { device_id, id, phase: egui::TouchPhase::Start, .. } = event {
+                let key = (*device_id, *id);
+                let previous = first.replace(key);
+                previous.is_some_and(|previous| previous != key)
+            } else {
+                false
+            }
+        });
+        multiple_starts
+            || input.multi_touch().is_some()
+            || input.events.iter().any(|event| matches!(event, egui::Event::Touch { phase: egui::TouchPhase::Cancel, .. }))
+            || (input.events.iter().any(|event| matches!(event, egui::Event::PointerGone)) && !input.pointer.primary_released())
+    })
+}
+
+pub(crate) fn contact(ui: &Ui, response: &Response, target: Option<Id>) {
+    let key = response.id.with("text-contact");
+    if cancelled(ui) || !ui.is_enabled() {
+        ui.data_mut(|data| data.remove::<Option<Id>>(key));
+    } else if response.is_pointer_button_down_on() && ui.input(|input| input.pointer.primary_pressed()) {
+        ui.data_mut(|data| data.insert_temp(key, target));
+    }
+}
+
+pub(crate) fn trigger(ui: &Ui, response: &Response, target: Option<Id>) -> bool {
+    target.is_some()
+        && ui.is_enabled()
+        && !cancelled(ui)
+        && !response.dragged()
+        && ui.input(|input| input.pointer.primary_released())
+        && response.clicked_by(PointerButton::Primary)
+        && ui.data(|data| data.get_temp::<Option<Id>>(response.id.with("text-contact"))).flatten() == target
+}
+
+pub(crate) struct RenderedText {
+    widget: Id,
+    owner: Id,
+    frame: u64,
+    ime: egui::output::IMEOutput,
+}
+
+pub(crate) fn rendered(
+    app: &SheetApp,
+    ui: &Ui,
+    widget: Id,
+    cell: CellRef,
+    formula: bool,
+    output: &egui::text_edit::TextEditOutput,
+) -> Option<RenderedText> {
+    if !output.response.enabled() || !ui.is_rect_visible(output.text_clip_rect) {
+        return None;
+    }
+    let cursor = output.state.cursor.char_range()?.primary;
+    let cursor_rect = output.galley.pos_from_cursor(cursor).translate(output.galley_pos.to_vec2());
+    let global = ui.ctx().layer_transform_to_global(ui.layer_id()).unwrap_or_default();
+    Some(RenderedText {
+        widget,
+        owner: scope(app, cell, formula)?,
+        frame: ui.ctx().cumulative_frame_nr(),
+        ime: egui::output::IMEOutput {
+            purpose: egui::IMEPurpose::Normal,
+            rect: global * output.text_clip_rect,
+            cursor_rect: global * cursor_rect,
+            should_interrupt_composition: false,
+        },
+    })
+}
+
+pub(crate) fn publish(app: &SheetApp, ui: &Ui, response: &Response, formula: bool, rendered: Option<RenderedText>) {
+    if !ui.input(|input| input.pointer.primary_released()) {
+        return;
+    }
+    let armed = ui.data_mut(|data| data.remove_temp::<Option<Id>>(response.id.with("text-contact"))).flatten();
+    let Some(ed) = app.editor.as_ref().filter(|ed| ed.from_formula_bar == formula) else { return };
+    if !app.session.active().is_some_and(|d| d.wb.active_sheet == ed.sheet) {
+        return;
+    }
+    let Some(rendered) = rendered else { return };
+    let widget = Id::new(if formula { "gridcraft.formula_bar" } else { "gridcraft.cell_editor" });
+    if rendered.widget == widget
+        && rendered.frame == ui.ctx().cumulative_frame_nr()
+        && Some(rendered.owner) == scope(app, ed.cell, formula)
+        && armed.is_some()
+        && armed == scope(app, ed.cell, formula)
+        && !app.session.managed_frozen
+        && ui.is_enabled()
+        && !cancelled(ui)
+        && !response.dragged()
+        && response.clicked_by(PointerButton::Primary)
+    {
+        // The real release belongs to the label/grid trigger, not to the new
+        // TextEdit. Advertise only that admitted editor's actual rendered caret
+        // in this same frame; do not alter global click/focus policy or events.
+        ui.memory_mut(|memory| memory.request_focus(widget));
+        ui.output_mut(|output| output.ime = Some(rendered.ime));
+        let pulse = Some((ui.ctx().cumulative_frame_nr(), widget));
+        ui.data_mut(|data| data.insert_temp(Id::new(PULSE), pulse));
+    }
+}
