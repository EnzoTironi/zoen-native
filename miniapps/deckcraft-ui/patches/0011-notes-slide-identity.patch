+#[test]
+fn hosted_denied_notes_retry_resolves_original_slide_after_reorder() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    h.state_mut().app.run("slide.new", json!({"at":1,"layout":"blank"})).unwrap();
+    h.state_mut().app.run("slide.go", json!({"index":0})).unwrap();
+    h.run_steps(2);
+    let origin = h.state().app.session.active().unwrap().doc.slides[0].id;
+    type_hosted_notes(&mut h, "Only the original slide may receive this");
+    h.state_mut().app.session.command_policy =
+        Some(|id, _| if id == "slide.notes" { Err(deckcraft_engine::EngineError::Other("notes rejected".into())) } else { Ok(()) });
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    assert!(h.state().app.notes_buf.2.edited);
+    h.state_mut().app.run("slide.move", json!({"from":0,"to":1})).unwrap();
+    h.run_steps(2);
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[1].id, origin);
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    h.state_mut().app.session.command_policy = None;
+    h.run_steps(2);
+    let document = h.state().app.session.active().unwrap();
+    assert_eq!(document.doc.slides[0].notes.text(), "");
+    assert_eq!(document.doc.slides[1].notes.text(), "Only the original slide may receive this");
+    assert_eq!(document.history.undo.len(), undo + 1);
+    assert!(!h.state().app.notes_buf.2.edited);
+    h.run_steps(2);
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo + 1);
+}
+
+#[test]
+fn hosted_denied_notes_never_move_to_replacement_slide_after_deletion() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    h.state_mut().app.run("slide.new", json!({"at":1,"layout":"blank"})).unwrap();
+    h.state_mut().app.run("slide.go", json!({"index":0})).unwrap();
+    h.run_steps(2);
+    let origin = h.state().app.session.active().unwrap().doc.slides[0].id;
+    type_hosted_notes(&mut h, "Retain this instead of writing into a different slide");
+    h.state_mut().app.session.command_policy =
+        Some(|id, _| if id == "slide.notes" { Err(deckcraft_engine::EngineError::Other("notes rejected".into())) } else { Ok(()) });
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    h.state_mut().app.run("slide.delete", json!({"index":0})).unwrap();
+    let document = h.state().app.session.active().unwrap().doc.clone();
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    h.state_mut().app.session.command_policy = None;
+    h.run_steps(2);
+    assert!(h.state().app.session.active().unwrap().doc.slides.iter().all(|s| s.id != origin && s.notes.text().is_empty()));
+    assert!(Arc::ptr_eq(&document, &h.state().app.session.active().unwrap().doc));
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo);
+    assert!(h.state().app.notes_buf.2.edited);
+    assert_eq!(h.state().app.notes_buf.2.text, "Retain this instead of writing into a different slide");
+}
