+//! One bounded request, no browser or filesystem command surface. Authentication
+//! stays in Zoen; these identities bind only the isolated engine proposal.
+#![forbid(unsafe_code)]
+use std::io::{Read, Write};
+
+use deckcraft_engine::Session;
+use deckcraft_host_bridge::{Command, HostBridge, Open};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+const DOCUMENT_LIMIT: usize = 512 * 1024;
+const METADATA_LIMIT: usize = 64 * 1024;
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Request {
+    schema: u8,
+    open: Open,
+    command: Option<Command>,
+}
+fn failure(code: &str) -> String {
+    code.to_owned()
+}
+fn execute(input: &[u8]) -> Result<(Value, Vec<u8>), String> {
+    let size = input.get(..4).ok_or_else(|| failure("invalid_frame"))?;
+    let metadata_len = u32::from_le_bytes(size.try_into().map_err(|_| failure("invalid_frame"))?) as usize;
+    if metadata_len == 0 || metadata_len > METADATA_LIMIT {
+        return Err(failure("metadata_too_large"));
+    }
+    let split = 4 + metadata_len;
+    let metadata = input.get(4..split).ok_or_else(|| failure("invalid_frame"))?;
+    let bytes = input.get(split..).ok_or_else(|| failure("invalid_frame"))?;
+    if bytes.is_empty() || bytes.len() > DOCUMENT_LIMIT {
+        return Err(failure("worker_document_limit_512_kib"));
+    }
+    let request: Request = serde_json::from_slice(metadata).map_err(|_| failure("invalid_request"))?;
+    if request.schema != 1 {
+        return Err(failure("unsupported_schema"));
+    }
+    let mut session = Session::new();
+    let mut bridge = HostBridge::default();
+    bridge.open(&mut session, request.open, bytes).map_err(|e| failure(e.code))?;
+    if let Some(command) = request.command {
+        let proposal = bridge.execute(&mut session, command).map_err(|e| failure(e.code))?;
+        if proposal.bytes.len() > DOCUMENT_LIMIT {
+            return Err(failure("worker_document_limit_512_kib"));
+        }
+        return Ok((proposal.metadata, proposal.bytes));
+    }
+    let mut status = bridge.status(&session);
+    let document = session.active().ok_or_else(|| failure("not_open"))?;
+    // Inspection is read-only. The same model provides IDs for the four commands.
+    status["slides"] = serde_json::to_value(&document.doc.slides).map_err(|_| failure("invalid_model"))?;
+    Ok((status, Vec::new()))
+}
+fn main() {
+    let mut input = Vec::new();
+    let result = std::io::stdin()
+        .take((4 + METADATA_LIMIT + DOCUMENT_LIMIT + 1) as u64)
+        .read_to_end(&mut input)
+        .map_err(|_| failure("input_failed"))
+        .and_then(|_| {
+            if input.len() > 4 + METADATA_LIMIT + DOCUMENT_LIMIT {
+                return Err(failure("worker_document_limit_512_kib"));
+            }
+            execute(&input)
+        });
+    let (metadata, mut bytes) = match result {
+        Ok((metadata, bytes)) => (json!({"ok":true,"metadata":metadata}), bytes),
+        Err(code) => (json!({"ok":false,"error":code}), Vec::new()),
+    };
+    let mut encoded = serde_json::to_vec(&metadata).unwrap_or_default();
+    if encoded.len() > METADATA_LIMIT {
+        encoded = br#"{"ok":false,"error":"inspection_too_large"}"#.to_vec();
+        bytes.clear();
+    }
+    let mut out = std::io::stdout().lock();
+    if out.write_all(&(encoded.len() as u32).to_le_bytes()).is_err() || out.write_all(&encoded).is_err() {
+        return;
+    }
+    let _ = out.write_all(&bytes);
+}
