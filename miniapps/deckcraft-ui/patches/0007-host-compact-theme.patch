+
+/// A hosted primary action uses a full touch target without scaling the document.
+pub(crate) fn touch_icon(ui: &mut Ui, icon: Icon, label: &str, enabled: bool, on: bool) -> Response {
+    let t = Tokens::get(ui.ctx());
+    let (rect, response) = ui.allocate_exact_size(vec2(44.0, 44.0), if enabled { Sense::click() } else { Sense::hover() });
+    let painter = ui.painter_at(rect);
+    if let Some(color) = bg(ui, &response, on, &t) {
+        painter.rect_filled(rect, CornerRadius::same(8), color);
+    }
+    icons::paint(&painter, Rect::from_center_size(rect.center(), vec2(22.0, 22.0)), icon, t.text, !enabled);
+    response.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, enabled, label));
+    response.on_hover_text(label)
 }
 
