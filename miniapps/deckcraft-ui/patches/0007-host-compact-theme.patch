diff --git a/crates/ui-egui/src/host_compact_tests.rs b/crates/ui-egui/src/host_compact_tests.rs
new file mode 100644
--- /dev/null
+++ b/crates/ui-egui/src/host_compact_tests.rs
@@ -0,0 +1,194 @@
+//! Real upstream egui/Session regression cases for hosted portrait chrome.
+//! These tests do not stand in for an iPhone keyboard/touch/memory qualification.
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+use crate::{
+    Services, SlideApp, ViewMode,
+    host_layout::{self, CloseRect, HostLayout, Insets},
+    theme::Brightness,
+};
+use deckcraft_engine::Session;
+use egui::{Event, Modifiers, MouseWheelUnit, Rect, pos2, vec2};
+use egui_kittest::{Harness, kittest::Queryable};
+use serde_json::json;
+use std::sync::Arc;
+
+struct State {
+    app: SlideApp,
+    layout: Option<HostLayout>,
+}
+fn portrait(width: f32, theme: Brightness) -> HostLayout {
+    HostLayout {
+        width,
+        height: 932.0,
+        insets: Insets { top: 62.0, right: 0.0, bottom: 34.0, left: 0.0 },
+        close_button: Some(CloseRect { x: width - 56.0, y: 70.0, width: 44.0, height: 44.0 }),
+        theme: Some(theme),
+    }
+}
+fn fixture(layout: Option<HostLayout>) -> Harness<'static, State> {
+    let size = layout.map_or(vec2(1200.0, 800.0), |l| vec2(l.width, l.height));
+    let mut h = Harness::builder().with_size(size).build_ui_state(
+        |ui, state: &mut State| {
+            if let Some(layout) = state.layout {
+                host_layout::install(ui.ctx(), layout);
+            }
+            state.app.logic(ui.ctx());
+            state.app.ui(ui);
+        },
+        State { app: SlideApp::new(Session::with_new(), Services::default()), layout },
+    );
+    if let Some(layout) = layout {
+        let viewport = Rect::from_min_size(pos2(0.0, 0.0), size);
+        h.input_mut().safe_area_insets = Some(layout.safe_insets(viewport));
+    }
+    h.run_steps(3);
+    h
+}
+fn resize(h: &mut Harness<'_, State>, layout: HostLayout) {
+    h.state_mut().layout = Some(layout);
+    h.set_size(vec2(layout.width, layout.height));
+    h.input_mut().safe_area_insets = Some(layout.safe_insets(Rect::from_min_size(pos2(0.0, 0.0), vec2(layout.width, layout.height))));
+    h.run_steps(3);
+}
+
+#[test]
+fn hosted_portrait_canvas_and_primary_touch_hits_keep_the_safe_width() {
+    for width in [375.0, 390.0, 430.0] {
+        let layout = portrait(width, Brightness::Dark);
+        let h = fixture(Some(layout));
+        let canvas = h.state().app.canvas_rect.unwrap();
+        assert!(canvas.width() >= width - 16.0, "no permanent thumbnail gutter: {canvas:?}");
+        assert!(canvas.height() > 400.0, "the collapsed ribbon leaves editing space");
+        let close = layout.close_rect(h.ctx.viewport_rect()).unwrap();
+        let safe = h.ctx.content_rect();
+        let mut hits = vec![];
+        for label in
+            ["Export PDF or PowerPoint", "Slides", "Format inspector", "Search commands", "Present", "Fit slide to current window", "Speaker notes"]
+        {
+            let rect = h.get_by_label(label).rect();
+            assert!(rect.width() >= 43.9 && rect.height() >= 43.9, "{label}: {rect:?}");
+            assert!(safe.contains_rect(rect), "{label} remains in safe content: {rect:?} / {safe:?}");
+            assert!(!rect.intersects(close), "{label} cannot capture native Close");
+            assert!(hits.iter().all(|other: &Rect| !other.intersects(rect)), "primary targets cannot overlap: {label}");
+            hits.push(rect);
+        }
+    }
+}
+
+#[test]
+fn host_theme_updates_actual_egui_tokens_without_document_dirty_or_undo_changes() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    let state = h.state().app.session.active().unwrap();
+    let doc = state.doc.clone();
+    let revision = state.revision;
+    let undo = state.history.undo.len();
+    let dirty = state.is_dirty();
+    assert!(h.ctx.global_style().visuals.dark_mode);
+    assert_eq!(h.state().app.ui.brightness, Brightness::Dark);
+    h.state_mut().layout.as_mut().unwrap().theme = Some(Brightness::Light);
+    h.run_steps(2);
+    assert!(!h.ctx.global_style().visuals.dark_mode);
+    let after = h.state().app.session.active().unwrap();
+    assert!(Arc::ptr_eq(&doc, &after.doc));
+    assert_eq!((after.revision, after.history.undo.len(), after.is_dirty()), (revision, undo, dirty));
+    // A legacy geometry-only context remains accepted; unknown theme values fail decoding.
+    let base = json!({"width":430,"height":932,"insets":{"top":62,"right":0,"bottom":34,"left":0},"closeButton":null});
+    assert!(serde_json::from_value::<HostLayout>(base.clone()).unwrap().theme.is_none());
+    let mut invalid = base;
+    invalid["theme"] = json!("system-or-document-payload");
+    assert!(serde_json::from_value::<HostLayout>(invalid).is_err());
+}
+
+#[test]
+fn compact_slides_browser_uses_upstream_selection_and_one_tap_returns_to_canvas() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Light)));
+    h.state_mut().app.run("slide.new", json!({})).unwrap();
+    h.state_mut().app.run("slide.go", json!({"index":0})).unwrap();
+    let before = h.state().app.session.active().unwrap().doc.clone();
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    h.run_steps(2);
+    h.get_by_label("Slides").click();
+    h.run_steps(2);
+    assert_eq!(h.state().app.ui.view, ViewMode::Sorter);
+    h.get_by_label("Slide 2").click();
+    h.run_steps(2);
+    assert_eq!(h.state().app.ui.view, ViewMode::Normal);
+    let after = h.state().app.session.active().unwrap();
+    assert_eq!(after.selection.slide, 1);
+    assert!(Arc::ptr_eq(&before, &after.doc));
+    assert_eq!(after.history.undo.len(), undo);
+}
+
+#[test]
+fn hosted_inspector_reuses_controls_without_consuming_canvas_or_native_close() {
+    let layout = portrait(430.0, Brightness::Dark);
+    let mut h = fixture(Some(layout));
+    let canvas = h.state().app.canvas_rect.unwrap();
+    let doc = h.state().app.session.active().unwrap().doc.clone();
+    h.get_by_label("Format inspector").click();
+    h.run_steps(4);
+    assert_eq!(h.state().app.ui.pane.as_deref(), Some("format"));
+    assert_eq!(h.state().app.canvas_rect.unwrap().width(), canvas.width());
+    let close = h.get_by_label("Close inspector").rect();
+    assert!(host_layout::popup_rect(&h.ctx).contains_rect(close));
+    assert!(close.width() >= 44.0 && close.height() >= 44.0);
+    h.get_by_label("Close inspector").click();
+    h.run_steps(2);
+    assert!(h.state().app.ui.pane.is_none());
+    assert!(Arc::ptr_eq(&doc, &h.state().app.session.active().unwrap().doc));
+}
+
+#[test]
+fn compact_ribbon_scroll_reaches_the_last_upstream_tab_and_retains_its_commands() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Light)));
+    let home = h.get_by_label("Home").rect();
+    h.event(Event::PointerMoved(home.center()));
+    h.event(Event::MouseWheel { unit: MouseWheelUnit::Point, delta: vec2(-1400.0, 0.0), modifiers: Modifiers::NONE });
+    h.run_steps(12);
+    let view = h.get_by_label("View").rect();
+    assert!(h.ctx.content_rect().contains_rect(view), "last tab is reachable: {view:?}");
+    h.get_by_label("View").click();
+    h.run_steps(2);
+    assert_eq!(h.state().app.ui.tab, "View");
+    assert!(!h.state().app.ui.ribbon_collapsed);
+    assert!(h.query_by_label("Normal").is_some(), "the actual upstream View group renders");
+}
+
+#[test]
+fn hosted_rotation_preserves_notes_draft_ribbon_choice_and_same_document() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    let id = egui::Id::new("notes_edit");
+    h.ctx.memory_mut(|m| m.request_focus(id));
+    h.run_steps(1);
+    h.event(Event::Text("A live note".into()));
+    h.run_steps(1);
+    assert!(h.state().app.notes_buf.2.text.contains("A live note"));
+    assert!(h.state().app.ui.notes);
+    h.state_mut().app.ui.ribbon_collapsed = false;
+    let doc = h.state().app.session.active().unwrap().doc.clone();
+    let landscape = HostLayout {
+        width: 932.0,
+        height: 430.0,
+        insets: Insets { top: 0.0, right: 0.0, bottom: 21.0, left: 62.0 },
+        close_button: Some(CloseRect { x: 876.0, y: 8.0, width: 44.0, height: 44.0 }),
+        theme: Some(Brightness::Dark),
+    };
+    resize(&mut h, landscape);
+    resize(&mut h, portrait(430.0, Brightness::Dark));
+    assert!(h.state().app.ui.notes, "rotation must not reset a user's visible notes editor");
+    assert!(!h.state().app.ui.ribbon_collapsed, "rotation must not collapse a chosen ribbon");
+    assert!(h.state().app.notes_buf.2.text.contains("A live note"));
+    assert!(Arc::ptr_eq(&doc, &h.state().app.session.active().unwrap().doc), "layout cannot commit or replace the live document");
+}
+
+#[test]
+fn standalone_desktop_keeps_its_original_layout_and_preferences() {
+    let h = fixture(None);
+    assert_eq!(h.state().app.ui.brightness, Brightness::Light);
+    assert!(!h.state().app.ui.ribbon_collapsed);
+    assert!(h.state().app.ui.notes);
+    assert!(h.state().app.canvas_rect.unwrap().left() >= 150.0);
+    assert!(h.query_by_label("File").is_some());
+}
