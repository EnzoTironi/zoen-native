+        left.spacing_mut().item_spacing.x = 4.0;
+        if widgets::touch_icon(&mut left, Icon::Export, "Export PDF or PowerPoint", has_doc, false).clicked() {
+            let _ = app.run("app.exportDialog", json!({}));
+        }
+        let sorter = app.ui.view == crate::ViewMode::Sorter;
+        if widgets::touch_icon(&mut left, Icon::ViewSorter, if sorter { "Back to slide" } else { "Slides" }, has_doc, sorter).clicked() {
+            let _ = app.run(if sorter { "view.normal" } else { "view.sorter" }, json!({}));
+        }
+        if right_edge - rect.left() >= 288.0
+            && widgets::touch_icon(&mut left, Icon::FormatBackground, "Format inspector", has_doc, app.ui.pane.is_some()).clicked()
+        {
+            let _ = app.run("view.pane", json!({"pane":"format", "toggle":true}));
+        }
+        let mut right = ui.new_child(
+            egui::UiBuilder::new()
+                .max_rect(Rect::from_min_max(pos2((right_edge - 128.0).max(rect.left() + 8.0), rect.top()), pos2(right_edge, rect.bottom())))
+                .layout(egui::Layout::right_to_left(egui::Align::Center)),
+        );
+        right.spacing_mut().item_spacing.x = 4.0;
+        if widgets::touch_icon(&mut right, Icon::Search, "Search commands", true, false).clicked() {
+            app.palette = Some((String::new(), 0));
+        }
+        if right
+            .add_enabled(
+                has_doc,
+                egui::Button::new(egui::RichText::new("Present").color(t.accent_text)).fill(t.accent).corner_radius(22.0).min_size(vec2(76.0, 44.0)),
+            )
+            .clicked()
+        {
+            let from = app.session.active().map(|d| d.selection.slide).unwrap_or(0);
+            app.start_show(from, false);
+        }
+    });
+}
