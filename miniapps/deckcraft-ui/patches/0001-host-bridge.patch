diff --git a/apps/deckcraft-web/src/host_api.rs b/apps/deckcraft-web/src/host_api.rs
new file mode 100644
--- /dev/null
+++ b/apps/deckcraft-web/src/host_api.rs
@@ -0,0 +1,160 @@
+//! In-process WASM calls only. MCP transport is owned by the official Apps SDK in
+//! the embedding shell; this module never sends window/postMessage/network traffic.
+use std::cell::RefCell;
+use std::collections::VecDeque;
+
+use deckcraft_engine::Session;
+use deckcraft_host_bridge::lifecycle::HostLifecycle;
+use deckcraft_host_bridge::{Accept, Command, Export, HostBridge, MAX_DOCUMENT_BYTES, Mutation, Open, Proposal};
+use serde::Deserialize;
+use serde_json::json;
+use wasm_bindgen::prelude::*;
+
+#[derive(Deserialize)]
+#[serde(tag = "op", content = "input", deny_unknown_fields, rename_all = "camelCase")]
+enum Request {
+    Open(Open),
+    Command(Command),
+    Snapshot(Mutation),
+    Accept(Accept),
+    Export(Export),
+    Status,
+}
+struct Pending {
+    request: Request,
+    bytes: Vec<u8>,
+    resolve: js_sys::Function,
+    reject: js_sys::Function,
+}
+#[derive(Default)]
+struct Queue {
+    lifecycle: HostLifecycle,
+    ctx: Option<egui::Context>,
+    pending: VecDeque<Pending>,
+    bytes: usize,
+    on_change: Option<js_sys::Function>,
+}
+thread_local! { static QUEUE: RefCell<Queue> = RefCell::new(Queue::default()); }
+fn error(code: &str) -> JsValue {
+    JsValue::from_str(&json!({"code":code}).to_string())
+}
+pub fn install(hosted: bool, ctx: Option<egui::Context>) {
+    QUEUE.with(|q| {
+        let mut q = q.borrow_mut();
+        q.ctx = if q.lifecycle.install(hosted) { ctx } else { None };
+    });
+}
+/// A narrow, bounded FIFO onto the application's own egui/Session owner. The
+/// embedding JS adapter must enforce the same Uint8Array limit before wasm-bindgen
+/// copies it; this Rust limit alone does not bound that initial allocation.
+#[wasm_bindgen(js_name = zoenHostRequest)]
+pub fn request(envelope: String, bytes: Vec<u8>) -> js_sys::Promise {
+    if envelope.len() > 65_536 || bytes.len() > MAX_DOCUMENT_BYTES {
+        return js_sys::Promise::reject(&error("request_too_large"));
+    }
+    let request: Request = match serde_json::from_str(&envelope) {
+        Ok(request) => request,
+        Err(_) => return js_sys::Promise::reject(&error("invalid_request")),
+    };
+    if !matches!(&request, Request::Open(_)) && !bytes.is_empty() {
+        return js_sys::Promise::reject(&error("unexpected_binary_input"));
+    }
+    let mut work = Some((request, bytes));
+    js_sys::Promise::new(&mut |resolve, reject| {
+        let Some((request, bytes)) = work.take() else {
+            return;
+        };
+        QUEUE.with(|queue| {
+            let mut queue = queue.borrow_mut();
+            if !queue.lifecycle.active() || queue.pending.len() >= 8 || queue.bytes.saturating_add(bytes.len()) > MAX_DOCUMENT_BYTES * 2 {
+                let _ = reject.call1(&JsValue::NULL, &error("host_unavailable_or_busy"));
+                return;
+            }
+            queue.bytes += bytes.len();
+            queue.pending.push_back(Pending { request, bytes, resolve, reject });
+            if let Some(ctx) = &queue.ctx {
+                ctx.request_repaint();
+            }
+        });
+    })
+}
+#[wasm_bindgen(js_name = zoenHostOnChange)]
+pub fn on_change(callback: Option<js_sys::Function>) -> std::result::Result<(), JsValue> {
+    QUEUE.with(|q| {
+        let mut q = q.borrow_mut();
+        if !q.lifecycle.active() {
+            return Err(error("host_unavailable_or_retired"));
+        }
+        q.on_change = callback;
+        Ok(())
+    })
+}
+#[wasm_bindgen(js_name = zoenHostRetire)]
+pub fn retire() {
+    let pending = QUEUE.with(|q| {
+        let mut q = q.borrow_mut();
+        q.lifecycle.retire();
+        q.ctx = None;
+        q.bytes = 0;
+        q.on_change = None;
+        std::mem::take(&mut q.pending)
+    });
+    for work in pending {
+        let _ = work.reject.call1(&JsValue::NULL, &error("host_retired"));
+    }
+}
+pub fn changed(bridge: &HostBridge, session: &Session) {
+    let callback = QUEUE.with(|q| {
+        let q = q.borrow();
+        if q.lifecycle.active() { q.on_change.clone() } else { None }
+    });
+    if let Some(callback) = callback {
+        let _ = callback.call1(&JsValue::NULL, &JsValue::from_str(&bridge.status(session).to_string()));
+    }
+}
+pub fn drain(bridge: &mut HostBridge, session: &mut Session, ctx: &egui::Context) {
+    // One request per frame; a request owns a Promise, so results cannot cross callers.
+    let pending = QUEUE.with(|q| {
+        let mut q = q.borrow_mut();
+        let p = q.pending.pop_front();
+        if let Some(p) = &p {
+            q.bytes = q.bytes.saturating_sub(p.bytes.len());
+        }
+        p
+    });
+    let Some(work) = pending else {
+        return;
+    };
+    let result = match work.request {
+        Request::Open(input) => bridge.open(session, input, &work.bytes).map(|metadata| Proposal { bytes: vec![], metadata }),
+        Request::Command(input) => bridge.execute(session, input),
+        Request::Snapshot(input) => bridge.snapshot(session, input),
+        Request::Accept(input) => bridge.accept(session, input).map(|metadata| Proposal { bytes: vec![], metadata }),
+        Request::Export(input) => bridge.export(session, input),
+        Request::Status => Ok(Proposal { bytes: vec![], metadata: bridge.status(session) }),
+    };
+    match result {
+        Ok(proposal) => {
+            let object = js_sys::Object::new();
+            let metadata = JsValue::from_str(&proposal.metadata.to_string());
+            let bytes = js_sys::Uint8Array::from(proposal.bytes.as_slice());
+            let wrapped = js_sys::Reflect::set(&object, &JsValue::from_str("metadata"), &metadata)
+                .and_then(|_| js_sys::Reflect::set(&object, &JsValue::from_str("bytes"), &bytes));
+            match wrapped {
+                Ok(_) => {
+                    let _ = work.resolve.call1(&JsValue::NULL, &object);
+                }
+                Err(error) => {
+                    let _ = work.reject.call1(&JsValue::NULL, &error);
+                }
+            }
+        }
+        Err(error) => {
+            let value = serde_json::to_string(&error).unwrap_or_else(|_| json!({"code":"bridge_failed"}).to_string());
+            let _ = work.reject.call1(&JsValue::NULL, &JsValue::from_str(&value));
+        }
+    }
+    if QUEUE.with(|q| !q.borrow().pending.is_empty()) {
+        ctx.request_repaint();
+    }
+}
