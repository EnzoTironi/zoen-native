--- /dev/null
+++ b/crates/host-bridge/src/lib.rs
@@ -0,0 +1,823 @@
+//! Artifact-local bridge over the very same Session rendered by SlideApp.
+//!
+//! These identities are host bindings, not authentication. Zoen must derive the actor,
+//! authorize the artifact and CAS-commit bytes in its existing encrypted store. A proposal
+//! is never an accepted version until that host acknowledges its exact hash.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+#![forbid(unsafe_code)]
+
+use std::collections::BTreeMap;
+use std::io::{Cursor, Read};
+use std::sync::Arc;
+
+use deckcraft_engine::cmd::file::{open_checked, save_bytes};
+use deckcraft_engine::{DocState, EngineError, Session, Target, model::Presentation};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+pub mod lifecycle;
+
+pub const ENGINE_REVISION: &str = "a31b990d32f2c8562f1588562f922960c3fde48b";
+pub const MAX_DOCUMENT_BYTES: usize = 8 << 20;
+pub const MAX_EXPORT_BYTES: usize = 16 << 20;
+const MAX_TEXT: usize = 8192;
+
+type Result<T> = std::result::Result<T, BridgeError>;
+#[derive(Debug, Serialize)]
+pub struct BridgeError {
+    pub code: &'static str,
+}
+fn failure(code: &'static str) -> BridgeError {
+    BridgeError { code }
+}
+fn engine(_: EngineError) -> BridgeError {
+    failure("engine_failed")
+}
+fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 128 && value.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-')
+}
+fn valid_hash(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct Scope {
+    pub artifact_id: String,
+    pub actor_id: String,
+    pub actor_kind: ActorKind,
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub enum ActorKind {
+    Human,
+    Agent,
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Head {
+    /// Decimal u64 string, avoiding JavaScript's integer precision boundary.
+    pub version: String,
+    pub sha256: String,
+}
+impl Head {
+    fn number(&self) -> Result<u64> {
+        if self.version.is_empty()
+            || self.version.len() > 20
+            || (self.version.len() > 1 && self.version.starts_with('0'))
+            || !self.version.bytes().all(|c| c.is_ascii_digit())
+            || !valid_hash(&self.sha256)
+        {
+            return Err(failure("invalid_head"));
+        }
+        self.version.parse().map_err(|_| failure("invalid_head"))
+    }
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct Open {
+    pub scope: Scope,
+    pub head: Head,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct Mutation {
+    pub scope: Scope,
+    pub base: Head,
+    pub mutation_id: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Command {
+    pub mutation: Mutation,
+    pub action: Action,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(tag = "command", content = "params", deny_unknown_fields)]
+pub enum Action {
+    #[serde(rename = "text.set")]
+    TextSet(TextSet),
+    #[serde(rename = "slide.notes")]
+    SlideNotes(SlideNotes),
+    #[serde(rename = "shape.insert")]
+    ShapeInsert(ShapeInsert),
+    #[serde(rename = "slide.new")]
+    SlideNew(SlideNew),
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct TextSet {
+    pub slide_id: u32,
+    pub id: u32,
+    pub text: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct SlideNotes {
+    pub slide_id: u32,
+    pub text: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct ShapeInsert {
+    pub slide_id: u32,
+    pub preset: String,
+    pub rect: [f64; 4],
+    pub text: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct SlideNew {
+    pub after_slide_id: u32,
+    pub layout: String,
+    pub title: String,
+    pub body: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct Accept {
+    pub scope: Scope,
+    pub mutation_id: String,
+    pub head: Head,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Export {
+    pub scope: Scope,
+    pub head: Head,
+    pub format: ExportFormat,
+}
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(rename_all = "lowercase")]
+pub enum ExportFormat {
+    Pptx,
+    Pdf,
+}
+#[derive(Clone)]
+pub struct Proposal {
+    pub bytes: Vec<u8>,
+    pub metadata: Value,
+}
+struct Pending {
+    id: String,
+    fingerprint: String,
+    doc: Arc<Presentation>,
+    proposal: Proposal,
+}
+struct Accepted {
+    id: String,
+    fingerprint: String,
+    proposal: Proposal,
+}
+#[derive(Default)]
+pub struct HostBridge {
+    scope: Option<Scope>,
+    head: Option<Head>,
+    document_uid: Option<u64>,
+    accepted_doc: Option<Arc<Presentation>>,
+    pending: Option<Pending>,
+    last: Option<Accepted>,
+}
+impl HostBridge {
+    fn scope(&self, scope: &Scope) -> Result<()> {
+        if self.scope.as_ref() != Some(scope) {
+            return Err(failure("scope_changed"));
+        }
+        Ok(())
+    }
+    fn document(&self, session: &Session) -> Result<()> {
+        if session.documents().len() != 1 || session.active().map(|d| d.uid) != self.document_uid {
+            return Err(failure("document_changed"));
+        }
+        Ok(())
+    }
+    pub fn dirty(&self, session: &Session) -> bool {
+        match (self.accepted_doc.as_ref(), session.active()) {
+            (Some(accepted), Some(current)) => !Arc::ptr_eq(accepted, &current.doc),
+            _ => false,
+        }
+    }
+    pub fn status(&self, session: &Session) -> Value {
+        json!({"engineRevision":ENGINE_REVISION,"scope":self.scope,"head":self.head,"dirty":self.dirty(session),"pendingMutationId":self.pending.as_ref().map(|p| &p.id)})
+    }
+    /// Only exact native documents are adopted. Repairs/unknown fields/media/font imports
+    /// require a separate explicit host import flow; original bytes remain with the host.
+    pub fn open(&mut self, session: &mut Session, request: Open, bytes: &[u8]) -> Result<Value> {
+        if !identifier(&request.scope.artifact_id) || !identifier(&request.scope.actor_id) {
+            return Err(failure("invalid_scope"));
+        }
+        request.head.number()?;
+        if let Some(scope) = self.scope.as_ref() {
+            if scope != &request.scope {
+                return Err(failure("scope_changed"));
+            }
+            self.document(session)?;
+            if self.pending.is_some() || self.dirty(session) {
+                return Err(failure("local_changes"));
+            }
+            let old_head = self.head.as_ref().ok_or_else(|| failure("not_open"))?;
+            if request.head.number()? < old_head.number()? || (request.head.version == old_head.version && request.head != *old_head) {
+                return Err(failure("stale_head"));
+            }
+        }
+        if bytes.len() > MAX_DOCUMENT_BYTES || hash(bytes) != request.head.sha256 {
+            return Err(failure("invalid_document_hash_or_size"));
+        }
+        let original = native_manifest(bytes)?;
+        let (doc, damage) = open_checked("document.deckcraft", bytes).map_err(engine)?;
+        if !damage.is_empty() {
+            return Err(failure("import_requires_review"));
+        }
+        validate_model(&doc)?;
+        let encoded = save_bytes(&doc, "deckcraft").map_err(engine)?;
+        if native_manifest(&encoded)? != original {
+            return Err(failure("import_requires_review"));
+        }
+        // A fresh one-document Session prevents untracked window/file state or a second store.
+        let mut next = Session::new();
+        next.prefs.author = request.scope.actor_id.clone();
+        next.add_document(DocState::new(doc, None, "Presentation".into()));
+        next.command_policy = Some(managed_command_policy);
+        self.document_uid = next.active().map(|d| d.uid);
+        self.accepted_doc = next.active().map(|d| d.doc.clone());
+        self.scope = Some(request.scope);
+        self.head = Some(request.head);
+        self.pending = None;
+        self.last = None;
+        *session = next;
+        Ok(self.status(session))
+    }
+    fn admission(&self, session: &Session, mutation: &Mutation, fingerprint: &str) -> Result<Option<Proposal>> {
+        self.scope(&mutation.scope)?;
+        self.document(session)?;
+        if mutation.base.number()? == u64::MAX {
+            return Err(failure("version_exhausted"));
+        }
+        if !identifier(&mutation.mutation_id) {
+            return Err(failure("invalid_mutation_id"));
+        }
+        // A response retry is the same proposal, including allocated IDs, never replay.
+        if let Some(last) = &self.last
+            && last.id == mutation.mutation_id
+        {
+            return if last.fingerprint == fingerprint { Ok(Some(last.proposal.clone())) } else { Err(failure("mutation_reused")) };
+        }
+        if let Some(pending) = &self.pending {
+            if pending.id == mutation.mutation_id {
+                return if pending.fingerprint == fingerprint { Ok(Some(pending.proposal.clone())) } else { Err(failure("mutation_reused")) };
+            }
+            return Err(failure("proposal_pending"));
+        }
+        if self.head.as_ref() != Some(&mutation.base) {
+            return Err(failure("stale_head"));
+        }
+        let current = session.doc().map_err(engine)?;
+        if current.composition.is_some() || current.interaction.is_some() {
+            return Err(failure("human_interaction"));
+        }
+        Ok(None)
+    }
+    fn prepare(&mut self, session: &Session, mutation: Mutation, fingerprint: String, operation: Value) -> Result<Proposal> {
+        let doc = session.doc().map_err(engine)?.doc.clone();
+        validate_model(&doc)?;
+        let bytes = save_bytes(&doc, "deckcraft").map_err(engine)?;
+        if bytes.len() > MAX_DOCUMENT_BYTES {
+            return Err(failure("document_too_large"));
+        }
+        let metadata = json!({"scope":mutation.scope,"mutationId":mutation.mutation_id,"base":mutation.base,"sha256":hash(&bytes),"byteLength":bytes.len(),"engineRevision":ENGINE_REVISION,"operation":operation,"acceptedHead":null});
+        let proposal = Proposal { bytes, metadata };
+        self.pending = Some(Pending { id: mutation.mutation_id, fingerprint, doc, proposal: proposal.clone() });
+        Ok(proposal)
+    }
+    /// Capture human UI changes; this is a proposal, not a local accepted-version counter.
+    pub fn snapshot(&mut self, session: &Session, mutation: Mutation) -> Result<Proposal> {
+        let fingerprint = hash(&serde_json::to_vec(&json!({"checkpoint":mutation})).map_err(|_| failure("invalid_request"))?);
+        if let Some(proposal) = self.admission(session, &mutation, &fingerprint)? {
+            return Ok(proposal);
+        }
+        self.prepare(session, mutation, fingerprint, json!({"kind":"humanCheckpoint"}))
+    }
+    /// Exact, explicit reviewed commands only. No generic run_command/batch/file-path API.
+    pub fn execute(&mut self, session: &mut Session, command: Command) -> Result<Proposal> {
+        let fingerprint = hash(&serde_json::to_vec(&command).map_err(|_| failure("invalid_request"))?);
+        if let Some(proposal) = self.admission(session, &command.mutation, &fingerprint)? {
+            return Ok(proposal);
+        }
+        if self.dirty(session) {
+            return Err(failure("local_changes"));
+        }
+        let before = session.doc().map_err(engine)?.clone();
+        let journal_len = session.journal.len();
+        let requests_len = session.ui_requests.len();
+        let look = session.default_look.take();
+        let result = apply(session, &command.action).and_then(|result| {
+            self.prepare(session, command.mutation, fingerprint, json!({"kind":"command","action":command.action,"result":result}))
+        });
+        session.default_look = look;
+        if result.is_err() {
+            if let Some(current) = session.active_mut() {
+                *current = before;
+            }
+            session.journal.truncate(journal_len);
+            session.ui_requests.truncate(requests_len);
+        }
+        result
+    }
+    pub fn accept(&mut self, session: &mut Session, receipt: Accept) -> Result<Value> {
+        self.scope(&receipt.scope)?;
+        self.document(session)?;
+        if self.pending.is_none() {
+            if let Some(last) = &self.last
+                && last.id == receipt.mutation_id
+                && self.head.as_ref() == Some(&receipt.head)
+                && last.proposal.metadata.get("acceptedHead") == Some(&json!(&receipt.head))
+            {
+                return Ok(self.status(session));
+            }
+            return Err(failure("no_proposal"));
+        }
+        let pending = self.pending.as_ref().ok_or_else(|| failure("no_proposal"))?;
+        let next = self.head.as_ref().ok_or_else(|| failure("not_open"))?.number()?.checked_add(1).ok_or_else(|| failure("version_exhausted"))?;
+        if pending.id != receipt.mutation_id
+            || receipt.head.number()? != next
+            || pending.proposal.metadata.get("sha256").and_then(Value::as_str) != Some(receipt.head.sha256.as_str())
+        {
+            return Err(failure("receipt_mismatch"));
+        }
+        let mut pending = self.pending.take().ok_or_else(|| failure("no_proposal"))?;
+        // If the UI changed while saving, retain that newer draft and only advance its base.
+        self.accepted_doc = Some(pending.doc.clone());
+        if let Some(current) = session.active_mut() {
+            current.saved_doc = pending.doc;
+        }
+        self.head = Some(receipt.head.clone());
+        pending.proposal.metadata["acceptedHead"] = json!(receipt.head);
+        self.last = Some(Accepted { id: pending.id, fingerprint: pending.fingerprint, proposal: pending.proposal });
+        Ok(self.status(session))
+    }
+    /// Export the explicitly selected accepted model, even if newer local draft edits exist.
+    pub fn export(&self, session: &Session, request: Export) -> Result<Proposal> {
+        self.scope(&request.scope)?;
+        self.document(session)?;
+        if self.head.as_ref() != Some(&request.head) {
+            return Err(failure("stale_head"));
+        }
+        let doc = self.accepted_doc.as_ref().ok_or_else(|| failure("not_open"))?;
+        let (format, mime) = match request.format {
+            ExportFormat::Pptx => ("pptx", "application/vnd.openxmlformats-officedocument.presentationml.presentation"),
+            ExportFormat::Pdf => ("pdf", "application/pdf"),
+        };
+        let bytes = save_bytes(doc, format).map_err(engine)?;
+        if bytes.len() > MAX_EXPORT_BYTES {
+            return Err(failure("export_too_large"));
+        }
+        Ok(Proposal {
+            metadata: json!({"scope":request.scope,"sourceHead":request.head,"format":format,"mime":mime,"sha256":hash(&bytes),"byteLength":bytes.len(),"engineRevision":ENGINE_REVISION}),
+            bytes,
+        })
+    }
+}
+fn text(value: &str) -> Result<()> {
+    if value.len() > MAX_TEXT { Err(failure("text_too_large")) } else { Ok(()) }
+}
+fn slide(session: &mut Session, id: u32) -> Result<usize> {
+    let index = session.doc().map_err(engine)?.doc.slides.iter().position(|slide| slide.id.0 == id).ok_or_else(|| failure("unknown_slide"))?;
+    let state = session.doc_mut().map_err(engine)?;
+    state.selection.target = Target::Slides;
+    state.selection.slide = index;
+    state.selection.shapes.clear();
+    state.selection.text = None;
+    Ok(index)
+}
+fn apply(session: &mut Session, action: &Action) -> Result<Value> {
+    match action {
+        Action::TextSet(p) => {
+            text(&p.text)?;
+            slide(session, p.slide_id)?;
+            session.execute("text.set", &json!({"id":p.id,"text":p.text})).map_err(engine)
+        }
+        Action::SlideNotes(p) => {
+            text(&p.text)?;
+            let index = slide(session, p.slide_id)?;
+            session.execute("slide.notes", &json!({"index":index,"text":p.text})).map_err(engine)
+        }
+        Action::ShapeInsert(p) => {
+            text(&p.text)?;
+            if !matches!(p.preset.as_str(), "rect" | "ellipse" | "roundRect")
+                || !p.rect.iter().all(|n| n.is_finite() && n.abs() <= 20_000.0)
+                || p.rect[2] <= 0.0
+                || p.rect[3] <= 0.0
+            {
+                return Err(failure("invalid_shape"));
+            }
+            slide(session, p.slide_id)?;
+            session.execute("shape.insert", &json!({"preset":p.preset,"rect":p.rect,"text":p.text})).map_err(engine)
+        }
+        Action::SlideNew(p) => {
+            text(&p.title)?;
+            text(&p.body)?;
+            if !matches!(p.layout.as_str(), "blank" | "title" | "titleAndContent") {
+                return Err(failure("invalid_layout"));
+            }
+            let at = slide(session, p.after_slide_id)?.checked_add(1).ok_or_else(|| failure("invalid_slide"))?;
+            session.execute("slide.new", &json!({"at":at,"layout":p.layout,"title":p.title,"body":p.body})).map_err(engine)
+        }
+    }
+}
+fn validate_model(doc: &Presentation) -> Result<()> {
+    // First slice has no asset-import or licensed embedded-font capability. Preserve these
+    // inputs outside this editor until the host's scoped import pipeline is implemented.
+    if !doc.media.is_empty() || !doc.embedded_fonts.is_empty() {
+        return Err(failure("asset_import_not_enabled"));
+    }
+    if doc.slides.len() > 100 || doc.slides.iter().map(|s| s.shapes.len()).sum::<usize>() > 1000 {
+        return Err(failure("document_too_complex"));
+    }
+    let model = serde_json::to_value(doc).map_err(|_| failure("invalid_document"))?;
+    if unsupported_action(&model, 0) {
+        return Err(failure("external_action_not_enabled"));
+    }
+    Ok(())
+}
+fn unsupported_action(value: &Value, depth: usize) -> bool {
+    if depth > 64 {
+        return true;
+    }
+    match value {
+        Value::Object(object) => {
+            if object.get("action").and_then(|a| a.get("kind")).and_then(Value::as_str).is_some_and(|kind| matches!(kind, "url" | "program"))
+                || object.get("type").and_then(Value::as_str) == Some("opaque")
+                || object.get("rawExt").is_some_and(|v| !v.is_null())
+            {
+                return true;
+            }
+            object.values().any(|v| unsupported_action(v, depth + 1))
+        }
+        Value::Array(values) => values.iter().any(|v| unsupported_action(v, depth + 1)),
+        _ => false,
+    }
+}
+fn native_manifest(bytes: &[u8]) -> Result<(Value, BTreeMap<String, String>)> {
+    if bytes.len() > MAX_DOCUMENT_BYTES {
+        return Err(failure("document_too_large"));
+    }
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).map_err(|_| failure("invalid_native_document"))?;
+    if zip.len() > 512 {
+        return Err(failure("document_too_complex"));
+    }
+    let mut total = 0u64;
+    let mut entries = BTreeMap::new();
+    for index in 0..zip.len() {
+        let mut entry = zip.by_index(index).map_err(|_| failure("invalid_native_document"))?;
+        let name = entry.name();
+        if name.len() > 256
+            || name.starts_with('/')
+            || name.split('/').any(|s| s == "..")
+            || entries.contains_key(name)
+            || entry.size() > MAX_DOCUMENT_BYTES as u64
+        {
+            return Err(failure("invalid_native_document"));
+        }
+        total = total.checked_add(entry.size()).ok_or_else(|| failure("document_too_large"))?;
+        if total > MAX_EXPORT_BYTES as u64 {
+            return Err(failure("document_too_large"));
+        }
+        let name = name.to_string();
+        // Check CRC and compare every preserved binary member, not just its name.
+        // JSON is compared semantically below, so harmless JSON whitespace is not a repair.
+        let mut content = Vec::new();
+        entry.by_ref().take(MAX_DOCUMENT_BYTES as u64 + 1).read_to_end(&mut content).map_err(|_| failure("invalid_native_document"))?;
+        if content.len() > MAX_DOCUMENT_BYTES {
+            return Err(failure("document_too_large"));
+        }
+        entries.insert(name.clone(), if name == "presentation.json" { String::new() } else { hash(&content) });
+    }
+    let mut entry = zip.by_name("presentation.json").map_err(|_| failure("invalid_native_document"))?;
+    let mut json = Vec::new();
+    entry.by_ref().take((4 << 20) + 1).read_to_end(&mut json).map_err(|_| failure("invalid_native_document"))?;
+    if json.len() > 4 << 20 {
+        return Err(failure("document_too_large"));
+    }
+    let manifest: Value = serde_json::from_slice(&json).map_err(|_| failure("invalid_native_document"))?;
+    if manifest.get("format").and_then(Value::as_str) != Some("deckcraft") || manifest.get("version").and_then(Value::as_u64) != Some(1) {
+        return Err(failure("import_requires_review"));
+    }
+    Ok((manifest, entries))
+}
+/// Applied by Session to UI/key/nested commands too, not just the host's narrow allowlist.
+pub fn managed_command_policy(id: &str, _: &Value) -> deckcraft_engine::Result<()> {
+    if ["file.", "window.", "font."].iter().any(|prefix| id.starts_with(prefix))
+        || matches!(
+            id,
+            "design.browseTheme"
+                | "review.compare"
+                | "review.spelling"
+                | "review.dictionary"
+                | "review.addToDictionary"
+                | "insert.picture"
+                | "insert.audio"
+                | "insert.video"
+                | "picture.change"
+                | "insert.photoAlbum"
+                | "insert.photoAlbumEdit"
+                | "smartArt.picture"
+                | "transition.sound"
+                | "insert.hyperlink"
+                | "shape.action"
+        )
+    {
+        return Err(EngineError::Other("This operation requires a scoped host capability".into()));
+    }
+    Ok(())
+}
