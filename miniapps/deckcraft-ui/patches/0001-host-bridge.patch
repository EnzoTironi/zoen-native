+//! A hosted binding is retired permanently for the lifetime of this WASM module.
+//! A fresh WebView/module creates a new binding; an asynchronous initialization callback
+//! cannot revive a dismissed view or inherit the previous artifact's pending work.
+#[derive(Default)]
+pub struct HostLifecycle {
+    active: bool,
+    retired: bool,
+}
+impl HostLifecycle {
+    pub fn install(&mut self, hosted: bool) -> bool {
+        self.active = hosted && !self.retired;
+        self.active
+    }
+    pub fn active(&self) -> bool {
+        self.active && !self.retired
+    }
+    pub fn retire(&mut self) {
+        self.retired = true;
+        self.active = false;
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn dismissal_before_async_ready_cannot_reactivate_a_binding() {
+        let mut binding = HostLifecycle::default();
+        assert!(binding.install(true)); // start, before WebRunner readiness
+        binding.retire();
+        assert!(!binding.active());
+        assert!(!binding.install(true)); // delayed WebRunner callback
+        assert!(!binding.active());
+        binding.retire();
+        assert!(!binding.install(false));
+        assert!(!binding.install(true));
+    }
+    #[test]
+    fn standalone_is_never_hosted_and_a_fresh_module_has_its_own_lifetime() {
+        let mut standalone = HostLifecycle::default();
+        assert!(!standalone.install(false));
+        standalone.retire();
+        let mut fresh = HostLifecycle::default();
+        assert!(fresh.install(true));
+        assert!(fresh.active());
+        assert!(!standalone.active());
+    }
+}
