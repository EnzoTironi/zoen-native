+    s.execute("text.select", &json!({"anchor":start,"caret":end})).unwrap();
+    s.execute("format.bold", &json!({"on":false})).unwrap();
+    s.execute("format.italic", &json!({"on":true})).unwrap();
+    s.execute("text.select", &json!({"anchor":start,"caret":start})).unwrap();
