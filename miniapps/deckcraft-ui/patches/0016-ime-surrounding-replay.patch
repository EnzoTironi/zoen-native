+/// Unicode-scalar offsets into a rich text body, including one separator per paragraph.
+/// Counts from an IME never drive a loop proportional to an untrusted deletion request.
+fn ime_index(body: &TextBody, at: Pos) -> usize {
+    let para = at.0.min(body.paragraphs.len().saturating_sub(1));
+    body.paragraphs
+        .iter()
+        .take(para)
+        .map(|p| p.char_len().saturating_add(1))
+        .fold(0, usize::saturating_add)
+        .saturating_add(body.paragraphs.get(para).map_or(0, |p| at.1.min(p.char_len())))
+}
+
+fn ime_pos(body: &TextBody, mut index: usize) -> Pos {
+    for (pi, paragraph) in body.paragraphs.iter().enumerate() {
+        let n = paragraph.char_len();
+        if index <= n || pi + 1 == body.paragraphs.len() {
+            return (pi, index.min(n));
+        }
+        index -= n + 1;
+    }
+    (0, 0)
+}
