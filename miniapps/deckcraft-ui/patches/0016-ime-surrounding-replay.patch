+#[test]
+fn ime_surrounding_repeated_preedit_preserves_the_surviving_paragraph_mark_across_commit_and_navigation() {
+    for settle_with_navigation in [false, true] {
+        let mut s = editing("AA\nBB\nCC", (0, 0), (2, 2));
+        for (para, (url, align)) in
+            [("https://example.org/first", "left"), ("https://example.org/middle", "center"), ("https://example.org/last", "right")]
+                .into_iter()
+                .enumerate()
+        {
+            s.execute("text.select", &json!({"anchor":[para,0],"caret":[para,2]})).unwrap();
+            s.execute("insert.hyperlink", &json!({"url":url})).unwrap();
+            s.execute("format.align", &json!({"align":align})).unwrap();
+        }
+        s.execute("text.select", &json!({"anchor":[1,2],"caret":[1,2]})).unwrap();
+        let base = s.doc().unwrap().clone();
+        let j0 = s.journal.len();
+        let first_para = cmd::text::body_of(&base, base.selection.text.as_ref().unwrap()).unwrap().paragraphs[0].clone();
+        assert!(first_para.end_props.link.is_some());
+        s.compose_text("X", None).unwrap();
+        assert!(s.doc().unwrap().composition.as_ref().unwrap().props.as_ref().unwrap().link.is_none());
+        // Each request crosses a different side of the middle paragraph. The first
+        // paragraph survives the merge; the second request leaves only the preedit.
+        s.delete_surrounding_text(3, 1).unwrap();
+        assert_eq!(text(&s), "AAXCC");
+        s.delete_surrounding_text(2, 2).unwrap();
+        assert_eq!(text(&s), "X");
+        for next_preedit in ["XX", "XYZ"] {
+            let st = s.doc().unwrap();
+            let p = &cmd::text::body_of(st, st.selection.text.as_ref().unwrap()).unwrap().paragraphs[0];
+            assert_eq!(p.end_props, first_para.end_props, "real surrounding deletion keeps the surviving paragraph mark");
+            s.compose_text(next_preedit, None).unwrap();
+            let st = s.doc().unwrap();
+            let p = &cmd::text::body_of(st, st.selection.text.as_ref().unwrap()).unwrap().paragraphs[0];
+            assert_eq!(p.end_props, first_para.end_props, "transient replacement must not rewrite the surviving paragraph mark");
+            assert_eq!((p.level, &p.props, &p.def_props), (first_para.level, &first_para.props, &first_para.def_props));
+        }
+        if settle_with_navigation {
+            s.execute("text.move", &json!({"to":"left"})).unwrap();
+        } else {
+            s.commit_text("Y").unwrap();
+        }
+        assert_eq!(text(&s), if settle_with_navigation { "XYZ" } else { "Y" });
+        let st = s.doc().unwrap();
+        let p = &cmd::text::body_of(st, st.selection.text.as_ref().unwrap()).unwrap().paragraphs[0];
+        assert_eq!(p.end_props, first_para.end_props, "both settlement paths retain the paragraph mark");
+        let recorded = &s.journal[j0..];
+        assert_eq!(recorded.len(), if settle_with_navigation { 2 } else { 1 });
+        assert_eq!(recorded[0].0, "text.commit");
+        assert_eq!((recorded[0].1["before"].clone(), recorded[0].1["after"].clone()), (json!(5), json!(3)));
+        let repeated = replay(&base, recorded);
+        assert_eq!(*s.doc().unwrap().doc, *repeated.doc().unwrap().doc);
+        assert_eq!(s.doc().unwrap().selection, repeated.doc().unwrap().selection);
+        assert_eq!(&repeated.journal, recorded);
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert_eq!(*s.doc().unwrap().doc, *base.doc);
+        assert_eq!(s.doc().unwrap().selection, base.selection);
+    }
+}
