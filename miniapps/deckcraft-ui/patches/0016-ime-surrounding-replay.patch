+//! IME surrounding deletion operates on scalar indices and the canonical Session document.
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+use crate::*;
+use deckcraft_model::ShapeKind;
+use serde_json::json;
+use std::sync::Arc;
+
+fn editing(text: &str, anchor: (usize, usize), caret: (usize, usize)) -> Session {
+    let mut s = Session::with_new();
+    let id = s.doc().unwrap().current_slide().unwrap().shapes[0].id.0;
+    s.execute("text.set", &json!({"id":id,"text":text})).unwrap();
+    s.execute("text.edit", &json!({"id":id})).unwrap();
+    s.execute("text.select", &json!({"anchor":anchor,"caret":caret})).unwrap();
+    s
+}
+fn text(s: &Session) -> String {
+    let st = s.doc().unwrap();
+    cmd::text::body_of(st, st.selection.text.as_ref().unwrap()).unwrap().text()
+}
+fn range(s: &Session) -> ((usize, usize), (usize, usize)) {
+    let t = s.doc().unwrap().selection.text.as_ref().unwrap();
+    (t.anchor, t.caret)
+}
+fn replay(snapshot: &DocState, commands: &[(String, serde_json::Value)]) -> Session {
+    let mut s = Session::new();
+    s.add_document(snapshot.clone());
+    for (id, p) in commands {
+        s.execute(id, p).unwrap();
+    }
+    s
+}
+
+#[test]
+fn ime_surrounding_ios_correction_removes_the_old_prefix_before_replacement() {
+    let mut s = editing("tex", (0, 3), (0, 3));
+    let baseline = s.doc().unwrap().clone();
+    let j0 = s.journal.len();
+    s.delete_surrounding_text(3, 0).unwrap();
+    s.type_text("Texto").unwrap();
+    assert_eq!(text(&s), "Texto");
+    let repeated = replay(&baseline, &s.journal[j0..]);
+    assert_eq!(*s.doc().unwrap().doc, *repeated.doc().unwrap().doc);
+    assert_eq!(range(&s), range(&repeated));
+    s.execute("edit.undo", &json!({})).unwrap();
+    assert_eq!(text(&s), "");
+    s.execute("edit.undo", &json!({})).unwrap();
+    assert_eq!(text(&s), "tex");
+}
+
+#[test]
+fn ime_surrounding_keeps_selected_text_direction_unicode_and_paragraph_boundaries() {
+    let cases = [
+        ("<<L_R>>", (0, 3), (0, 4), 1, 1, "<<_>>", (0, 2), (0, 3)),
+        ("<<L_R>>", (0, 4), (0, 3), 1, 1, "<<_>>", (0, 3), (0, 2)),
+        ("L😀e\u{301}R", (0, 4), (0, 2), 1, 1, "Le\u{301}", (0, 3), (0, 1)),
+        // One scalar removes only the combining accent, not the whole grapheme.
+        ("Ae\u{301}B", (0, 3), (0, 3), 1, 0, "AeB", (0, 2), (0, 2)),
+        ("😀AB🚀", (0, 1), (0, 3), usize::MAX, usize::MAX, "AB", (0, 0), (0, 2)),
+        ("AA\nBB\nCC", (1, 2), (1, 0), 3, 3, "BB", (0, 2), (0, 0)),
+        ("a\n\nb", (1, 0), (1, 0), 1, 1, "ab", (0, 1), (0, 1)),
+        ("", (0, 0), (0, 0), usize::MAX, usize::MAX, "", (0, 0), (0, 0)),
+    ];
+    for (initial, a, c, before, after, expected, ea, ec) in cases {
+        let mut s = editing(initial, a, c);
+        let base = s.doc().unwrap().clone();
+        let j0 = s.journal.len();
+        s.delete_surrounding_text(before, after).unwrap();
+        assert_eq!(text(&s), expected, "{initial:?}");
+        assert_eq!(range(&s), (ea, ec), "{initial:?}");
+        assert_eq!(s.doc().unwrap().history.undo.len(), base.history.undo.len() + usize::from(initial != expected));
+        let repeated = replay(&base, &s.journal[j0..]);
+        assert_eq!(*s.doc().unwrap().doc, *repeated.doc().unwrap().doc);
+        assert_eq!(range(&s), range(&repeated));
+    }
+}
+
+#[test]
+fn ime_surrounding_composition_commit_and_navigation_replay_one_grouped_edit() {
+    for settle_with_navigation in [false, true] {
+        let mut s = editing("AB tail", (0, 2), (0, 2));
+        let base = s.doc().unwrap().clone();
+        let j0 = s.journal.len();
+        s.compose_text("한글", Some((1, 2))).unwrap();
+        let original_before = s.doc().unwrap().composition.as_ref().unwrap().before.clone();
+        // Two requests coalesce. They remove outside the preedit, never the preedit itself.
+        s.delete_surrounding_text(1, 1).unwrap();
+        s.delete_surrounding_text(usize::MAX, 0).unwrap();
+        assert_eq!(text(&s), "한글tail");
+        let c = s.doc().unwrap().composition.as_ref().unwrap();
+        assert_eq!((c.start, c.len, c.active, c.delete_before, c.delete_after), ((0, 0), 2, Some((1, 2)), 2, 1));
+        assert!(Arc::ptr_eq(&c.before, &original_before));
+        assert_eq!(s.doc().unwrap().history.undo.len(), base.history.undo.len());
+        assert_eq!(s.journal.len(), j0, "transient preedit/deletion has no durable replay record yet");
+        if settle_with_navigation {
+            s.execute("text.move", &json!({"to":"left"})).unwrap();
+        } else {
+            s.commit_text("한국").unwrap();
+        }
+        let expected = if settle_with_navigation { "한글tail" } else { "한국tail" };
+        assert_eq!(text(&s), expected);
+        assert!(s.doc().unwrap().composition.is_none());
+        assert_eq!(s.doc().unwrap().history.undo.len(), base.history.undo.len() + 1);
+        let recorded = &s.journal[j0..];
+        assert_eq!(recorded[0].0, "text.commit");
+        assert_eq!(recorded[0].1["before"], 2);
+        assert_eq!(recorded[0].1["after"], 1);
+        assert_eq!(recorded.len(), if settle_with_navigation { 2 } else { 1 });
+        let repeated = replay(&base, recorded);
+        assert_eq!(*s.doc().unwrap().doc, *repeated.doc().unwrap().doc);
+        assert_eq!(range(&s), range(&repeated));
+        assert_eq!(s.doc().unwrap().history.undo.len(), repeated.doc().unwrap().history.undo.len());
+        assert_eq!(&repeated.journal, recorded, "replaying produces the same canonical records");
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert_eq!(text(&s), "AB tail");
+        s.execute("edit.redo", &json!({})).unwrap();
+        assert_eq!(text(&s), expected);
+    }
+}
