+fn mixed_props_boundary(paragraph_break: bool) -> Session {
+    let mut s = editing(if paragraph_break { "AA\nBB" } else { "AABB" }, (0, 0), (0, 2));
+    s.execute("format.bold", &json!({"on":true})).unwrap();
