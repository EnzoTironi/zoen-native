+#[test]
+fn ime_surrounding_collapsed_boundary_keeps_initial_run_props_and_replays_the_full_presentation() {
+    for paragraph_break in [false, true] {
+        let mut s = mixed_props_boundary(paragraph_break);
+        let base = s.doc().unwrap().clone();
+        let j0 = s.journal.len();
+        let t = base.selection.text.as_ref().unwrap();
+        let body = cmd::text::body_of(&base, t).unwrap();
+        let inherited = deckcraft_model::edit::props_at(body, t.caret);
+        assert_eq!(inherited.bold == Some(true), !paragraph_break);
+        assert_eq!(inherited.italic == Some(true), paragraph_break);
+        // This is exactly the original compose insertion when props remained None.
+        let mut first_preedit = body.clone();
+        deckcraft_model::edit::insert(&mut first_preedit, t.caret, "X", None);
+        s.compose_text("X", None).unwrap();
+        let st = s.doc().unwrap();
+        assert_eq!(cmd::text::body_of(st, st.selection.text.as_ref().unwrap()).unwrap(), &first_preedit);
+        // Remove the run (or paragraph boundary) that determined the first inheritance.
+        s.delete_surrounding_text(if paragraph_break { 1 } else { 2 }, 0).unwrap();
+        s.commit_text("Y").unwrap();
+        assert_eq!(text(&s), if paragraph_break { "AAYBB" } else { "YBB" });
+        let recorded = &s.journal[j0..];
+        assert_eq!(recorded.len(), 1);
+        assert_eq!(recorded[0].0, "text.commit");
+        let repeated = replay(&base, recorded);
+        // Plain text agrees on the unfixed implementation; the run properties do not.
+        assert_eq!(*s.doc().unwrap().doc, *repeated.doc().unwrap().doc);
+        assert_eq!(s.doc().unwrap().selection, repeated.doc().unwrap().selection);
+        assert_eq!(&repeated.journal, recorded);
+        assert_eq!(recorded[0].1["props"], serde_json::to_value(&inherited).unwrap());
+        let committed = s.doc().unwrap().doc.clone();
+        assert_eq!(s.doc().unwrap().history.undo.len(), base.history.undo.len() + 1);
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert_eq!(*s.doc().unwrap().doc, *base.doc);
+        assert_eq!(s.doc().unwrap().selection, base.selection);
+        s.execute("edit.redo", &json!({})).unwrap();
+        assert_eq!(*s.doc().unwrap().doc, *committed);
+    }
+}
