+#[test]
+fn actual_notes_tap_publishes_platform_ime_and_real_canvas_blur_commits_typed_notes() {
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    h.query_all_by_role(Role::MultilineTextInput).next().expect("actual Notes TextEdit").click();
+    h.run_steps(1);
+    assert!(h.ctx.memory(|m| m.focused()).is_some(), "real TextEdit focus was obtained by a tap");
+    let ime = h.output().platform_output.ime.as_ref().expect("the focused Notes field must publish IME in final full output");
+    assert_eq!(ime.purpose, egui::IMEPurpose::Normal);
+    assert!(ime.cursor_rect.is_finite() && ime.cursor_rect.width() > 0.0 && ime.cursor_rect.height() > 0.0);
+    assert!(h.ctx.content_rect().contains(ime.cursor_rect.center()));
+    h.event(Event::Text("Zoen Notes IME boundary".into()));
+    h.run_steps(2);
+    let input = h.query_all_by_role(Role::MultilineTextInput).next().expect("same mounted Notes input");
+    assert_eq!(input.accesskit_node().value().as_deref(), Some("Zoen Notes IME boundary"));
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[0].notes.text(), "", "still-focused Notes are a draft");
+    let at = h.state().app.canvas_rect.unwrap().left_top() + vec2(4.0, 4.0);
+    actual_canvas_tap(&mut h, at);
+    h.run_steps(3);
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[0].notes.text(), "Zoen Notes IME boundary");
+    assert!(h.ctx.memory(|m| m.focused()).is_none());
+    assert!(h.output().platform_output.ime.is_none(), "blank-canvas blur ends the text-input request");
+}
