+fn actual_canvas_tap(h: &mut Harness<'_, State>, at: egui::Pos2) {
+    // Same real pointer-event route as the upstream canvas tests, no selection injection.
+    for pressed in [true, false] {
+        let time = h.ctx.input(|i| i.time) + 0.05;
+        h.input_mut().time = Some(time);
+        h.event(Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE });
+        h.step();
+    }
+}
