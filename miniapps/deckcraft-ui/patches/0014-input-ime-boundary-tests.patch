+#[test]
+fn actual_title_tap_publishes_platform_ime_before_real_text_event_edits_the_shape() {
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    let state = h.state().app.session.active().unwrap();
+    let title = state
+        .shapes()
+        .iter()
+        .find(|s| matches!(s.ph_type(), Some(deckcraft_model::PhType::Title | deckcraft_model::PhType::CtrTitle)))
+        .expect("real new-presentation title placeholder");
+    let id = title.id;
+    let rect = deckcraft_engine::cmd::xfrm_of(&state.doc, &state.selection, title);
+    let app = &h.state().app;
+    let at = app.slide_rect.unwrap().min + vec2((rect.x + rect.w * 0.5) as f32, (rect.y + rect.h * 0.5) as f32) * app.canvas_scale;
+    actual_canvas_tap(&mut h, at);
+    h.run_steps(1);
+    let state = h.state().app.session.active().unwrap();
+    assert_eq!(state.selection.text.as_ref().expect("actual title tap enters text editing").shape, id);
+    assert!(h.ctx.memory(|m| m.focused()).is_none(), "custom canvas owns typing rather than an egui TextEdit");
+    let ime = h.output().platform_output.ime.as_ref().expect("the final full output must activate the platform TextAgent");
+    assert_eq!(ime.purpose, egui::IMEPurpose::Normal);
+    assert!(ime.cursor_rect.is_finite() && ime.cursor_rect.width() > 0.0 && ime.cursor_rect.height() > 0.0);
+    assert!(h.ctx.content_rect().contains(ime.cursor_rect.center()));
+    let before = state.doc.clone();
+    h.event(Event::Text("Zoen title IME boundary".into()));
+    h.run_steps(3);
+    let state = h.state().app.session.active().unwrap();
+    assert_eq!(state.shape(id).unwrap().text.as_ref().unwrap().text(), "Zoen title IME boundary");
+    assert!(!Arc::ptr_eq(&before, &state.doc), "typing must reach the upstream Session document");
+}
