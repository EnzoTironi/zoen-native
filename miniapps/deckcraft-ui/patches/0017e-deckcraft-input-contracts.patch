+#[test]
+fn actual_multitouch_revokes_the_title_owner_without_changing_egui_thresholds() {
+    use web_text_activation::{Family, PrimaryContact};
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    let at = title_activation_target(&h);
+    let mut contact = PrimaryContact::default();
+    assert!(contact.start(Family::Pointer, 11, true));
+    primary_event(&mut h, at, true);
+    assert!(!contact.start(Family::Touch, 93, true));
+    touch_event(&mut h, at, 93, egui::TouchPhase::Start);
+    assert!(!contact.start(Family::Touch, 94, false));
+    touch_event(&mut h, at + vec2(30.0, 0.0), 94, egui::TouchPhase::Start);
+    h.step();
+    assert_eq!(contact.end(Family::Touch, 94), None, "secondary release cannot release the primary");
+    touch_event(&mut h, at + vec2(30.0, 0.0), 94, egui::TouchPhase::End);
+    touch_event(&mut h, at, 93, egui::TouchPhase::End);
+    assert_eq!(contact.end(Family::Pointer, 11), None);
+    assert_eq!(contact.end(Family::Touch, 93), Some(false), "multitouch revokes activation eligibility");
+    primary_event(&mut h, at, false);
+    assert!(!activation_after_current_frame(&h));
+}
