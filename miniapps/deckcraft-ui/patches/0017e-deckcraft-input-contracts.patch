+#[test]
+fn rapid_title_word_and_paragraph_clicks_finish_the_gesture_and_preserve_selection() {
+    use web_text_activation::{Family, PrimaryContact};
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    let mut contact = PrimaryContact::default();
+    let at = title_activation_target(&h);
+    assert!(contact.start(Family::Pointer, 11, true));
+    primary_event(&mut h, at, true);
+    assert_eq!(contact.end(Family::Pointer, 11), Some(true));
+    primary_event(&mut h, at, false);
+    assert!(activation_after_current_frame(&h));
+    h.event(Event::Text("Alpha beta".into()));
+    h.run_steps(1);
+    let at = title_activation_target(&h);
+    let doc = h.state().app.session.active().unwrap().doc.clone();
+    for (index, id) in [93, 94].into_iter().enumerate() {
+        assert!(contact.start(Family::Touch, id, true));
+        touch_event(&mut h, at, id, egui::TouchPhase::Start);
+        primary_event(&mut h, at, true);
+        assert!(!activation_after_current_frame(&h), "a press cannot reuse the earlier activation");
+        let state = h.state().app.session.active().unwrap();
+        let before = state.selection.text.as_ref().unwrap().clone();
+        let body = deckcraft_engine::cmd::text::body_of(state, &before).unwrap();
+        let expected = if index == 0 {
+            deckcraft_model::edit::word_at(body, before.caret)
+        } else {
+            ((before.caret.0, 0), (before.caret.0, body.paragraphs[before.caret.0].char_len()))
+        };
+        assert_eq!(contact.end(Family::Pointer, 11), None);
+        assert_eq!(contact.end(Family::Touch, id), Some(true));
+        touch_event(&mut h, at, id, egui::TouchPhase::End);
+        primary_event(&mut h, at, false);
+        if index == 0 {
+            assert!(h.ctx.input(|input| input.pointer.button_double_clicked(egui::PointerButton::Primary)));
+        } else {
+            assert!(h.ctx.input(|input| input.pointer.button_triple_clicked(egui::PointerButton::Primary)));
+        }
+        let state = h.state().app.session.active().unwrap();
+        let selected = state.selection.text.as_ref().unwrap();
+        assert_eq!(selected.shape, before.shape);
+        assert_eq!((selected.anchor, selected.caret), expected, "physical Up keeps the engine's word/paragraph selection");
+        assert!(Arc::ptr_eq(&state.doc, &doc), "gesture completion cannot modify the document");
+        assert!(!h.state().app.session.tool.dragging(), "a released text selection is not an ongoing drag");
+        assert!(activation_after_current_frame(&h), "this actual multi-click admits its current textual owner");
+        assert!(!activation_after_current_frame(&h));
+    }
+}
