+#[test]
+fn first_actual_title_tap_admits_one_current_owner_pulse_not_a_later_ime_frame() {
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    let at = title_activation_target(&h);
+    assert!(!activation_after_current_frame(&h));
+    primary_event(&mut h, at, true);
+    assert!(!activation_after_current_frame(&h), "press alone is not release admission");
+    primary_event(&mut h, at, false);
+    assert!(h.state().app.session.active().unwrap().selection.text.is_some());
+    assert!(activation_after_current_frame(&h), "same release entered the real title editor");
+    assert!(!activation_after_current_frame(&h), "custom pulse is consumed once");
+    h.run_steps(1);
+    assert!(h.output().platform_output.ime.is_some());
+    assert!(!activation_after_current_frame(&h), "persistent IME cannot authorize another gesture");
+}
