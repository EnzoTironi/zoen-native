+#[test]
+fn cancelled_contact_has_no_up_or_stuck_button_and_the_next_real_tap_recovers() {
+    use web_text_activation::{Family, PrimaryContact};
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    let at = title_activation_target(&h);
+    let mut contact = PrimaryContact::default();
+    assert!(contact.start(Family::Pointer, 1, true));
+    primary_event(&mut h, at, true);
+    assert!(!contact.start(Family::Touch, 93, true));
+    touch_event(&mut h, at, 93, egui::TouchPhase::Start);
+    assert!(h.ctx.input(|input| input.pointer.primary_down()));
+    let mut cancelled_events = vec![];
+    assert!(web_text_activation::cancel_primary(&h.ctx, &mut contact, &mut cancelled_events));
+    assert!(!cancelled_events.iter().any(|event| matches!(event, Event::PointerButton { .. })));
+    for event in cancelled_events {
+        h.event(event);
+    }
+    touch_event(&mut h, at, 93, egui::TouchPhase::Cancel);
+    h.step();
+    assert!(!h.ctx.input(|input| input.pointer.any_down()));
+    assert!(!h.state().app.session.tool.dragging(), "the real editor also ends the cancelled contact at its last position");
+    assert!(!activation_after_current_frame(&h));
+    assert_eq!(contact.end(Family::Pointer, 1), None, "cancel produces no fake clickable Up");
+    assert_eq!(contact.end(Family::Touch, 93), None, "the companion cannot revive a cancelled click");
+    assert!(contact.start(Family::Pointer, 2, true));
+    primary_event(&mut h, at, true);
+    assert_eq!(contact.end(Family::Pointer, 2), Some(true));
+    primary_event(&mut h, at, false);
+    assert!(activation_after_current_frame(&h));
+}
