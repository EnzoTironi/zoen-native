+#[test]
+fn late_touch_start_uses_its_own_target_instead_of_a_previous_title_activation() {
+    use web_text_activation::{Family, PrimaryContact};
+    for next_is_text in [false, true] {
+        let portrait = layout(430.0, 932.0, 0.0, 0.0);
+        let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+        let title = title_activation_target(&h);
+        let blank = h.state().app.canvas_rect.unwrap().left_top() + vec2(4.0, 4.0);
+        let mut contact = PrimaryContact::default();
+        assert!(contact.start(Family::Pointer, 11, true));
+        primary_event(&mut h, title, true);
+        assert_eq!(contact.end(Family::Pointer, 11), Some(true));
+        primary_event(&mut h, title, false);
+        assert!(activation_after_current_frame(&h));
+        assert!(!activation_after_current_frame(&h));
+        let next = if next_is_text { title } else { blank };
+        assert!(contact.start(Family::Touch, 93, true), "a post-release Touch start is a new contact");
+        touch_event(&mut h, next, 93, egui::TouchPhase::Start);
+        primary_event(&mut h, next, true);
+        assert!(!activation_after_current_frame(&h), "no reuse of the previous release's consumed pulse");
+        assert_eq!(contact.end(Family::Pointer, 11), None);
+        assert_eq!(contact.end(Family::Touch, 93), Some(true));
+        touch_event(&mut h, next, 93, egui::TouchPhase::End);
+        primary_event(&mut h, next, false);
+        assert_eq!(activation_after_current_frame(&h), next_is_text, "only this gesture's actual target can authorize focus");
+    }
+}
