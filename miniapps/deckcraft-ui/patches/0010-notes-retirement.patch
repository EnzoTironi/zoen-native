+/// Preserve a hosted Notes draft when controls remove its editor this frame.
+/// A still-mounted editor retains its normal focus/IME/rotation behavior.
+pub(crate) fn flush_unmounted_notes(app: &mut SlideApp) {
+    let mounted = app.ui.notes
+        && app.show.is_none()
+        && app.backstage.is_none()
+        && matches!(app.ui.view, ViewMode::Normal | ViewMode::Outline | ViewMode::Reading)
+        && app.session.active().is_some_and(|d| d.selection.target == deckcraft_engine::Target::Slides);
+    if mounted || !app.notes_buf.2.edited {
+        return;
+    }
+    if flush_notes_draft(app).is_err() {
+        app.notify("Speaker notes could not be saved. The draft is retained for retry.");
+    }
+}
+
+fn flush_notes_draft(app: &mut SlideApp) -> Result<(), String> {
+    if !app.notes_buf.2.edited {
+        return Ok(());
+    }
+    let (uid, index) = (app.notes_buf.0, app.notes_buf.1);
+    let Some(notes) = app.session.active().filter(|d| d.uid == uid).and_then(|d| d.doc.slides.get(index)).map(|s| &s.notes) else {
+        // Never attribute a retained draft to another document or missing slide.
+        return Err("The original speaker-notes slide is unavailable.".into());
+    };
+    if *notes != app.notes_buf.2.body {
+        // Keep the exact draft retryable; an error is not a successful commit.
+        app.run("slide.notes", json!({"body": app.notes_buf.2.body, "index": index}))?;
+    }
+    app.notes_buf.2.edited = false;
+    Ok(())
+}
