+#[test]
+fn hosted_hidden_notes_preserve_a_rejected_command_and_retry_exact_draft() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    type_hosted_notes(&mut h, "Keep this exact draft");
+    let before = h.state().app.session.active().unwrap().doc.clone();
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    h.state_mut().app.session.command_policy =
+        Some(|id, _| if id == "slide.notes" { Err(deckcraft_engine::EngineError::Other("notes command rejected".into())) } else { Ok(()) });
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(3);
+    assert!(!h.state().app.ui.notes);
+    assert!(h.state().app.notes_buf.2.edited, "rejection must not clear the pending edit");
+    assert_eq!(h.state().app.notes_buf.2.text, "Keep this exact draft");
+    assert!(Arc::ptr_eq(&before, &h.state().app.session.active().unwrap().doc));
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo);
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    assert!(h.state().app.ui.notes);
+    assert!(h.state().app.notes_buf.2.edited, "reopening a still-denied editor must not discard its draft");
+    assert_eq!(h.state().app.notes_buf.2.text, "Keep this exact draft");
+    assert!(Arc::ptr_eq(&before, &h.state().app.session.active().unwrap().doc));
+    h.state_mut().app.session.command_policy = None;
+    h.run_steps(2);
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[0].notes.text(), "Keep this exact draft");
+    assert!(!h.state().app.notes_buf.2.edited);
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo + 1);
