+fn type_hosted_notes(h: &mut Harness<'_, State>, text: &str) {
+    use egui::accesskit::Role;
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    h.query_all_by_role(Role::MultilineTextInput).next().expect("actual Notes TextEdit").click();
+    h.run_steps(1);
+    h.event(Event::Text(text.into()));
+    h.run_steps(1);
+    assert!(h.state().app.notes_buf.2.edited, "typing is still a live local draft before blur");
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[0].notes.text(), "");
+}
+
+#[test]
+fn hosted_removing_notes_editor_commits_real_draft_before_snapshot_or_retirement() {
+    for action in ["Speaker notes", "Slides", "File", "Present"] {
+        let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+        let text = format!("Notes retained after {action}");
+        let before = h.state().app.session.active().unwrap().history.undo.len();
+        type_hosted_notes(&mut h, &text);
+        h.get_by_label(action).click();
+        h.run_steps(3);
+        let state = h.state().app.session.active().unwrap();
+        assert_eq!(state.doc.slides[0].notes.text(), text, "{action} removed the editor without discarding its draft");
+        assert_eq!(state.history.undo.len(), before + 1, "one real slide.notes document edit");
+        assert!(!h.state().app.notes_buf.2.edited);
+        // A genuine PPTX roundtrip consumes Session document bytes, not the UI buffer.
+        let bytes = deckcraft_engine::cmd::file::save_bytes(&state.doc, "pptx").unwrap();
+        let mut reopened = Session::with_new();
+        reopened.execute("file.openBytes", &json!({"name":"retained-notes.pptx", "data":deckcraft_engine::cmd::base64_encode(&bytes)})).unwrap();
+        assert_eq!(reopened.active().unwrap().doc.slides[0].notes.text(), text);
+        h.run_steps(3);
+        assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), before + 1, "later frames must not duplicate the edit");
+    }
+}
