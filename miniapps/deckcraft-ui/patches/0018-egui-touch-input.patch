+#[test]
+fn actual_notes_touch_release_with_pointergone_admits_hint_input() {
+    for size in [vec2(402.0, 874.0), vec2(430.0, 932.0)] {
+        let portrait = layout(size.x, size.y, 0.0, 0.0);
+        let mut h = fixture(Some(portrait), size);
+        h.get_by_label("Speaker notes").click();
+        h.run_steps(2);
+        let rect = h.query_all_by_role(Role::MultilineTextInput).next().unwrap().rect();
+        let at = rect.left_top() + vec2(59.0, 7.0);
+        h.input_mut().time = Some(h.ctx.input(|input| input.time) + 0.05);
+        h.input_mut().events.extend([
+            Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: true, modifiers: egui::Modifiers::NONE },
+            Event::Touch { device_id: egui::TouchDeviceId(0), id: egui::TouchId::from(7), phase: egui::TouchPhase::Start, pos: at, force: None },
+        ]);
+        h.step();
+        h.input_mut().time = Some(h.ctx.input(|input| input.time) + 0.05);
+        h.input_mut().events.extend([
+            Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: false, modifiers: egui::Modifiers::NONE },
+            Event::PointerGone,
+            Event::Touch { device_id: egui::TouchDeviceId(0), id: egui::TouchId::from(7), phase: egui::TouchPhase::End, pos: at, force: None },
+        ]);
+        h.step();
+        let id = egui::Id::new("notes_edit");
+        let response = h.ctx.read_response(id).unwrap();
+        assert!(
+            activation_after_current_frame(&h),
+            "size={size:?} rect={rect:?} focused={} clicked={} ime={} response_focus={}",
+            h.ctx.text_edit_focused(),
+            response.clicked_by(egui::PointerButton::Primary),
+            h.output().platform_output.ime.is_some(),
+            response.has_focus()
+        );
+    }
+}
