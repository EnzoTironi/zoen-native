+#[test]
+fn unfocused_touch_drag_and_cancel_do_not_admit_text_but_next_tap_recovers() {
+    for cancel in [false, true] {
+        let mut editor = Editor::new("alpha beta", true);
+        let (_, field) = editor.frame(vec![], Modifiers::NONE);
+        let at = field.response.rect.center();
+        editor.down(at, true, Modifiers::NONE);
+        let (full, field) = if cancel {
+            // eframe cancels button state without fabricating a clickable Up.
+            editor
+                .ctx
+                .input_mut(|input| input.pointer = crate::PointerState::default());
+            editor.frame(
+                vec![Event::PointerGone, touch_event(at, TouchPhase::Cancel)],
+                Modifiers::NONE,
+            )
+        } else {
+            let moved = at + vec2(0.0, 35.0);
+            editor.frame(
+                vec![
+                    Event::PointerMoved(moved),
+                    touch_event(moved, TouchPhase::Move),
+                ],
+                Modifiers::NONE,
+            );
+            editor.up(moved, true, Modifiers::NONE)
+        };
+        assert!(!field.response.clicked());
+        assert!(!field.response.has_focus());
+        assert!(full.platform_output.ime.is_none());
+        editor.time += 1.0;
+        let (full, field) = editor.tap(at, true, Modifiers::NONE);
+        assert!(field.response.clicked() && field.response.has_focus());
+        assert!(full.platform_output.ime.is_some());
+    }
+}
+
+#[test]
+fn focused_pointer_and_touch_drag_selection_is_not_collapsed_on_release() {
+    for touch in [false, true] {
+        let mut editor = Editor::new("alpha beta", true);
+        let (_, field) = editor.frame(vec![], Modifiers::NONE);
+        editor.tap(Editor::point(&field, 0), touch, Modifiers::NONE);
+        // A normal paint establishes the focused widget's drag sense before
+        // the next independent gesture is hit-tested against previous widgets.
+        editor.frame(vec![], Modifiers::NONE);
+        editor.time += 1.0;
+        let at = Editor::point(&field, 1);
+        editor.down(at, touch, Modifiers::NONE);
+        let moved = Editor::point(&field, 8);
+        let mut events = vec![Event::PointerMoved(moved)];
+        if touch {
+            events.push(touch_event(moved, TouchPhase::Move));
+        }
+        editor.frame(events, Modifiers::NONE);
+        let (_, field) = editor.up(moved, touch, Modifiers::NONE);
+        assert!(!field.response.clicked());
+        assert_eq!(selection(&field), 1..8, "touch={touch}");
+    }
+}
+
+#[test]
+fn disabled_and_noninteractive_text_do_not_request_ime() {
+    for disabled in [false, true] {
+        let mut editor = Editor::new("unchanged", true);
+        editor.enabled = !disabled;
+        editor.interactive = disabled;
+        let (_, field) = editor.frame(vec![], Modifiers::NONE);
+        let (full, field) = editor.tap(field.response.rect.center(), true, Modifiers::NONE);
+        assert!(!field.response.has_focus());
+        assert!(full.platform_output.ime.is_none());
+        assert_eq!(editor.text, "unchanged");
+    }
+}
