+#[test]
+fn host_freeze_preparation_commits_a_visible_notes_draft_exactly_once() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    type_hosted_notes(&mut h, "The close snapshot must include these notes");
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    h.state_mut().app.prepare_host_freeze().unwrap();
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[0].notes.text(), "The close snapshot must include these notes");
+    assert!(!h.state().app.notes_buf.2.edited);
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo + 1);
+    h.state_mut().app.prepare_host_freeze().unwrap();
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo + 1);
+}
+
+#[test]
+fn host_freeze_preparation_refuses_a_hidden_denied_draft_then_retries_original_body() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    type_hosted_notes(&mut h, "No close ACK may discard this pending body");
+    h.state_mut().app.session.command_policy =
+        Some(|id, _| if id == "slide.notes" { Err(deckcraft_engine::EngineError::Other("notes rejected".into())) } else { Ok(()) });
+    h.get_by_label("Speaker notes").click();
+    h.run_steps(2);
+    let before = h.state().app.session.active().unwrap().doc.clone();
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    assert!(h.state_mut().app.prepare_host_freeze().is_err());
+    assert!(h.state().app.notes_buf.2.edited);
+    assert_eq!(h.state().app.notes_buf.2.text, "No close ACK may discard this pending body");
+    assert!(Arc::ptr_eq(&before, &h.state().app.session.active().unwrap().doc));
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo);
+    h.state_mut().app.session.command_policy = None;
+    h.state_mut().app.prepare_host_freeze().unwrap();
+    assert_eq!(h.state().app.session.active().unwrap().doc.slides[0].notes.text(), "No close ACK may discard this pending body");
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo + 1);
+    assert!(!h.state().app.notes_buf.2.edited);
+    h.state_mut().app.prepare_host_freeze().unwrap();
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo + 1);
+}
+
+#[test]
+fn host_freeze_preparation_refuses_notes_from_another_document_without_rebinding() {
+    let mut h = fixture(Some(portrait(430.0, Brightness::Dark)));
+    type_hosted_notes(&mut h, "Only the captured document can own this");
+    let origin = h.state().app.notes_buf.0;
+    h.state_mut().app.run("file.new", json!({})).unwrap();
+    assert_ne!(h.state().app.session.active().unwrap().uid, origin);
+    let before = h.state().app.session.active().unwrap().doc.clone();
+    let undo = h.state().app.session.active().unwrap().history.undo.len();
+    assert!(h.state_mut().app.prepare_host_freeze().is_err());
+    assert!(Arc::ptr_eq(&before, &h.state().app.session.active().unwrap().doc));
+    assert_eq!(h.state().app.session.active().unwrap().history.undo.len(), undo);
+    assert!(h.state().app.notes_buf.2.edited);
+    assert_eq!(h.state().app.notes_buf.2.text, "Only the captured document can own this");
+}
