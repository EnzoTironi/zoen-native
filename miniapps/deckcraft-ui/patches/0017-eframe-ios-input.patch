+#[test]
+fn actual_multitouch_revokes_the_title_owner_without_changing_egui_thresholds() {
+    let portrait = layout(430.0, 932.0, 0.0, 0.0);
+    let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+    let at = title_activation_target(&h);
+    touch_event(&mut h, at, 1, egui::TouchPhase::Start);
+    primary_event(&mut h, at, true);
+    touch_event(&mut h, at + vec2(30.0, 0.0), 2, egui::TouchPhase::Start);
+    h.step();
+    touch_event(&mut h, at + vec2(30.0, 0.0), 2, egui::TouchPhase::End);
+    touch_event(&mut h, at, 1, egui::TouchPhase::End);
+    primary_event(&mut h, at, false);
+    assert!(!activation_after_current_frame(&h));
+}
