+//! A primary contact has one event-family owner. This is not a gesture clock:
+//! egui remains responsible for click/drag thresholds and textual admission.
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Family {
+    Pointer,
+    Touch,
+}
+
+#[derive(Default)]
+pub(crate) struct PrimaryContact {
+    owner: Option<Family>,
+    pointer: Option<i32>,
+    touch: Option<i32>,
+    ended: bool,
+    blocked: bool,
+}
+
+impl PrimaryContact {
+    /// Returns whether this family owns the emulated primary button stream.
+    pub fn start(&mut self, family: Family, id: i32, single_primary: bool) -> bool {
+        if !single_primary {
+            self.blocked = true;
+            return false;
+        }
+        if self.owner.is_none() || self.ended {
+            *self = Self {
+                owner: Some(family),
+                ..Self::default()
+            };
+        }
+        let slot = match family {
+            Family::Pointer => &mut self.pointer,
+            Family::Touch => &mut self.touch,
+        };
+        if slot.is_some() {
+            return false;
+        }
+        *slot = Some(id);
+        self.owner == Some(family)
+    }
+
+    /// Returns once for the owning release, carrying eligibility for activation.
+    /// IDs of PointerEvent and Touch are deliberately never compared with each other.
+    pub fn end(&mut self, family: Family, id: i32) -> Option<bool> {
+        let slot = match family {
+            Family::Pointer => self.pointer,
+            Family::Touch => self.touch,
+        };
+        if self.ended || self.owner != Some(family) || slot != Some(id) {
+            return None;
+        }
+        self.ended = true;
+        Some(!self.blocked)
+    }
+
+    pub fn block(&mut self) {
+        self.blocked = true;
+    }
+
+    pub fn cancel(&mut self) -> bool {
+        let active = self.owner.is_some() && !self.ended;
+        self.blocked = true;
+        self.ended = true;
+        active
+    }
+}
+
+/// Cancellation must drop button/click state, not synthesize a clickable Up.
+/// PointerGone alone only hides hover and deliberately leaves buttons down.
+pub(crate) fn cancel_primary(
+    ctx: &egui::Context,
+    contact: &mut PrimaryContact,
+    events: &mut Vec<egui::Event>,
+) -> bool {
+    if !contact.cancel() {
+        return false;
+    }
+    let position = ctx.input(|input| input.pointer.interact_pos());
+    ctx.input_mut(|input| input.pointer = egui::PointerState::default());
+    // Keep the last real position for normal editor gesture cleanup on the
+    // next frame. There is still no ButtonUp/click or keyboard authorization.
+    if let Some(position) = position {
+        events.push(egui::Event::PointerMoved(position));
+    }
+    events.push(egui::Event::PointerGone);
+    true
+}
+
+const ACTIVATION: &str = "eframe.text_input_activation";
+
+/// A custom editor may publish a content-free (egui-frame, current-owner-ID)
+/// pulse after admitting a textual click. The standard TextEdit needs no adapter.
+/// The runner clears before logic and consumes after that same synchronous run.
+pub(crate) fn clear_custom(ctx: &egui::Context) {
+    ctx.data_mut(|data| data.remove::<Option<(u64, egui::Id)>>(egui::Id::new(ACTIVATION)));
+}
+
+pub(crate) fn accepted_current_text(ctx: &egui::Context, ime: bool) -> bool {
+    let custom = ctx.data_mut(|data| {
+        data.remove_temp::<Option<(u64, egui::Id)>>(egui::Id::new(ACTIVATION))
+            .flatten()
+    });
+    if !ime {
+        return false;
+    }
+    if ctx.text_edit_focused()
+        && let Some(id) = ctx.memory(|memory| memory.focused())
+        && let Some(response) = ctx.read_response(id)
+        && response.enabled()
+        && response.has_focus()
+        && response.clicked_by(egui::PointerButton::Primary)
+    {
+        return true;
+    }
+    // A custom canvas owns IME only while no ordinary egui widget has focus.
+    ctx.memory(|memory| memory.focused().is_none())
+        && custom
+            .is_some_and(|(frame, _owner)| frame.checked_add(1) == Some(ctx.cumulative_frame_nr()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pointer_only_and_touch_only_admit_one_pair_and_release() {
+        for family in [Family::Pointer, Family::Touch] {
+            let mut contact = PrimaryContact::default();
+            assert!(contact.start(family, 7, true));
+            assert!(!contact.start(family, 7, true));
+            assert_eq!(contact.end(family, 99), None);
+            assert_eq!(contact.end(family, 7), Some(true));
+            assert_eq!(contact.end(family, 7), None);
+        }
+    }
+
+    #[test]
+    fn both_families_use_first_owner_without_comparing_their_ids() {
+        for (first, second) in [
+            (Family::Pointer, Family::Touch),
+            (Family::Touch, Family::Pointer),
+        ] {
+            for release_owner_first in [true, false] {
+                let mut contact = PrimaryContact::default();
+                assert!(contact.start(first, 11, true));
+                assert!(!contact.start(second, 93, true));
+                if release_owner_first {
+                    assert_eq!(contact.end(first, 11), Some(true));
+                    assert_eq!(contact.end(second, 93), None);
+                } else {
+                    assert_eq!(contact.end(second, 93), None);
+                    assert_eq!(contact.end(first, 11), Some(true));
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn cancel_and_multitouch_cannot_authorize_keyboard_and_next_contact_recovers() {
+        for family in [Family::Pointer, Family::Touch] {
+            let mut contact = PrimaryContact::default();
+            assert!(contact.start(family, 1, true));
+            contact.block();
+            assert_eq!(contact.end(family, 1), Some(false));
+            assert!(contact.start(family, 2, true));
+            contact.cancel();
+            assert_eq!(contact.end(family, 2), None);
+            assert!(contact.start(family, 3, true));
+            assert_eq!(contact.end(family, 3), Some(true));
+        }
+    }
+}
