+#[test]
+fn actual_title_uses_one_pair_for_pointer_only_touch_only_and_both_families() {
+    use web_text_activation::{Family, PrimaryContact};
+    for families in [vec![Family::Pointer], vec![Family::Touch], vec![Family::Pointer, Family::Touch], vec![Family::Touch, Family::Pointer]] {
+        let portrait = layout(430.0, 932.0, 0.0, 0.0);
+        let mut h = fixture(Some(portrait), vec2(430.0, 932.0));
+        let at = title_activation_target(&h);
+        let mut contact = PrimaryContact::default();
+        let mut downs = 0;
+        let mut ups = 0;
+        let mut activations = 0;
+        for (index, family) in families.iter().enumerate() {
+            if contact.start(*family, index as i32 + 10, true) {
+                primary_event(&mut h, at, true);
+                downs += 1;
+            }
+        }
+        for (index, family) in families.iter().enumerate() {
+            if let Some(allowed) = contact.end(*family, index as i32 + 10) {
+                primary_event(&mut h, at, false);
+                ups += 1;
+                activations += usize::from(allowed && activation_after_current_frame(&h));
+            }
+        }
+        assert_eq!((downs, ups, activations), (1, 1, 1));
+    }
+}
