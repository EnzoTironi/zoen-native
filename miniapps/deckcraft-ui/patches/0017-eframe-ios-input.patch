+mod web_text_activation;
+
+fn activation_after_current_frame(h: &Harness<'_, State>) -> bool {
+    web_text_activation::accepted_current_text(&h.ctx, h.output().platform_output.ime.is_some())
+}
+
+fn title_activation_target(h: &Harness<'_, State>) -> egui::Pos2 {
+    let state = h.state().app.session.active().unwrap();
+    let title = state
+        .shapes()
+        .iter()
+        .find(|shape| matches!(shape.ph_type(), Some(deckcraft_model::PhType::Title | deckcraft_model::PhType::CtrTitle)))
+        .unwrap();
+    let rect = deckcraft_engine::cmd::xfrm_of(&state.doc, &state.selection, title);
+    h.state().app.slide_rect.unwrap().min + vec2((rect.x + rect.w * 0.5) as f32, (rect.y + rect.h * 0.5) as f32) * h.state().app.canvas_scale
+}
+
+fn primary_event(h: &mut Harness<'_, State>, at: egui::Pos2, pressed: bool) {
+    h.input_mut().time = Some(h.ctx.input(|input| input.time) + 0.05);
+    h.event(Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE });
+    h.step();
+}
+
+fn touch_event(h: &mut Harness<'_, State>, at: egui::Pos2, id: i32, phase: egui::TouchPhase) {
+    h.event(Event::Touch { device_id: egui::TouchDeviceId(0), id: egui::TouchId::from(id), phase, pos: at, force: None });
+}
