@@ -1834,6 +1834,23 @@
 
     /// Lay out the whole window.
     pub fn ui(&mut self, ui: &mut egui::Ui) {
+        if host_layout::current(ui.ctx()).is_some() {
+            let ctx = ui.ctx().clone();
+            // egui's root Ui still spans viewport_rect even with safe_area_insets.
+            // Keep its full background, then lay out hosted controls in safe content.
+            ui.painter().rect_filled(ctx.viewport_rect(), egui::CornerRadius::ZERO, theme::Tokens::get(&ctx).chrome);
+            let safe = ui.available_rect_before_wrap().intersect(ctx.content_rect());
+            if safe.width() > 0.0 && safe.height() > 0.0 {
+                let mut content = ui.new_child(egui::UiBuilder::new().id(egui::Id::new("zoen_host_safe_content")).max_rect(safe));
+                content.set_clip_rect(safe);
+                self.ui_contents(&mut content);
+            }
+        } else {
+            self.ui_contents(ui);
+        }
+    }
+
