+++ b/crates/ui-egui/src/host_compact_tests.rs
@@ -192,3 +192,24 @@
     assert!(h.state().app.canvas_rect.unwrap().left() >= 150.0);
     assert!(h.query_by_label("File").is_some());
 }
+
+#[test]
+fn real_root_ui_positions_wide_hosted_controls_with_either_landscape_safe_edge() {
+    for (left, right) in [(62.0, 0.0), (0.0, 62.0)] {
+        let layout = HostLayout {
+            width: 932.0,
+            height: 430.0,
+            insets: Insets { top: 0.0, right, bottom: 21.0, left },
+            close_button: Some(CloseRect { x: 932.0 - right - 56.0, y: 8.0, width: 44.0, height: 44.0 }),
+            theme: Some(Brightness::Dark),
+        };
+        let h = fixture(Some(layout));
+        let safe = h.ctx.content_rect();
+        let canvas = h.state().app.canvas_rect.unwrap();
+        assert!(safe.contains_rect(canvas), "the actual root Ui constrains canvas controls: {safe:?} / {canvas:?}");
+        let export = h.get_by_label("Export PDF or PowerPoint").rect();
+        assert!(export.left() >= safe.left() + 8.0, "actual panel honors the safe left edge: {export:?}");
+        assert!(safe.contains_rect(export));
+        assert!(!export.intersects(layout.close_rect(h.ctx.viewport_rect()).unwrap()));
+    }
+}
