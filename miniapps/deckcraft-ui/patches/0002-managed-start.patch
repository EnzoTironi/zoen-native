+/// Start the managed package once, after verified WASM initialization.
+#[cfg(feature = "zoen-host")]
+#[wasm_bindgen(js_name = zoenHostStart)]
+pub fn start_managed() -> std::result::Result<(), JsValue> {
+    let start = QUEUE.with(|q| {
+        let mut q = q.borrow_mut();
+        if q.started || !q.lifecycle.install(true) {
+            return false;
+        }
+        q.started = true;
+        true
+    });
+    if !start {
+        return Err(error("host_started_or_retired"));
+    }
+    crate::web::start(true);
+    Ok(())
 }
