+//! Optional embedding geometry. It is ephemeral UI input, never document state.
+use egui::{Rect, pos2};
+use serde::Deserialize;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Insets {
+    pub top: f32,
+    pub right: f32,
+    pub bottom: f32,
+    pub left: f32,
+}
+#[derive(Clone, Copy, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CloseRect {
+    pub x: f32,
+    pub y: f32,
+    pub width: f32,
+    pub height: f32,
+}
+#[derive(Clone, Copy, Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct HostLayout {
+    pub width: f32,
+    pub height: f32,
+    pub insets: Insets,
+    pub close_button: Option<CloseRect>,
+}
+impl HostLayout {
+    pub fn valid(&self) -> bool {
+        let i = self.insets;
+        let finite = [self.width, self.height, i.top, i.right, i.bottom, i.left].iter().all(|n| n.is_finite() && *n >= 0.0);
+        finite
+            && (1.0..=16_384.0).contains(&self.width)
+            && (1.0..=16_384.0).contains(&self.height)
+            && i.left + i.right < self.width
+            && i.top + i.bottom < self.height
+            && self.close_button.is_none_or(|r| {
+                [r.x, r.y, r.width, r.height].iter().all(|n| n.is_finite() && *n >= 0.0)
+                    && r.width > 0.0
+                    && r.height > 0.0
+                    && r.x + r.width <= self.width
+                    && r.y + r.height <= self.height
+            })
+    }
+    pub fn safe_insets(self, viewport: Rect) -> egui::SafeAreaInsets {
+        let sx = viewport.width() / self.width;
+        let sy = viewport.height() / self.height;
+        egui::SafeAreaInsets(egui::epaint::MarginF32 {
+            left: self.insets.left * sx,
+            right: self.insets.right * sx,
+            top: self.insets.top * sy,
+            bottom: self.insets.bottom * sy,
+        })
+    }
+    pub fn close_rect(self, viewport: Rect) -> Option<Rect> {
+        self.close_button.map(|r| {
+            Rect::from_min_max(
+                pos2(viewport.left() + r.x * viewport.width() / self.width, viewport.top() + r.y * viewport.height() / self.height),
+                pos2(
+                    viewport.left() + (r.x + r.width) * viewport.width() / self.width,
+                    viewport.top() + (r.y + r.height) * viewport.height() / self.height,
+                ),
+            )
+        })
+    }
+}
+const ID: &str = "zoen_host_layout";
+pub fn install(ctx: &egui::Context, layout: HostLayout) {
+    if layout.valid() {
+        ctx.data_mut(|data| data.insert_temp(egui::Id::new(ID), layout));
+    }
+}
+pub fn current(ctx: &egui::Context) -> Option<HostLayout> {
+    ctx.data(|data| data.get_temp(egui::Id::new(ID)))
+}
+/// Only popup controls avoid the floating native corner, never a global right gutter.
+pub fn popup_rect(ctx: &egui::Context) -> Rect {
+    let mut rect = ctx.content_rect();
+    if let Some(close) = current(ctx).and_then(|layout| layout.close_rect(ctx.viewport_rect())) {
+        rect.min.y = rect.min.y.max(close.bottom() + 8.0).min(rect.max.y - 1.0);
+    }
+    rect
+}
+/// Keep the existing title actions left of a native close control in that row.
+pub fn title_bounds(ctx: &egui::Context, rect: Rect) -> (f32, f32) {
+    let Some(close) = current(ctx).and_then(|layout| layout.close_rect(ctx.viewport_rect())) else { return (38.0, rect.right() - 10.0) };
+    let height = 38.0f32.max(close.bottom() - rect.top() + 8.0);
+    (height, (close.left() - 8.0).max(rect.left() + 1.0))
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::panic)]
+mod tests {
+    use super::*;
+    fn portrait() -> HostLayout {
+        HostLayout {
+            width: 430.0,
+            height: 932.0,
+            insets: Insets { top: 62.0, right: 0.0, bottom: 34.0, left: 0.0 },
+            close_button: Some(CloseRect { x: 374.0, y: 70.0, width: 44.0, height: 44.0 }),
+        }
+    }
+    #[test]
+    fn rejects_nonfinite_negative_overflow_and_unknown_fields() {
+        let good = portrait();
+        assert!(good.valid());
+        for value in [f32::NAN, f32::INFINITY, -1.0, 20_000.0] {
+            let mut bad = good;
+            bad.width = value;
+            assert!(!bad.valid());
+        }
+        let mut bad = good;
+        bad.insets.top = 932.0;
+        assert!(!bad.valid());
+        bad = good;
+        bad.close_button.as_mut().unwrap().x = 420.0;
+        assert!(!bad.valid());
+        assert!(
+            serde_json::from_str::<HostLayout>(
+                r#"{"width":430,"height":932,"insets":{"top":0,"right":0,"bottom":0,"left":0},"closeButton":null,"url":"https://example.invalid"}"#
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn actual_egui_safe_content_preserves_full_viewport_and_rotates_both_sides() {
+        let ctx = egui::Context::default();
+        for layout in [
+            portrait(),
+            HostLayout {
+                width: 932.0,
+                height: 430.0,
+                insets: Insets { top: 0.0, right: 0.0, bottom: 21.0, left: 62.0 },
+                close_button: Some(CloseRect { x: 876.0, y: 8.0, width: 44.0, height: 44.0 }),
+            },
+            HostLayout {
+                width: 932.0,
+                height: 430.0,
+                insets: Insets { top: 0.0, right: 62.0, bottom: 21.0, left: 0.0 },
+                close_button: Some(CloseRect { x: 814.0, y: 8.0, width: 44.0, height: 44.0 }),
+            },
+        ] {
+            let full = Rect::from_min_size(pos2(0.0, 0.0), egui::vec2(layout.width, layout.height));
+            let raw = egui::RawInput { screen_rect: Some(full), safe_area_insets: Some(layout.safe_insets(full)), ..Default::default() };
+            let mut output = ctx.run_ui(raw, |ui| {
+                let ctx = ui.ctx();
+                install(ctx, layout);
+                assert_eq!(ctx.viewport_rect(), full);
+                let safe = ctx.content_rect();
+                assert_eq!(safe.left(), layout.insets.left);
+                assert_eq!(safe.top(), layout.insets.top);
+                assert_eq!(safe.right(), layout.width - layout.insets.right);
+                assert_eq!(safe.bottom(), layout.height - layout.insets.bottom);
+                let close = layout.close_rect(full).unwrap();
+                let popup = popup_rect(ctx);
+                assert!(popup.top() > close.bottom());
+                assert_eq!(popup.right(), safe.right());
+                let (height, right) = title_bounds(ctx, safe);
+                assert!(right < close.left());
+                assert!(safe.top() + height > close.bottom());
+            });
+            // This is a geometry test with no renderer; consume egui's texture ownership.
+            output.textures_delta.clear();
+        }
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::panic)]
+mod export_tests {
+    use crate::{Services, SlideApp};
+    use std::sync::{Arc, Mutex};
+    #[test]
+    fn hosted_exports_are_only_intents_and_never_generate_browser_downloads() {
+        let formats = Arc::new(Mutex::new(Vec::<String>::new()));
+        let out = formats.clone();
+        let mut session = deckcraft_engine::Session::new();
+        session.execute("file.new", &serde_json::json!({})).unwrap();
+        let mut app = SlideApp::new(
+            session,
+            Services {
+                host_export: Some(Box::new(move |format| {
+                    out.lock().unwrap().push(format.to_string());
+                    true
+                })),
+                download: Some(Box::new(|_, _| panic!("hosted export cannot download"))),
+                ..Default::default()
+            },
+        );
+        assert!(app.export_as("pdf", serde_json::json!({})));
+        assert!(app.export_as("pptx", serde_json::json!({})));
+        assert!(!app.export_as("png", serde_json::json!({})));
+        assert_eq!(*formats.lock().unwrap(), vec!["pdf", "pptx"]);
+        assert!(app.session.active().is_some());
+    }
+    #[test]
+    fn unavailable_export_intent_preserves_document_and_reports_retry() {
+        let mut session = deckcraft_engine::Session::new();
+        session.execute("file.new", &serde_json::json!({})).unwrap();
+        let mut app = SlideApp::new(session, Services { host_export: Some(Box::new(|_| false)), ..Default::default() });
+        assert!(!app.export_as("pdf", serde_json::json!({})));
+        assert!(app.session.active().is_some());
+        assert!(app.status.is_some());
+    }
+}
