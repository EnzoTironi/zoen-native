+/// A UI intent callback, not document or filesystem authority. The official App
+/// adapter must save/verify the accepted head before native sharing.
+#[wasm_bindgen(js_name = zoenHostOnExport)]
+pub fn on_export(callback: Option<js_sys::Function>) -> std::result::Result<(), JsValue> {
+    QUEUE.with(|q| {
+        let mut q = q.borrow_mut();
+        if !q.lifecycle.active() {
+            return Err(error(q.startup_failure.unwrap_or("host_retired")));
+        }
+        q.on_export = callback;
+        Ok(())
+    })
+}
+pub fn export_intent(format: &str) -> bool {
+    if !matches!(format, "pdf" | "pptx") {
+        return false;
+    }
+    let callback = QUEUE.with(|q| {
+        let q = q.borrow();
+        if q.lifecycle.active() && !q.frozen { q.on_export.clone() } else { None }
+    });
+    callback.and_then(|f| f.call1(&JsValue::NULL, &JsValue::from_str(format)).ok()).and_then(|value| value.as_bool()).unwrap_or(false)
+}
+pub fn apply_layout(raw: &mut egui::RawInput, ctx: &egui::Context) {
+    let layout = QUEUE.with(|q| {
+        let q = q.borrow();
+        if q.lifecycle.active() { q.layout } else { None }
+    });
+    if let Some(layout) = layout {
+        let viewport = raw.screen_rect.unwrap_or_else(|| ctx.viewport_rect());
+        if viewport.is_finite() && viewport.width() > 0.0 && viewport.height() > 0.0 {
+            raw.safe_area_insets = Some(layout.safe_insets(viewport));
+        }
+    }
+}
