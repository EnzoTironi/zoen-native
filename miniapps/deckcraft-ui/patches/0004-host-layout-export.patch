+/// The managed editor keeps its existing commands in a compact touch toolbar.
+/// Its background/canvas remain full viewport; only controls avoid the native X.
+fn hosted_title_bar(app: &mut SlideApp, ui: &mut Ui) {
+    let t = Tokens::get(ui.ctx());
+    let (height, right_edge) = crate::host_layout::title_bounds(ui.ctx(), ui.ctx().content_rect());
+    egui::Panel::top("title_bar").exact_size(height).frame(egui::Frame::NONE.fill(t.chrome)).show(ui, |ui| {
+        let rect = ui.max_rect();
+        let has_doc = app.session.active().is_some();
+        let mut left = ui.new_child(
+            egui::UiBuilder::new()
+                .max_rect(Rect::from_min_max(pos2(rect.left() + 10.0, rect.top()), pos2((right_edge - 146.0).max(rect.left() + 65.0), rect.bottom())))
+                .layout(egui::Layout::left_to_right(egui::Align::Center)),
+        );
+        left.spacing_mut().item_spacing.x = 8.0;
+        if icon_toggle(&mut left, Icon::Home, "File", true, app.backstage_open()).clicked() {
+            let _ = app.run("app.home", json!({}));
+        }
+        if icon_toggle(&mut left, Icon::Export, "Export PDF or PowerPoint", has_doc, false).clicked() {
+            let _ = app.run("app.exportDialog", json!({}));
+        }
+        let mut right = ui.new_child(
+            egui::UiBuilder::new()
+                .max_rect(Rect::from_min_max(pos2((right_edge - 138.0).max(rect.left() + 80.0), rect.top()), pos2(right_edge, rect.bottom())))
+                .layout(egui::Layout::right_to_left(egui::Align::Center)),
+        );
+        right.spacing_mut().item_spacing.x = 8.0;
+        if icon_toggle(&mut right, Icon::Search, "Search commands", true, false).clicked() {
+            app.palette = Some((String::new(), 0));
+        }
+        let present = right.add_enabled(
+            has_doc,
+            egui::Button::new(egui::RichText::new("Present").color(t.accent_text)).fill(t.accent).corner_radius(18.0).min_size(vec2(76.0, 36.0)),
+        );
+        if present.clicked() {
+            let from = app.session.active().map(|d| d.selection.slide).unwrap_or(0);
+            app.start_show(from, false);
+        }
+    });
+}
