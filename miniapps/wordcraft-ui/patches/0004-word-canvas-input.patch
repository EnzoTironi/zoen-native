+//! A real managed Word canvas contact owns only its current document's rendered caret.
+//! This is ephemeral UI ownership, never a document/permission/keyboard clock.
+use crate::WordApp;
+use egui::{Id, PointerButton, Response, Ui};
+
+pub(crate) fn widget_id(app: &WordApp) -> Id {
+    app.session.managed_binding.map_or_else(
+        || Id::new("wordcraft_canvas"),
+        |binding| Id::new(("wordcraft_canvas", binding, app.session.document_id())),
+    )
+}
+fn cancelled(ui: &Ui) -> bool {
+    ui.input(|input| {
+        let mut first = None;
+        let multiple_starts = input.events.iter().any(|event| {
+            if let egui::Event::Touch {
+                device_id,
+                id,
+                phase: egui::TouchPhase::Start,
+                ..
+            } = event
+            {
+                let key = (*device_id, *id);
+                let previous = first.replace(key);
+                previous.is_some_and(|previous| previous != key)
+            } else {
+                false
+            }
+        });
+        !input.focused
+            || multiple_starts
+            || input.multi_touch().is_some()
+            || input.events.iter().any(|event| {
+                matches!(
+                    event,
+                    egui::Event::Touch {
+                        phase: egui::TouchPhase::Cancel,
+                        ..
+                    }
+                )
+            })
+            || (input
+                .events
+                .iter()
+                .any(|event| matches!(event, egui::Event::PointerGone))
+                && !input.pointer.primary_released())
+    })
+}
+pub(crate) fn contact(app: &WordApp, ui: &Ui, response: &Response) {
+    if app.session.managed_binding.is_none() {
+        return;
+    }
+    let key = response.id.with("managed-text-contact");
+    if cancelled(ui) || !ui.is_enabled() || app.session.managed_frozen {
+        ui.data_mut(|data| data.remove::<Option<Id>>(key));
+    } else if response.is_pointer_button_down_on()
+        && ui.input(|input| input.pointer.primary_pressed())
+    {
+        ui.data_mut(|data| data.insert_temp(key, Some(widget_id(app))));
+    }
+}
+pub(crate) fn publish(app: &mut WordApp, ui: &Ui, response: &Response) {
+    if app.session.managed_binding.is_none() || !ui.input(|input| input.pointer.primary_released())
+    {
+        return;
+    }
+    let armed = ui
+        .data_mut(|data| data.remove_temp::<Option<Id>>(response.id.with("managed-text-contact")))
+        .flatten();
+    let owner = widget_id(app);
+    if armed != Some(owner)
+        || response.id != owner
+        || !response.has_focus()
+        || app.session.managed_frozen
+        || !ui.is_enabled()
+        || cancelled(ui)
+        || response.dragged()
+        || !response.clicked_by(PointerButton::Primary)
+        || !ui.input(|input| input.pointer.button_clicked(PointerButton::Primary))
+        || app.session.sel.focus.story != wordcraft_doc::StoryRef::Body
+    {
+        return;
+    }
+    let Some(at) = response.interact_pointer_pos() else {
+        return;
+    };
+    if crate::canvas::pos_from_screen(app, at).is_none() {
+        return;
+    }
+    // Recompute only after the actual upstream mouse/selection and focus logic.
+    // The earlier painted IME output can still describe the preceding caret.
+    let Some((at, height)) = crate::canvas::caret_screen(app) else {
+        return;
+    };
+    if !at.x.is_finite() || !at.y.is_finite() || !height.is_finite() || height <= 0.0 {
+        return;
+    }
+    let caret = egui::Rect::from_min_size(at, egui::vec2(1.0, height));
+    if !app
+        .canvas
+        .viewport
+        .is_some_and(|viewport| viewport.intersects(caret))
+    {
+        return;
+    }
+    let global = ui
+        .ctx()
+        .layer_transform_to_global(ui.layer_id())
+        .unwrap_or_default();
+    let interrupt = ui.ctx().output(|out| {
+        out.ime
+            .as_ref()
+            .is_some_and(|ime| ime.should_interrupt_composition)
+    });
+    ui.output_mut(|output| {
+        output.ime = Some(egui::output::IMEOutput {
+            rect: global * caret,
+            cursor_rect: global * caret,
+            purpose: egui::IMEPurpose::Normal,
+            should_interrupt_composition: interrupt,
+        })
+    });
+    ui.data_mut(|data| {
+        data.insert_temp(
+            Id::new("eframe.text_input_activation"),
+            Some((ui.ctx().cumulative_frame_nr(), owner)),
+        )
+    });
+}
