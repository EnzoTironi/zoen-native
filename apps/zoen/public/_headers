# Keep the MLS signing worker isolated throughout the application.
# Preserve exact app/worker bytes instead of automatic edge script injection.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Pages merges overlapping values. Detach before attaching the exact OAuth policy.
# Only the canonical sign-in entry and its explicitly redirected aliases relax isolation.
/sign-in
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: unsafe-none

/sign-in/
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: unsafe-none

/sign-in.html
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: unsafe-none
