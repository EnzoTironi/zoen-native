{
  "name": "@zoen/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start --dev-client",
    "ios": "node ../../scripts/build-expo-core.mjs ios --simulator && expo run:ios",
    "ios:device": "node ../../scripts/build-expo-core.mjs ios && expo run:ios --device",
    "ios:release": "node ../../scripts/build-expo-core.mjs ios --release && expo run:ios --configuration Release",
    "android": "node ../../scripts/build-expo-core.mjs android && expo run:android",
    "android:release": "node ../../scripts/build-expo-core.mjs android --release && expo run:android --variant release",
    "web": "node ../../scripts/build-expo-web-core.mjs && expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --import ./src/i18n/test-setup.ts --test --test-concurrency=1 src/core/*.test.ts src/documents/*.test.ts src/miniapps/*.test.ts src/auth/*.test.ts",
    "core:types": "node ../../scripts/build-expo-core.mjs types",
    "export:web": "node ../../scripts/build-expo-web-core.mjs --release && expo export --platform web",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@noble/hashes": "^2.4.0",
    "@shopify/flash-list": "2.3.2",
    "emoji-regex": "^11.0.0",
    "esbuild": "^0.28.2",
    "expo": "~58.0.16",
    "expo-app-intents": "~0.5.10",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-camera": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-contacts": "~58.0.8",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.20",
    "i18n-js": "4.5.4",
    "lossless-json": "^4.3.2",
    "make-plural": "7.5.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "react-native-enriched-markdown@1.1.1": true,
    "unrs-resolver@1.12.2": true
  }
}
