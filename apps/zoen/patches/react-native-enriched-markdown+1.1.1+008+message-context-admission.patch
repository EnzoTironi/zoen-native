+// The ancestor message context may own only non-interactive rendered body.
+// Use the renderer's own TextKit hit testing so links/code/spoilers keep their input.
+#if !TARGET_OS_OSX
+- (NSNumber *)zoenMessageContextBodyAtPoint:(NSValue *)value
+{
+  if (![value isKindOfClass:[NSValue class]] || strcmp(value.objCType, @encode(CGPoint)) != 0 ||
+      !_textView || _textView.editable || _textView.selectable || _textView.hidden) {
+    return @NO;
+  }
+  CGPoint point = value.CGPointValue;
+  if (!CGRectContainsPoint(self.bounds, point))
+    return @NO;
+  CGPoint textPoint = [self convertPoint:point toView:_textView];
+  if (!CGRectContainsPoint(_textView.bounds, textPoint))
+    return @NO;
+  return @(!isPointOnInteractiveElement(_textView, textPoint, YES, YES));
+}
+#endif
