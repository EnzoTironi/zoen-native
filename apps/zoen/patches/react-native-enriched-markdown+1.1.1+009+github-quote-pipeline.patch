diff --git a/node_modules/react-native-enriched-markdown/ios/utils/ENRMMessageContextAdmission.h b/node_modules/react-native-enriched-markdown/ios/utils/ENRMMessageContextAdmission.h
new file mode 100644
index 0000000..f063fe3
--- /dev/null
+++ b/node_modules/react-native-enriched-markdown/ios/utils/ENRMMessageContextAdmission.h
@@ -0,0 +1,22 @@
+#pragma once
+#import "ENRMUIKit.h"
+#import "LinkTapUtils.h"
+
+#if !TARGET_OS_OSX
+// Shared by the single and segmented renderers. The renderer's own native text
+// and interactive-point classifier remain the authority, including custom links.
+static inline NSNumber *ENRMMessageContextBodyAtPoint(UIView *renderer, UITextView *text, NSValue *value)
+{
+  if (![value isKindOfClass:[NSValue class]] || strcmp(value.objCType, @encode(CGPoint)) != 0 ||
+      !text || text.editable || text.selectable || text.hidden) {
+    return @NO;
+  }
+  CGPoint point = value.CGPointValue;
+  if (!CGRectContainsPoint(renderer.bounds, point))
+    return @NO;
+  CGPoint textPoint = [renderer convertPoint:point toView:text];
+  if (!CGRectContainsPoint(text.bounds, textPoint))
+    return @NO;
+  return @(!isPointOnInteractiveElement(text, textPoint, YES, YES));
+}
+#endif
