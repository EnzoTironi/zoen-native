+// Emit only after the matching AST has committed. Recycling/prop changes and
+// partial streaming renders cannot publish a receipt for another source.
+- (void)emitResolvedAccessibilityText:(NSString *)text markdown:(NSString *)markdown revision:(NSString *)revision
+{
+  if (!_eventEmitter || !revision.length || ![revision isEqualToString:_accessibilityRevision] ||
+      ![markdown isEqualToString:_cachedMarkdown] || ![markdown isEqualToString:_renderedMarkdown]) return;
+  const auto emitter = std::static_pointer_cast<const EnrichedMarkdownEventEmitter>(_eventEmitter);
+  emitter->onResolvedAccessibilityText({.revision = std::string(revision.UTF8String ?: ""),
+    .markdown = std::string(markdown.UTF8String ?: ""), .text = std::string(text.UTF8String ?: "")});
+}
