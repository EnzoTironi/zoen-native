+- (void)composerRestore:(NSString *)markdown selection:(NSRange)selection binding:(NSString *)binding
+{
+  if (![_composer.binding isEqual:binding] || ![self draftMayMutate]) return;
+  [self performComposerFormatting:^{
+    [self importMarkdown:markdown];
+    NSUInteger length = ENRMGetPlainText(self->_textView).length;
+    self->_textView.selectedRange = NSMakeRange(MIN(selection.location, length),
+      MIN(selection.length, length - MIN(selection.location, length)));
+    [self->_inputEventEmitter emitFormattingChanged];
+    [self->_inputEventEmitter emitOnChangeSelection];
+    [self requestHeightUpdate];
+  }];
+}
+- (void)composerMutationDidEnd
+{
+  if (_draftRestoring) return;
+  BOOL composing = NO;
+#if !TARGET_OS_OSX
+  composing = _textView.markedTextRange != nil;
+#endif
+  __weak EnrichedMarkdownTextInput *weakSelf = self;
+  [_composer endUndoWithMarkdown:[self currentMarkdown] composing:composing
+    restore:^(NSString *markdown, NSRange selection, NSString *binding) {
+      [weakSelf composerRestore:markdown selection:selection binding:binding];
+    }];
+}
+- (void)performComposerFormatting:(dispatch_block_t)mutation
+{
+  if (![self draftMayMutate]) return;
+  [self composerMutationWillBegin];
+  @try { mutation(); } @finally { [self composerMutationDidEnd]; }
+}
