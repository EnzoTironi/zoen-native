+++ b/node_modules/@expo/ui/ios/Toggle/ZoenThemeInputProbe.swift
@@ -0,0 +1,21 @@
+// Temporary #440 diagnostic; opt-in testID, no gesture or control-state changes.
+import OSLog
+
+@MainActor
+internal enum ZoenThemeInputProbe {
+  enum Stage: String, CaseIterable {
+    case bindingSet = "native-binding-set"
+    case dispatchAttempt = "native-dispatch-attempt"
+    case dispatchReturned = "native-dispatch-returned"
+  }
+  private static var counts: [Stage: Int] = [:]
+  private static let logger = Logger(subsystem: "com.zoen.theme-input", category: "Automatic")
+
+  static func record(_ stage: Stage, testID: String?) {
+    guard testID == "zoen-theme-automatic-probe" else { return }
+    let count = (counts[stage] ?? 0) + 1
+    guard count <= 8 else { return }
+    counts[stage] = count
+    logger.notice("[ZoenThemeInput] \(stage.rawValue, privacy: .public) count=\(count, privacy: .public)")
+  }
+}
