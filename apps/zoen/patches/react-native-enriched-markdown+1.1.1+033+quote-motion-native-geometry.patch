+// An unchanged-source presentation update must participate in the mounting
+// transaction that measured its new height. Serialize with prior parser work,
+// invalidate stale applies, and commit before that transaction lays out views.
+- (void)renderSynchronously:(BOOL (^)(void))renderBlock apply:(dispatch_block_t)applyBlock
+{
+  if (_blockAsyncRender) return;
+  NSUInteger renderId = ++_currentRenderId;
+  __block BOOL rendered = NO;
+  dispatch_sync(_queue, ^{ rendered = renderBlock(); });
+  if (rendered && renderId == _currentRenderId) applyBlock();
+}
