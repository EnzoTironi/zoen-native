+// The layout engine supplies committed geometry, including interrupted spring
+// frames. This projection owns no timer, easing curve or second progress clock.
+CGFloat ENRMQuoteGeometryProgress(CGFloat current, CGFloat initial, CGFloat target) {
+  if (!isfinite(current) || !isfinite(initial) || !isfinite(target) || fabs(target - initial) < 0.5) return 1;
+  return (current - initial) / (target - initial);
+}
+CGRect ENRMQuoteGeometryFrame(CGRect initial, CGRect target, CGFloat progress) {
+  return CGRectMake(initial.origin.x + (target.origin.x - initial.origin.x) * progress,
+                    initial.origin.y + (target.origin.y - initial.origin.y) * progress,
+                    MAX(0, initial.size.width + (target.size.width - initial.size.width) * progress),
+                    MAX(0, initial.size.height + (target.size.height - initial.size.height) * progress));
+}
