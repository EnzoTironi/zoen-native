@@ -0,0 +1,65 @@
+#import "ENRMQuotePresentation.h"
+#import "MarkdownASTNode.h"
+#import <TargetConditionals.h>
+#import <math.h>
+#if TARGET_OS_OSX
+#import <AppKit/AppKit.h>
+#else
+#import <UIKit/UIKit.h>
+#endif
+
+static void ENRMConfigureQuotes(MarkdownASTNode *node, BOOL enabled, NSSet<NSNumber *> *expanded,
+                               BOOL insideQuote, NSInteger *nextIndex) {
+  BOOL quote = node.type == MarkdownNodeTypeBlockquote;
+  if (quote) {
+    NSInteger index = (*nextIndex)++;
+    BOOL prose = node.children.count > 0;
+    for (MarkdownASTNode *child in node.children)
+      if (child.type != MarkdownNodeTypeParagraph && child.type != MarkdownNodeTypeBlankLine) prose = NO;
+    if (enabled && !insideQuote && prose) {
+      node.attributes[@"enrmQuoteIndex"] = @(index).stringValue;
+      node.attributes[@"enrmQuoteExpanded"] = [expanded containsObject:@(index)] ? @"1" : @"0";
+    } else {
+      [node.attributes removeObjectForKey:@"enrmQuoteIndex"];
+      [node.attributes removeObjectForKey:@"enrmQuoteExpanded"];
+    }
+  }
+  for (MarkdownASTNode *child in node.children)
+    ENRMConfigureQuotes(child, enabled, expanded, insideQuote || quote, nextIndex);
+}
+
+void ENRMConfigureQuoteNodes(MarkdownASTNode *root, BOOL enabled, NSSet<NSNumber *> *expanded) {
+  NSInteger index = 0;
+  ENRMConfigureQuotes(root, enabled, expanded, NO, &index);
+}
+
+CGFloat ENRMQuotePreviewHeight(NSAttributedString *text, CGFloat width, CGFloat scale) {
+  if (!text.length || width <= 0) return 0;
+#if TARGET_OS_OSX
+  NSTextContainer *container = [[NSTextContainer alloc] initWithContainerSize:NSMakeSize(width, CGFLOAT_MAX)];
+#else
+  NSTextContainer *container = [[NSTextContainer alloc] initWithSize:CGSizeMake(width, CGFLOAT_MAX)];
+#endif
+  container.lineFragmentPadding = 0;
+  NSLayoutManager *layout = [NSLayoutManager new];
+  layout.allowsNonContiguousLayout = NO;
+  layout.usesFontLeading = NO;
+  [layout addTextContainer:container];
+  NSTextStorage *storage = [[NSTextStorage alloc] initWithAttributedString:text];
+  [storage addLayoutManager:layout];
+  [layout ensureLayoutForTextContainer:container];
+  __block NSUInteger lines = 0;
+  __block CGFloat bottom = 0;
+  [layout enumerateLineFragmentsForGlyphRange:NSMakeRange(0, layout.numberOfGlyphs)
+    usingBlock:^(CGRect rect, CGRect used, NSTextContainer *value, NSRange glyphs, BOOL *stop) {
+      lines++;
+      if (lines == 3) bottom = CGRectGetMaxY(rect);
+      if (lines > 3) *stop = YES;
+    }];
+  return lines > 3 ? ceil(bottom * MAX(scale, 1)) / MAX(scale, 1) : 0;
+}
+
+CGFloat ENRMQuoteRestoreOffset(CGFloat offset, CGFloat currentY, CGFloat targetY, CGFloat minimum, CGFloat maximum) {
+  if (!isfinite(currentY) || !isfinite(targetY)) return offset;
+  return MIN(maximum, MAX(minimum, offset + currentY - targetY));
+}
