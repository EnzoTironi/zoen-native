+
+// Presentation metadata only. The AST's content, attributes used by Markdown
+// serialization, source maps and copy/selection text remain untouched.
+void ENRMConfigureQuoteNodes(MarkdownASTNode *root, BOOL enabled, NSSet<NSNumber *> *expanded);
+CGFloat ENRMQuotePreviewHeight(NSAttributedString *text, CGFloat width, CGFloat scale);
+CGFloat ENRMQuoteRestoreOffset(CGFloat offset, CGFloat currentY, CGFloat targetY, CGFloat minimum, CGFloat maximum);
+#ifdef __cplusplus
+}
+#endif
+
+#ifdef __cplusplus
+template <typename Config> static inline void ENRMApplyQuotePresentation(MarkdownASTNode *root, const Config &config) {
+  NSMutableSet<NSNumber *> *expanded = [NSMutableSet new];
+  for (auto index : config.expanded) if (index >= 0) [expanded addObject:@(index)];
+  ENRMConfigureQuoteNodes(root, config.enabled, expanded);
+}
+#endif
diff --git a/node_modules/react-native-enriched-markdown/ios/utils/ENRMQuotePresentation.mm b/node_modules/react-native-enriched-markdown/ios/utils/ENRMQuotePresentation.mm
