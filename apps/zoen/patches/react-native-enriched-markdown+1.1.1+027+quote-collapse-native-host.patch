@@ -0,0 +1,81 @@
+#import "ENRMQuoteReadingAnchor.h"
+#import "ENRMQuotePresentation.h"
+#if !TARGET_OS_OSX
+static char ENRMQuoteAnchorObservation;
+@implementation ENRMQuoteReadingAnchor {
+  __weak UIScrollView *_scroll;
+  __weak UIWindow *_window;
+  __weak UIView *_button;
+  __weak id _focus;
+  CGFloat _screenY;
+  BOOL _observing, _adjusting, _scheduled, _announced;
+}
+- (BOOL)capture:(UIView *)button index:(NSInteger)index generation:(NSInteger)generation {
+  [self cancel];
+  UIView *parent = button.superview;
+  while (parent && ![parent isKindOfClass:UIScrollView.class]) parent = parent.superview;
+  UIScrollView *scroll = (UIScrollView *)parent;
+  if (!button.window || !scroll || scroll.dragging || scroll.decelerating) return NO;
+  _scroll = scroll; _window = button.window; _index = index; _generation = generation;
+  _screenY = [button convertPoint:CGPointMake(CGRectGetMidX(button.bounds), CGRectGetMinY(button.bounds)) toView:_window].y;
+  // FlashList can commit its content size after the text view's own layout.
+  // Follow that real commit; any subsequent external scroll retires this intent.
+  [scroll addObserver:self forKeyPath:@"contentSize" options:NSKeyValueObservingOptionNew context:&ENRMQuoteAnchorObservation];
+  [scroll addObserver:self forKeyPath:@"contentOffset" options:NSKeyValueObservingOptionOld | NSKeyValueObservingOptionNew context:&ENRMQuoteAnchorObservation];
+  _observing = YES;
+  return YES;
+}
+- (void)restore:(UIView *)button focus:(id)focus generation:(NSInteger)generation {
+  if (generation != _generation) { [self cancel]; return; }
+  _button = button;
+  _focus = focus;
+  [self applyAnchor];
+}
+- (void)applyAnchor {
+  UIScrollView *scroll = _scroll;
+  UIView *button = _button;
+  if (!scroll || !_window || button.window != _window || scroll.window != _window ||
+      ![button isDescendantOfView:scroll] || scroll.dragging || scroll.decelerating) { [self cancel]; return; }
+  CGFloat y = [button convertPoint:CGPointMake(CGRectGetMidX(button.bounds), CGRectGetMinY(button.bounds)) toView:_window].y;
+  CGFloat minimum = -scroll.adjustedContentInset.top;
+  CGFloat maximum = MAX(minimum, scroll.contentSize.height - scroll.bounds.size.height + scroll.adjustedContentInset.bottom);
+  CGPoint offset = scroll.contentOffset;
+  offset.y = ENRMQuoteRestoreOffset(offset.y, y, _screenY, minimum, maximum);
+  _adjusting = YES;
+  [scroll setContentOffset:offset animated:NO];
+  _adjusting = NO;
+  if (!_announced) {
+    _announced = YES;
+    UIAccessibilityPostNotification(UIAccessibilityLayoutChangedNotification, _focus);
+  }
+}
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object change:(NSDictionary<NSKeyValueChangeKey,id> *)change context:(void *)context {
+  if (context != &ENRMQuoteAnchorObservation) { [super observeValueForKeyPath:keyPath ofObject:object change:change context:context]; return; }
+  if (object != _scroll || _adjusting) return;
+  if ([keyPath isEqualToString:@"contentOffset"]) {
+    if (!CGPointEqualToPoint([change[NSKeyValueChangeOldKey] CGPointValue], [change[NSKeyValueChangeNewKey] CGPointValue])) [self cancel];
+    return;
+  }
+  if (_scheduled || !_button) return;
+  _scheduled = YES;
+  NSUInteger sequence = _sequence;
+  __weak ENRMQuoteReadingAnchor *weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    ENRMQuoteReadingAnchor *anchor = weakSelf;
+    if (!anchor || sequence != anchor->_sequence) return;
+    anchor->_scheduled = NO;
+    [anchor applyAnchor];
+  });
+}
+- (void)cancel {
+  _sequence++;
+  if (_observing && _scroll) {
+    [_scroll removeObserver:self forKeyPath:@"contentSize" context:&ENRMQuoteAnchorObservation];
+    [_scroll removeObserver:self forKeyPath:@"contentOffset" context:&ENRMQuoteAnchorObservation];
+  }
+  _observing = NO; _scheduled = NO; _announced = NO;
+  _scroll = nil; _window = nil; _button = nil; _focus = nil; _index = NSNotFound; _generation = -1;
+}
+- (void)dealloc { [self cancel]; }
+@end
+#endif
