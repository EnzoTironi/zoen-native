+  if(error)*error=ENRMDraftError(ENRMDraftSnapshotInvalid);return nil;
+}
++ (instancetype)modelFromValue:(NSDictionary *)value error:(NSError **)error
+{
+  NSData *data=[NSJSONSerialization dataWithJSONObject:value options:0 error:error];
+  if(!data || ![self decode:data error:error])return nil;
+  NSMutableArray *stored=[NSMutableArray array],*detected=[NSMutableArray array],*blocks=[NSMutableArray array];
+  for(NSDictionary *r in value[@"inline"]){
+    NSRange range=NSMakeRange([r[@"start"] unsignedIntegerValue],[r[@"end"] unsignedIntegerValue]-[r[@"start"] unsignedIntegerValue]);
+    ENRMFormattingRange *copy=[ENRMFormattingRange rangeWithType:(ENRMInputStyleType)[styles() indexOfObject:r[@"type"]]
+      range:range url:r[@"url"]==NSNull.null ? nil : r[@"url"]];
+    [([r[@"origin"] isEqual:@"stored"] ? stored : detected) addObject:copy];
+  }
+  for(NSDictionary *r in value[@"blocks"]){
+    ENRMBlockRange *copy=[ENRMBlockRange rangeWithType:(ENRMInputBlockType)[r[@"type"] integerValue]
+      range:NSMakeRange([r[@"start"] unsignedIntegerValue],[r[@"end"] unsignedIntegerValue]-[r[@"start"] unsignedIntegerValue]) level:[r[@"level"] integerValue]];
+    copy.ordinal=[r[@"ordinal"] integerValue];[blocks addObject:copy];
+  }
+  return [[self alloc] initWithText:value[@"text"] ranges:stored detected:detected blocks:blocks];
+}
