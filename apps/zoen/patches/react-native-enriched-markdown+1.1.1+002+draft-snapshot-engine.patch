+static NSArray<NSString *> *styles(void)
+{
+  return @[@"strong", @"emphasis", @"underline", @"strikethrough", @"link", @"spoiler"];
+}
+static BOOL scalarBoundary(NSString *text, NSUInteger index)
+{
+  if (index > text.length) return NO;
+  return index == 0 || index == text.length ||
+    !(CFStringIsSurrogateHighCharacter([text characterAtIndex:index - 1]) &&
+      CFStringIsSurrogateLowCharacter([text characterAtIndex:index]));
+}
+static BOOL validRange(NSString *text, NSRange range)
+{
+  return range.location <= text.length && range.length <= text.length - range.location &&
+    scalarBoundary(text, range.location) && scalarBoundary(text, NSMaxRange(range));
+}
+static NSDictionary *wireRange(NSRange range)
+{
+  return @{@"start": @(range.location), @"end": @(NSMaxRange(range))};
+}
+static BOOL integer(id value, NSUInteger maximum)
+{
+  if (![value isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)value) == CFBooleanGetTypeID()) return NO;
+  double n = [value doubleValue];
+  return isfinite(n) && n >= 0 && n <= maximum && floor(n) == n;
+}
+static BOOL keys(NSDictionary *value, NSArray *expected)
+{
+  return [NSSet setWithArray:value.allKeys].count == expected.count &&
+    [[NSSet setWithArray:value.allKeys] isEqualToSet:[NSSet setWithArray:expected]];
+}
+static BOOL readRange(id value, NSString *text, NSRange *result)
+{
+  if (![value isKindOfClass:NSDictionary.class] || !keys(value,@[@"start",@"end"]) ||
+      !integer(value[@"start"],text.length) || !integer(value[@"end"],text.length)) return NO;
+  NSUInteger start = [value[@"start"] unsignedIntegerValue], end = [value[@"end"] unsignedIntegerValue];
+  if (end < start || !validRange(text,NSMakeRange(start,end-start))) return NO;
+  *result = NSMakeRange(start,end-start);
+  return YES;
+}
