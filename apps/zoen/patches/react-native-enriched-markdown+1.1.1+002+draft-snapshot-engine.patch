+      [sequence rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"0123456789"].invertedSet].location!=NSNotFound ||
+      (sequence.length>1 && [sequence hasPrefix:@"0"]) || (sequence.length==20 && [sequence compare:@"18446744073709551615" options:NSLiteralSearch]==NSOrderedDescending) ||
+      ![text dataUsingEncoding:NSUTF8StringEncoding allowLossyConversion:NO])goto invalid;
+    NSRange range;
+    if(!readRange(value[@"selection"],text,&range) || (value[@"composition"]!=NSNull.null && !readRange(value[@"composition"],text,&range)))goto invalid;
+    if(![value[@"inline"] isKindOfClass:NSArray.class] || [value[@"inline"] count]>8192 ||
+      ![value[@"blocks"] isKindOfClass:NSArray.class] || [value[@"blocks"] count]>8192)goto invalid;
+    for(id r in value[@"inline"]){
+      if(![r isKindOfClass:NSDictionary.class] || !keys(r,@[@"start",@"end",@"type",@"url",@"origin"]) ||
+        !readRange(@{@"start":r[@"start"],@"end":r[@"end"]},text,&range) || ![styles() containsObject:r[@"type"]] ||
+        ![@[@"stored",@"detected"] containsObject:r[@"origin"]] ||
+        (r[@"url"]!=NSNull.null && (![r[@"url"] isKindOfClass:NSString.class] || [r[@"url"] length]>8192)) ||
+        ([r[@"type"] isEqual:@"link"] ? r[@"url"]==NSNull.null : r[@"url"]!=NSNull.null) ||
+        ([r[@"origin"] isEqual:@"detected"] && ![r[@"type"] isEqual:@"link"]) ||
+        (r[@"url"]!=NSNull.null && ![r[@"url"] dataUsingEncoding:NSUTF8StringEncoding allowLossyConversion:NO]))goto invalid;
+    }
+    for(id r in value[@"blocks"]){
+      if(![r isKindOfClass:NSDictionary.class] || !keys(r,@[@"start",@"end",@"type",@"level",@"ordinal"]) ||
+        !readRange(@{@"start":r[@"start"],@"end":r[@"end"]},text,&range) ||
+        !integer(r[@"type"],8) || !integer(r[@"level"],6) || !integer(r[@"ordinal"],1000000) || [r[@"ordinal"] integerValue]<1)goto invalid;
+    }
