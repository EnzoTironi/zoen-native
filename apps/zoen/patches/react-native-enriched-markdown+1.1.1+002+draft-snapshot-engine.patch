+  for (NSUInteger i=0;i<styles().count;i++) {
+    if([add containsObject:@(i)])[adds addObject:styles()[i]];
+    if([remove containsObject:@(i)])[removals addObject:styles()[i]];
+  }
+  NSDictionary *value=@{@"schema":@"enrm-ios/1",@"sequence":[NSString stringWithFormat:@"%llu",(unsigned long long)sequence],
+    @"mode":@"rich",@"text":self.text,@"selection":wireRange(selection),
+    @"composition":composition.location==NSNotFound ? NSNull.null : wireRange(composition),
+    @"inline":inlineRanges,@"blocks":blockRanges,@"typing":@{@"add":adds,@"remove":removals}};
+  NSData *data=[NSJSONSerialization dataWithJSONObject:value options:NSJSONWritingSortedKeys error:error];
+  return data && [self.class decode:data error:error] ? data : nil;
+}
++ (NSDictionary *)decode:(NSData *)data error:(NSError **)error
+{
