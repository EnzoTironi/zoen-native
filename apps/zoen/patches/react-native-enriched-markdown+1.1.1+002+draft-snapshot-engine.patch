+- (BOOL)replaceRange:(NSRange)range text:(NSString *)replacement preimage:(NSString *)preimage
+          pendingAdd:(NSSet *)add pendingRemove:(NSSet *)remove error:(NSError **)error
+{
+  if (![self.text isEqualToString:preimage] || !validRange(preimage,range) ||
+      ![replacement dataUsingEncoding:NSUTF8StringEncoding allowLossyConversion:NO]) {
+    if (error) *error = ENRMDraftError(ENRMDraftSnapshotUnexplainedMutation);
+    return NO;
+  }
+  NSRange paragraph = [preimage paragraphRangeForRange:NSMakeRange(range.location,0)];
+  ENRMBlockRange *block = [_blocks blockStartingAtLocation:paragraph.location];
+  BOOL hadNewline = [preimage rangeOfCharacterFromSet:NSCharacterSet.newlineCharacterSet options:0 range:range].location != NSNotFound;
+  BOOL wasEmpty = [[preimage substringWithRange:paragraph] stringByTrimmingCharactersInSet:NSCharacterSet.newlineCharacterSet].length == 0;
+  ENRMEditContext *context = [[ENRMEditContext alloc] initWithEditLocation:range.location deletedLength:range.length
+    insertedLength:replacement.length preEditReplacedNewline:hadNewline
+    preEditBlockType:block ? block.type : ENRMInputBlockTypeParagraph preEditBlockLevel:block ? block.level : 0
+    preEditParagraphWasEmpty:wasEmpty pendingStyles:add pendingStyleRemovals:remove];
+  [_storage replaceCharactersInRange:range withString:replacement];
+  [_pipeline processTextChangeWithContext:context];
+  [_detected adjustForEditAtLocation:range.location deletedLength:range.length insertedLength:replacement.length];
+  return YES;
+}
+- (NSData *)encodeSequence:(uint64_t)sequence selection:(NSRange)selection composition:(NSRange)composition
+                       add:(NSSet *)add remove:(NSSet *)remove error:(NSError **)error
+{
+  if (!validRange(self.text,selection) || (composition.location != NSNotFound && !validRange(self.text,composition))) {
+    if (error) *error = ENRMDraftError(ENRMDraftSnapshotInvalid); return nil;
+  }
