+      [value addEntriesFromDictionary:@{@"type":styles()[r.type],@"url":r.url ?: NSNull.null,@"origin":origin ? @"detected" : @"stored"}];
+      [inlineRanges addObject:value];
+    }
+  }
+  for (ENRMBlockRange *r in _blocks.allRanges) {
+    if (!validRange(self.text,r.range)) {if(error)*error=ENRMDraftError(ENRMDraftSnapshotInvalid);return nil;}
+    NSMutableDictionary *value=[wireRange(r.range) mutableCopy];
