+- (ENRMDraftSnapshotModel *)draftLiveModel
+{
+  NSArray *all = [_clipboardCoordinator allRangesIncludingTransient];
+  NSArray *stored = _formattingStore.allRanges;
+  NSMutableArray *detected = [NSMutableArray array];
+  for (ENRMFormattingRange *range in all) if (![stored containsObject:range]) [detected addObject:range];
+  return [[ENRMDraftSnapshotModel alloc] initWithText:ENRMGetPlainText(_textView)
+    ranges:stored detected:detected blocks:_blockStore.allRanges];
+}
+
+- (void)draftDidFail:(NSError *)error
+{
+  if (!_draftFailure) {
+    _draftFailure = error;
+    [_draftSink draftCheckpointFailed:error];
+  }
+  // Do not set editable=false or resign first responder here: UIKit could unmark
+  // the user's live composition. Subsequent native edits/format commands are refused.
+}
+
+- (BOOL)draftMayMutate
+{
+  return !_draftSealed && !_draftDiscardFrozen && !_draftBinding && (!_draftRequired || (_draftSink && !_draftFailure));
+}
+
+- (BOOL)bindDraftCheckpointToken:(NSString *)token error:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Draft binding must be on main");
+#if TARGET_OS_OSX
+  if (error) *error=ENRMDraftError(ENRMDraftSnapshotUnavailable); return NO;
+#else
+  if ([token isEqual:_draftToken] && _draftSink) { if(error)*error=_draftFailure;return _draftFailure==nil; }
+  _draftRequired = YES;
+  // Never drop pending bytes or reopen a sealed session through a props rebind.
+  // A new session requires revocation of the old token and a pre-focus boundary.
+  if (_draftNativeDepth || _draftSemanticDepth || _draftRestoring || _draftRetaining || _draftBinding ||
+      _draftPending || _textView.isFirstResponder || _editSession.isComposing ||
+      ((_draftSealed || _draftDiscardFrozen) && _draftToken)) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  BOOL wasSealed = _draftSealed;
+  BOOL wasDiscardFrozen = _draftDiscardFrozen;
+  [self unbindDraftCheckpoint];
+  id<ENRMDraftCheckpointSink> sink=[ENRMDraftCheckpointRegistry claimToken:token producer:self];
+  if (!sink) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
