+- (void)unbindDraftCheckpoint
+{
+  NSAssert(NSThread.isMainThread, @"Draft unbinding must be on main");
+  if(_draftToken)[ENRMDraftCheckpointRegistry releaseToken:_draftToken producer:self];
+  _draftToken=nil;_draftSink=nil;
