+- (BOOL)draftReconcileFinishedComposition:(NSError **)error
+{
+  if (!_draftCompositionPending || _editSession.isComposing) return YES;
+  if (!_draftModel || ![_draftModel.text isEqual:ENRMGetPlainText(_textView)]) {
+    if (error) *error = ENRMDraftError(ENRMDraftSnapshotUnexplainedMutation);
+    return NO;
+  }
+  // UIKit does not promise a fresh character callback from unmarkText. Replay has
+  // already consumed each exact storage primitive; commit those detached stores now.
+  [_formattingStore setRanges:[[NSArray alloc] initWithArray:_draftModel.formatting.allRanges copyItems:YES]];
+  [_blockStore setRanges:[[NSArray alloc] initWithArray:_draftModel.blocks.allRanges copyItems:YES]];
+  [_autoLinkDetector restoreDraftDetectedRanges:_draftModel.detected.allRanges];
+  _lastTextLength = _draftModel.text.length;
+  _lastSelectedRange = _textView.selectedRange;
+  _preEditSelectedRange = _textView.selectedRange;
+  _preEditBlockType = ENRMInputBlockTypeParagraph;
+  _preEditBlockLevel = 0;
+  _preEditParagraphWasEmpty = NO;
+  _preEditReplacedNewline = NO;
+  _draftCompositionPending = NO;
+  [self applyFormatting];
+  [self updatePlaceholderVisibility];
+  ENRMDraftSnapshotModel *live = [self draftLiveModel];
+  NSData *detached = [_draftModel encodeSequence:0 selection:NSMakeRange(0,0) composition:NSMakeRange(NSNotFound,0)
+    add:[NSSet set] remove:[NSSet set] error:error];
+  NSData *canonical = [live encodeSequence:0 selection:NSMakeRange(0,0) composition:NSMakeRange(NSNotFound,0)
+    add:[NSSet set] remove:[NSSet set] error:error];
+  if (!detached || ![detached isEqual:canonical]) {
+    if (error) *error = ENRMDraftError(ENRMDraftSnapshotUnexplainedMutation);
+    return NO;
+  }
+  _draftModel = live;
+  return YES;
+}
+
+- (NSData *)copyDraftSnapshotWithError:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Draft capture must be on main");
+#if TARGET_OS_OSX
+  if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return nil;
+#else
+  if(_draftFailure) {if(error)*error=_draftFailure;return nil;}
+  if (_draftBinding) {if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return nil;}
+  if (_draftSealed) {
+    if (!_draftSealedSnapshot && error) *error=ENRMDraftError(ENRMDraftSnapshotUnavailable);
+    return [_draftSealedSnapshot copy];
+  }
+  return [self draftCopyLiveSnapshotWithError:error];
+#endif
+}
+
+- (NSData *)draftCopyLiveSnapshotWithError:(NSError **)error
+{
+#if TARGET_OS_OSX
+  if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return nil;
+#else
+  if(!_draftModel) _draftModel=[self draftLiveModel];
+  if(![_draftModel.text isEqual:ENRMGetPlainText(_textView)]) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnexplainedMutation);return nil;
+  }
+  NSRange marked=NSMakeRange(NSNotFound,0);
+  UITextRange *nativeMarked=_textView.markedTextRange;
+  if(nativeMarked) {
+    NSInteger start=[_textView offsetFromPosition:_textView.beginningOfDocument toPosition:nativeMarked.start];
+    NSInteger end=[_textView offsetFromPosition:_textView.beginningOfDocument toPosition:nativeMarked.end];
+    if(start<0 || end<start){if(error)*error=ENRMDraftError(ENRMDraftSnapshotInvalid);return nil;}
