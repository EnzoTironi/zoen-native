+}
+
+- (BOOL)flushDraftSnapshotWithError:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Draft retention must be synchronous on main");
+  if (_draftRetaining || _draftBinding) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  if(!_draftRequired)return YES;
+  if(![self draftOwnsCheckpointToken])
+    return [self draftRejectSnapshot:ENRMDraftError(ENRMDraftSnapshotUnavailable) error:error];
+  NSError *failure=nil;
+  if(_draftPending) {
+    if (![self draftRetainPendingSnapshotWithError:&failure]) {if(error)*error=failure;return NO;}
+  } else if(_draftFailure) {return [self draftRejectSnapshot:_draftFailure error:error];}
+  NSData *snapshot=[self copyDraftSnapshotWithError:&failure];
+  if(!snapshot){return [self draftRejectSnapshot:failure ?: ENRMDraftError(ENRMDraftSnapshotInvalid) error:error];}
