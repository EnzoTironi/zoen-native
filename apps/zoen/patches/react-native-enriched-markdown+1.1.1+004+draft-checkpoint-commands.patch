+    if (![self draftReconcileFinishedComposition:error]) return nil;
+  } else if(_draftNativeDepth==0) {
+    _draftModel=[self draftLiveModel];
+  }
+  return [_draftModel encodeSequence:_draftSequence selection:_textView.selectedRange composition:marked
+    add:_typingController.pendingStyles remove:_typingController.pendingStyleRemovals error:error];
+#endif
+}
+
+- (BOOL)draftRejectSnapshot:(NSError *)failure error:(NSError **)error
+{
+  [self draftDidFail:failure];
+  if (error) *error = failure;
+  return NO;
+}
+
+- (BOOL)draftOwnsCheckpointToken
+{
+  return _draftRequired && _draftToken && _draftSink &&
+    [ENRMDraftCheckpointRegistry claimToken:_draftToken producer:self] == _draftSink;
+}
+
+- (BOOL)draftRetainPendingSnapshotWithError:(NSError **)error
+{
+  NSData *pending = _draftPending;
+  NSString *token = [_draftToken copy];
+  id<ENRMDraftCheckpointSink> sink = _draftSink;
+  NSError *failure = nil;
+  NSString *receipt = nil;
+  _draftRetaining = YES;
+  @try { receipt = [sink retainDraftSnapshot:pending sequence:_draftSequence error:&failure]; }
+  @finally { _draftRetaining = NO; }
+  // A callback may synchronously revoke this producer. Such a write cannot ACK
+  // the session which the application has already cancelled.
+  if (![_draftToken isEqual:token] || _draftSink != sink || ![self draftOwnsCheckpointToken])
+    return [self draftRejectSnapshot:ENRMDraftError(ENRMDraftSnapshotUnavailable) error:error];
+  if (!receipt || failure)
+    return [self draftRejectSnapshot:failure ?: ENRMDraftError(ENRMDraftSnapshotRetentionFailed) error:error];
+  _draftRetained=pending;_draftPending=nil;_draftFailure=nil;
+  return YES;
+}
+
+- (BOOL)freezeDraftInputForDiscardWithError:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Draft discard freeze must be synchronous on main");
+  if (_draftNativeDepth || _draftSemanticDepth || _draftRestoring || _draftRetaining || _draftBinding ||
+      ![self draftOwnsCheckpointToken]) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  // Discard needs an admission boundary even if serialization or a previous
+  // retention failed. Keep the actual UIKit state and pending bytes untouched.
+  _draftDiscardFrozen = YES;
+  if (![self draftOwnsCheckpointToken]) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  return YES;
+}
+
+- (BOOL)sealDraftSnapshotWithError:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Draft sealing must be synchronous on main");
+  // Marked text is allowed; an admitted mutation or sink callback still in flight
+  // is not a final boundary and must never produce a successful seal receipt.
+  if (_draftNativeDepth || _draftSemanticDepth || _draftRestoring || _draftRetaining || _draftBinding ||
+      ![self draftOwnsCheckpointToken]) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  _draftSealed = YES;
+  if (!_draftSealedSnapshot) {
+    if (_draftFailure && !_draftPending) { if(error)*error=_draftFailure;return NO; }
