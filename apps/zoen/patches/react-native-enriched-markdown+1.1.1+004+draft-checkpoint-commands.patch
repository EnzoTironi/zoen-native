+  // text primitive finishes before the package updates stored/block/detected
+  // semantics; that enclosing boundary adopts the completed model and retains.
+  if(_draftNativeDepth==0 && _draftSemanticDepth==0 && !_draftSealed && !_draftDiscardFrozen && !_draftBinding && !_draftFailure) {
+    NSError *failure=nil;
+    if(![self flushDraftSnapshotWithError:&failure]) [self draftDidFail:failure];
+  }
+}
