+- (BOOL)draftNativeMutationWillBegin
+{
+  if(![self draftMayMutate])return NO;
+  if(_draftRequired) {
+    if(_draftNativeDepth==0 && !_draftCompositionPending) _draftModel=[self draftLiveModel];
+    _draftNativeDepth++;
+  }
+  return YES;
+}
+
+- (void)draftNativeMutationDidEnd
+{
+  if(!_draftRequired)return;
+  if(_draftNativeDepth) _draftNativeDepth--;
