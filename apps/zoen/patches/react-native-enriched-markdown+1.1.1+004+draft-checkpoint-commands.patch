+- (BOOL)restoreDraftSnapshotData:(NSData *)snapshot error:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Draft restoration must precede focus on main");
+#if TARGET_OS_OSX
+  if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+#else
+  if(_draftSealed || _draftDiscardFrozen || _draftRetaining || _draftBinding || _textView.isFirstResponder || _editSession.isComposing ||
+     _draftNativeDepth || _draftSemanticDepth || _draftPending) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  NSDictionary *value=[ENRMDraftSnapshotModel decode:snapshot error:error];
