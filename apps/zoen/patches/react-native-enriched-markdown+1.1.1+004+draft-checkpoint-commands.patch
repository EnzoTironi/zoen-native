+    // A retryable rejected pending write does not invalidate the detached model.
+    NSData *snapshot = [self draftCopyLiveSnapshotWithError:&failure];
+    if (!snapshot) return [self draftRejectSnapshot:failure ?: ENRMDraftError(ENRMDraftSnapshotInvalid) error:error];
+    _draftSealedSnapshot = [snapshot copy];
+  }
