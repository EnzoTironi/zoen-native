+    if([sink respondsToSelector:@selector(initialDraftSnapshotWithError:)]) initial=[sink initialDraftSnapshotWithError:&failure];
+  } @finally { _draftBinding = NO; }
+  if (![_draftToken isEqual:token] || _draftSink != sink || ![self draftOwnsCheckpointToken]) {
+    _draftSealed = wasSealed;
+    _draftDiscardFrozen = wasDiscardFrozen;
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  _draftSealed = NO;
+  _draftDiscardFrozen = NO;
