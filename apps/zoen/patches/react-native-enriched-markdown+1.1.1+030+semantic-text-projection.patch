--- /dev/null
+++ b/node_modules/react-native-enriched-markdown/ios/utils/ENRMPlainTextProjection.mm
@@ -0,0 +1,15 @@
+#import "ENRMPlainTextProjection.h"
+#import "ENRMMarkdownParser.h"
+#import "MarkdownASTSerializer.h"
+
+NSString *ENRMProjectPlainText(NSString *markdown) {
+  if (![markdown canBeConvertedToEncoding:NSUTF8StringEncoding]) return nil;
+  ENRMMd4cFlags *flags = [ENRMMd4cFlags defaultFlags];
+  flags.hardSoftBreaks = YES;
+  flags.preserveBlankLines = YES;
+  flags.latexMath = NO;
+  flags.noMedia = YES;
+  ENRMMarkdownParser *parser = [ENRMMarkdownParser new];
+  MarkdownASTNode *root = [parser parseMarkdown:markdown flags:flags isGFM:YES];
+  return root ? plainTextFromASTNode(root) : nil;
+}
