+import { Platform } from 'react-native';
+
+/** iOS semantic text from the maintained GFM parser. No view, source mutation or cache. */
+export async function markdownToPlainText(markdown) {
+  if (Platform.OS !== 'ios') throw new Error('Native Markdown projection is unavailable.');
+  const native = require('./NativeEnrichedMarkdownProjection').default;
+  if (!native) throw new Error('Native Markdown projection is unavailable.');
+  return native.plainText(markdown);
+}
