diff --git a/node_modules/react-native-enriched-markdown/ios/utils/MarkdownASTSerializer.m b/node_modules/react-native-enriched-markdown/ios/utils/MarkdownASTSerializer.m
--- a/node_modules/react-native-enriched-markdown/ios/utils/MarkdownASTSerializer.m
+++ b/node_modules/react-native-enriched-markdown/ios/utils/MarkdownASTSerializer.m
@@ -359,3 +359,23 @@
   appendPlainText(node, buffer);
   return [[buffer copy] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
 }
+
+// Summary readers cannot reveal a visually hidden spoiler.
+static MarkdownASTNode *ENRMSummaryNode(MarkdownASTNode *node)
+{
+  MarkdownASTNode *summary = [[MarkdownASTNode alloc] initWithType:node.type];
+  if (node.type == MarkdownNodeTypeSpoiler) {
+    summary.type = MarkdownNodeTypeText;
+    summary.content = @"[Spoiler]";
+    return summary;
+  }
+  summary.content = node.content;
+  summary.attributes = [node.attributes mutableCopy];
+  for (MarkdownASTNode *child in node.children) [summary addChild:ENRMSummaryNode(child)];
+  return summary;
+}
+
+NSString *ENRMMessageSummaryText(MarkdownASTNode *node)
+{
+  return node ? plainTextFromASTNode(ENRMSummaryNode(node)) : @"";
+}
