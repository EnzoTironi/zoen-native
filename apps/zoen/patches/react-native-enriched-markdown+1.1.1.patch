+@implementation ENRMDraftCheckpointRegistry
++ (NSMutableDictionary<NSString *, ENRMDraftSinkEntry *> *)entries
+{
+  static NSMutableDictionary *entries;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{ entries = [NSMutableDictionary dictionary]; });
+  return entries;
+}
++ (NSString *)registerSink:(id<ENRMDraftCheckpointSink>)sink
+{
+  NSAssert(NSThread.isMainThread, @"Native input checkpoints require main-thread ownership");
+  NSString *token = NSUUID.UUID.UUIDString;
+  ENRMDraftSinkEntry *entry = [ENRMDraftSinkEntry new];
+  entry.sink = sink;
+  self.entries[token] = entry;
+  return token;
+}
++ (void)revokeToken:(NSString *)token
+{
+  NSAssert(NSThread.isMainThread, @"Native input checkpoints require main-thread ownership");
+  ENRMDraftSinkEntry *entry = self.entries[token];
+  [self.entries removeObjectForKey:token];
+  [entry.producer unbindDraftCheckpoint];
+}
++ (BOOL)flushToken:(NSString *)token error:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Native input checkpoints require main-thread ownership");
+  id<ENRMDraftSnapshotProducer> producer = self.entries[token].producer;
+  if (!producer) {
+    if (error) *error = ENRMDraftError(ENRMDraftSnapshotUnavailable);
+    return NO;
+  }
+  return [producer flushDraftSnapshotWithError:error];
+}
++ (BOOL)sealToken:(NSString *)token error:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Native input checkpoints require main-thread ownership");
+  // Do not claim a free token or substitute another view for the bound producer.
+  id<ENRMDraftSnapshotProducer> producer = self.entries[token].producer;
+  if (!producer) {
+    if (error) *error = ENRMDraftError(ENRMDraftSnapshotUnavailable);
+    return NO;
+  }
+  return [producer sealDraftSnapshotWithError:error];
+}
++ (id<ENRMDraftSnapshotProducer>)freezeForDiscardToken:(NSString *)token error:(NSError **)error
+{
+  NSAssert(NSThread.isMainThread, @"Native input discard freeze requires main-thread ownership");
+  ENRMDraftSinkEntry *entry = self.entries[token];
+  id<ENRMDraftSnapshotProducer> producer = entry.producer;
+  if (!producer) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return nil;
+  }
+  if (![producer freezeDraftInputForDiscardWithError:error]) return nil;
+  // Retain the exact object for the application's asynchronous durable discard.
+  // Neither a freed entry nor a replacement producer may acknowledge this token.
+  if (self.entries[token] != entry || entry.producer != producer) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return nil;
+  }
+  return producer;
+}
