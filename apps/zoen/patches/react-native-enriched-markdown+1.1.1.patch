+  BOOL wasDiscardFrozen = _draftDiscardFrozen;
+  [self unbindDraftCheckpoint];
+  id<ENRMDraftCheckpointSink> sink=[ENRMDraftCheckpointRegistry claimToken:token producer:self];
+  if (!sink) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return NO;
+  }
+  _draftToken=[token copy];_draftSink=sink;_draftFailure=nil;
+  _draftModel=[self draftLiveModel];
