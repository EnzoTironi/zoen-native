+  // Neither a freed entry nor a replacement producer may acknowledge this token.
+  if (self.entries[token] != entry || entry.producer != producer) {
+    if(error)*error=ENRMDraftError(ENRMDraftSnapshotUnavailable);return nil;
+  }
+  return producer;
+}
++ (id<ENRMDraftCheckpointSink>)claimToken:(NSString *)token producer:(id<ENRMDraftSnapshotProducer>)producer
+{
+  NSAssert(NSThread.isMainThread, @"Native input checkpoints require main-thread ownership");
+  ENRMDraftSinkEntry *entry = self.entries[token];
+  if (!entry || (entry.producer && entry.producer != producer)) return nil;
+  entry.producer = producer;
+  return entry.sink;
+}
++ (void)releaseToken:(NSString *)token producer:(id<ENRMDraftSnapshotProducer>)producer
+{
+  NSAssert(NSThread.isMainThread, @"Native input checkpoints require main-thread ownership");
+  ENRMDraftSinkEntry *entry = self.entries[token];
+  if (entry.producer == producer) entry.producer = nil;
