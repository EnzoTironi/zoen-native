+NSErrorDomain const ENRMDraftSnapshotErrorDomain = @"ENRMDraftSnapshot";
+NSError *ENRMDraftError(ENRMDraftSnapshotError code)
+{
+  return [NSError errorWithDomain:ENRMDraftSnapshotErrorDomain code:code
+                        userInfo:@{NSLocalizedDescriptionKey: @"The native editor checkpoint could not be retained."}];
+}
+
+@interface ENRMDraftSinkEntry : NSObject
+@property (nonatomic, strong) id<ENRMDraftCheckpointSink> sink;
+@property (nonatomic, weak) id<ENRMDraftSnapshotProducer> producer;
