+// Media-free parsing is a tree admission boundary, before either platform renderer.
+// Keep alt formatting and an explicit navigable URL; never retain a media node.
+static void replaceMediaWithLinks(MarkdownASTNode &node) {
+  for (auto &child : node.children) {
+    if (child) replaceMediaWithLinks(*child);
+  }
+  if (node.type != NodeType::Image && node.type != NodeType::Video) return;
+  const auto url = node.attributes.find("url");
+  const std::string target = url == node.attributes.end() ? std::string{} : url->second;
+  node.type = target.empty() ? NodeType::Text : NodeType::Link;
+  node.attributes.clear();
+  if (!target.empty()) node.setAttribute("url", target);
+  if (node.children.empty() && node.content.empty()) node.content = target;
+}
