+FOUNDATION_EXPORT NSErrorDomain const ENRMDraftSnapshotErrorDomain;
+typedef NS_ERROR_ENUM(ENRMDraftSnapshotErrorDomain, ENRMDraftSnapshotError) {
+  ENRMDraftSnapshotInvalid = 1,
+  ENRMDraftSnapshotUnexplainedMutation,
+  ENRMDraftSnapshotUnavailable,
+  ENRMDraftSnapshotRetentionFailed,
+};
+
+/// The application owns encryption/storage. All methods run synchronously on main.
+/// A nonnil receipt acknowledges this exact immutable byte payload, never a queued task.
+@protocol ENRMDraftCheckpointSink <NSObject>
+- (nullable NSString *)retainDraftSnapshot:(NSData *)snapshot
+                                  sequence:(uint64_t)sequence
+                                     error:(NSError *_Nullable *_Nullable)error;
+- (void)draftCheckpointFailed:(NSError *)error;
+@optional
+/// Already-authenticated recovery bytes, supplied synchronously before this producer can edit/focus.
+- (nullable NSData *)initialDraftSnapshotWithError:(NSError *_Nullable *_Nullable)error
+    __attribute__((swift_error(none)));
+@end
+
+@protocol ENRMDraftSnapshotProducer;
+
+/// No account identifiers or keys enter this library. A token binds one exact producer.
+@interface ENRMDraftCheckpointRegistry : NSObject
++ (NSString *)registerSink:(id<ENRMDraftCheckpointSink>)sink;
++ (void)revokeToken:(NSString *)token;
+/// Retain the bound producer's current input without sealing or changing IME/focus.
++ (BOOL)flushToken:(NSString *)token error:(NSError *_Nullable *_Nullable)error
+    NS_SWIFT_NAME(flush(token:));
+/// Seal the exact producer already bound to this token. Fails if no producer is bound.
+/// Success means its immutable final bytes have a synchronous receipt; keep the token
+/// registered until the application finishes applying/discarding those bytes.
++ (BOOL)sealToken:(NSString *)token error:(NSError *_Nullable *_Nullable)error
+    NS_SWIFT_NAME(seal(token:));
+/// Freeze admission for explicit discard without attempting capture or retention.
+/// Returns a strong handle to the exact already-bound producer. The application
+/// must keep it and its token until durable discard/release ACK, then revoke.
++ (nullable id<ENRMDraftSnapshotProducer>)freezeForDiscardToken:(NSString *)token
+    error:(NSError *_Nullable *_Nullable)error NS_SWIFT_NAME(freezeForDiscard(token:));
+@end
+
+@protocol ENRMDraftSnapshotProducer <NSObject>
+- (BOOL)bindDraftCheckpointToken:(NSString *)token error:(NSError *_Nullable *_Nullable)error;
+- (void)unbindDraftCheckpoint;
+/// Closed enrm-ios/1 JSON, at most 1 MiB, with copied semantic ranges (no archived attributes).
+- (nullable NSData *)copyDraftSnapshotWithError:(NSError *_Nullable *_Nullable)error;
+/// Restore before focus. Former IME characters become ordinary text; no candidate session is invented.
+- (BOOL)restoreDraftSnapshotData:(NSData *)snapshot error:(NSError *_Nullable *_Nullable)error;
+/// Explicit retry remains available after sealing; automatic retention stays closed.
+- (BOOL)flushDraftSnapshotWithError:(NSError *_Nullable *_Nullable)error;
+/// Close input and automatic events before synchronously retaining immutable final bytes.
+/// Keeps the live IME, responder, editable state and attributes untouched. A failed
+/// receipt keeps the producer sealed and the exact pending bytes available for retry.
+- (BOOL)sealDraftSnapshotWithError:(NSError *_Nullable *_Nullable)error
+    NS_SWIFT_NAME(sealDraftSnapshot());
+/// Closes mutation/automatic events only. Does not capture, repair a rejected
+/// checkpoint, call the sink, change editable/focus or unmark live composition.
+/// Explicit seal/flush remains available; the caller owns the durable tombstone.
+- (BOOL)freezeDraftInputForDiscardWithError:(NSError *_Nullable *_Nullable)error
+    NS_SWIFT_NAME(freezeDraftInputForDiscard());
+@end
+
+NS_ASSUME_NONNULL_END
