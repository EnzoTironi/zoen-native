+- (void)restoreDraftDetectedRanges:(NSArray<ENRMFormattingRange *> *)ranges
+{
+  NSTextStorage *storage = _textStorage;
+  if (storage.length) [storage removeAttribute:ENRMAutomaticLinkAttributeName range:NSMakeRange(0,storage.length)];
+  for (ENRMFormattingRange *range in ranges) {
+    if (range.url && range.type == ENRMInputStyleTypeLink && NSMaxRange(range.range) <= storage.length)
