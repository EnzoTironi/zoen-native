@@ -0,0 +1,72 @@
+#import "ENRMMarkdownSerializer.h"
+
+@implementation ENRMMarkdownSerializer (Composer)
++ (NSString *)serializeComposerText:(NSString *)text ranges:(NSArray<ENRMFormattingRange *> *)ranges
+                       blockRanges:(NSArray<ENRMBlockRange *> *)blocks
+{
+  NSMutableArray<NSDictionary *> *events = [NSMutableArray new];
+  NSMutableArray<ENRMFormattingRange *> *normalized=[NSMutableArray new];
+  for(ENRMFormattingRange *range in ranges) {
+    if(range.type!=ENRMInputStyleTypeCode || NSMaxRange(range.range)>text.length){[normalized addObject:range];continue;}
+    NSUInteger start=range.range.location,end=NSMaxRange(range.range);
+    for(NSUInteger i=start;i<=end;i++)if(i==end || [text characterAtIndex:i]=='\n' || [text characterAtIndex:i]=='\r') {
+      if(i>start)[normalized addObject:[ENRMFormattingRange rangeWithType:range.type range:NSMakeRange(start,i-start)]];
+      start=i+1;
+    }
+  }
+  for (ENRMFormattingRange *r in normalized) {
+    if (!r.range.length || r.range.location > text.length || r.range.length > text.length-r.range.location) continue;
+    NSString *open = @"", *close = @"";
+    NSUInteger start=r.range.location,end=NSMaxRange(r.range);
+    if (r.type == ENRMInputStyleTypeCode) {
+      NSString *body=[text substringWithRange:r.range];
+      NSUInteger longest=0,run=0;
+      for (NSUInteger i=0;i<body.length;i++) {run=[body characterAtIndex:i]=='`' ? run+1:0;longest=MAX(longest,run);}
+      NSString *fence=[@"" stringByPaddingToLength:longest+1 withString:@"`" startingAtIndex:0];
+      BOOL pad=[body hasPrefix:@"`"] || [body hasSuffix:@"`"] ||
+        ([body hasPrefix:@" "] && [body hasSuffix:@" "] && [body stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet].length);
+      open=pad ? [fence stringByAppendingString:@" "]:fence;
+      close=pad ? [@" " stringByAppendingString:fence]:fence;
+    } else {
+      switch (r.type) {
+        case ENRMInputStyleTypeStrong:open=close=@"**";break;
+        case ENRMInputStyleTypeEmphasis:open=close=@"*";break;
+        case ENRMInputStyleTypeStrikethrough:open=close=@"~~";break;
+        case ENRMInputStyleTypeSpoiler:open=close=@"||";break;
+        case ENRMInputStyleTypeLink:open=@"[";close=[NSString stringWithFormat:@"](%@)",r.url ?: @""];break;
+        case ENRMInputStyleTypeLiteralEscape:open=@"\\";break;
+        default:continue;
+      }
+    }
+    [events addObject:@{@"at":@(start),@"end":@NO,@"type":@(r.type),@"token":open}];
+    [events addObject:@{@"at":@(end),@"end":@YES,@"type":@(r.type),@"token":close}];
+  }
+  [events sortUsingComparator:^NSComparisonResult(NSDictionary *a,NSDictionary *b) {
+    NSComparisonResult order=[a[@"at"] compare:b[@"at"]];if(order)return order;
+    if(![a[@"end"] isEqual:b[@"end"]])return [a[@"end"] boolValue] ? NSOrderedAscending:NSOrderedDescending;
+    NSInteger first=[a[@"type"] integerValue],second=[b[@"type"] integerValue];
+    if([a[@"end"] boolValue]){NSInteger tmp=first;first=second;second=tmp;}
+    return first<second ? NSOrderedAscending:first>second ? NSOrderedDescending:NSOrderedSame;
+  }];
+  NSMutableString *output=[NSMutableString new];NSUInteger position=0;
+  for(NSDictionary *event in events){NSUInteger next=[event[@"at"] unsignedIntegerValue];
+    if(next>position)[output appendString:[text substringWithRange:NSMakeRange(position,next-position)]];
+    [output appendString:event[@"token"]];position=next;
+  }
+  [output appendString:[text substringFromIndex:position]];
+  // Delimiters add no newlines, so block line positions remain those of text.
+  NSMutableArray<NSString *> *lines=[[output componentsSeparatedByString:@"\n"] mutableCopy];
+  for(ENRMBlockRange *block in blocks){
+    if(block.range.location>text.length || block.range.length>text.length-block.range.location)continue;
+    NSUInteger first=[[text substringToIndex:block.range.location] componentsSeparatedByString:@"\n"].count-1;
+    NSUInteger count=[[text substringWithRange:block.range] componentsSeparatedByString:@"\n"].count;
+    NSString *prefix=@"";
+    if(block.type==ENRMInputBlockTypeQuote)prefix=@"> ";
+    else if(ENRMHeadingLevelForBlockType(block.type))prefix=[[@"" stringByPaddingToLength:ENRMHeadingLevelForBlockType(block.type) withString:@"#" startingAtIndex:0] stringByAppendingString:@" "];
+    else if(block.type==ENRMInputBlockTypeUnorderedListItem)prefix=@"- ";
+    else if(block.type==ENRMInputBlockTypeOrderedListItem)prefix=[NSString stringWithFormat:@"%ld. ",(long)MAX(1,block.ordinal)];
+    for(NSUInteger i=first;i<MIN(lines.count,first+count);i++)lines[i]=[prefix stringByAppendingString:lines[i]];
+  }
+  return [lines componentsJoinedByString:@"\n"];
+}
+@end
