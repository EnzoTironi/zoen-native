@@ -0,0 +1,3 @@
+#import <Foundation/Foundation.h>
+/// Empty string refuses any selected character lacking literal source provenance.
+FOUNDATION_EXPORT NSString *ENRMQuoteRanges(NSAttributedString *text, NSRange selected);
diff --git a/node_modules/react-native-enriched-markdown/ios/utils/ENRMQuoteRanges.m b/node_modules/react-native-enriched-markdown/ios/utils/ENRMQuoteRanges.m
new file mode 100644
index 0000000..d033bab
--- /dev/null
+++ b/node_modules/react-native-enriched-markdown/ios/utils/ENRMQuoteRanges.m
@@ -0,0 +1,32 @@
+#import "ENRMQuoteRanges.h"
+
+NSString *ENRMQuoteRanges(NSAttributedString *text, NSRange selected) {
+  if (selected.length == 0 || selected.length > 4096 || selected.location > text.length ||
+      selected.length > text.length - selected.location) return @"";
+  NSMutableArray *spans = [NSMutableArray new];
+  __block BOOL valid = YES;
+  __block NSUInteger previousEnd = 0;
+  [text enumerateAttribute:@"ENRMQuoteSource" inRange:selected options:0
+               usingBlock:^(id value, NSRange part, BOOL *stop) {
+    if (![value isKindOfClass:NSDictionary.class] || ![value[@"text"] isKindOfClass:NSString.class] ||
+        ![value[@"start"] isKindOfClass:NSNumber.class]) { valid = NO; *stop = YES; return; }
+    NSRange whole;
+    [text attribute:@"ENRMQuoteSource" atIndex:part.location longestEffectiveRange:&whole
+            inRange:NSMakeRange(0, text.length)];
+    NSString *sourceText = value[@"text"];
+    NSUInteger offset = part.location - whole.location;
+    NSUInteger start = [value[@"start"] unsignedIntegerValue] + offset;
+    NSUInteger end = start + part.length;
+    if (whole.length != sourceText.length || offset + part.length > sourceText.length ||
+        ![[sourceText substringWithRange:NSMakeRange(offset, part.length)]
+            isEqualToString:[text.string substringWithRange:part]] ||
+        (spans.count > 0 && start < previousEnd) || spans.count >= 128) {
+      valid = NO; *stop = YES; return;
+    }
+    [spans addObject:@{@"start_utf16": @(start), @"end_utf16": @(end)}];
+    previousEnd = end;
+  }];
+  if (!valid || spans.count == 0) return @"";
+  NSData *data = [NSJSONSerialization dataWithJSONObject:spans options:0 error:nil];
+  return data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : @"";
+}
