+#import "ENRMComposerAvailability.h"
+#import "ENRMComposerRanges.h"
+#import "ENRMFormattingStore.h"
+#import "ENRMBlockStore.h"
+#import "ENRMBlockEditCoordinator.h"
+#import "ENRMLinkCoordinator.h"
+#import "ENRMMarkdownSerializer.h"
+#import "ENRMInputParser.h"
+
+@interface ENRMComposerProbeLinks : NSObject <ENRMAutoLinkDetecting>
+@end
+@implementation ENRMComposerProbeLinks
+- (void)clearAutoLinkInRange:(NSRange)range {}
+@end
+
+static ENRMFormattingStore *ENRMComposerCopiedStore(NSArray<ENRMFormattingRange *> *ranges)
+{
+  ENRMFormattingStore *store = [ENRMFormattingStore new];
+  NSMutableArray *copies = [NSMutableArray new];
+  for (ENRMFormattingRange *range in ranges)
+    [copies addObject:[ENRMFormattingRange rangeWithType:range.type range:range.range url:range.url]];
+  [store setRanges:copies];
+  return store;
+}
+
+BOOL ENRMComposerCanToggle(NSString *text, NSArray<ENRMFormattingRange *> *ranges,
+  ENRMInputStyleType type, NSRange selection, NSString *linkURL)
+{
+  if (type > ENRMInputStyleTypeCode || !selection.length || selection.location > text.length ||
+      selection.length > text.length - selection.location || type == ENRMInputStyleTypeUnderline) return NO;
+  ENRMFormattingStore *store = ENRMComposerCopiedStore(ranges);
+  BOOL removed = NO;
+  if (type == ENRMInputStyleTypeLink) {
+    ENRMLinkCoordinator *links = [[ENRMLinkCoordinator alloc] initWithFormattingStore:store
+      autoLinkDetector:[ENRMComposerProbeLinks new]];
+    if (![links setLinkURL:linkURL ?: @"https://example.invalid" atCursor:selection.location selection:selection]) return NO;
+  } else {
+    removed = [store toggleStyle:type inRange:selection conflictingStyles:NSSet.set];
+  }
+  ENRMRetainComposerLiteralText(store, text, selection);
+  NSArray *proposed = ENRMCoalescedComposerRanges(text, store.allRanges);
+  NSString *selected = [text substringWithRange:selection];
+  if (!removed && type != ENRMInputStyleTypeCode &&
+      ![selected stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].length) return NO;
+  return ENRMRepresentableComposerInline(text, proposed) != nil;
+}
+
+static NSArray *ENRMComposerBlockCoverage(NSString *text, NSArray<ENRMBlockRange *> *blocks)
+{
+  NSMutableArray<NSMutableSet *> *coverage = [NSMutableArray new];
+  for (NSUInteger i = 0; i < text.length; i++) [coverage addObject:[NSMutableSet new]];
+  for (ENRMBlockRange *block in blocks) {
+    if (block.range.location > text.length || block.range.length > text.length - block.range.location) continue;
+    NSString *mark = [NSString stringWithFormat:@"%ld:%ld:%ld", (long)block.type, (long)block.level, (long)block.ordinal];
+    for (NSUInteger i = block.range.location; i < NSMaxRange(block.range); i++) {
+      unichar c = [text characterAtIndex:i];
+      if (c != '\n' && c != '\r') [coverage[i] addObject:mark];
+    }
+  }
+  return coverage;
+}
+
+BOOL ENRMComposerCanToggleBlock(NSString *text, NSArray<ENRMFormattingRange *> *ranges,
+  NSArray<ENRMBlockRange *> *blocks, ENRMInputBlockType type, NSInteger level, NSRange selection)
+{
+  if (selection.location > text.length || selection.length > text.length - selection.location) return NO;
+  ENRMBlockStore *store = [ENRMBlockStore new];
+  NSMutableArray *copies = [NSMutableArray new];
+  for (ENRMBlockRange *block in blocks) {
+    ENRMBlockRange *copy = [ENRMBlockRange rangeWithType:block.type range:block.range level:block.level];
+    copy.ordinal = block.ordinal;
+    [copies addObject:copy];
+  }
+  [store setRanges:copies];
+  ENRMBlockEditCoordinator *coordinator = [[ENRMBlockEditCoordinator alloc] initWithBlockStore:store];
+  [coordinator toggleBlockType:type level:level selectionRange:selection inText:text];
+  NSString *candidate = [ENRMMarkdownSerializer serializeComposerText:text ranges:ranges blockRanges:store.allRanges];
+  ENRMParseResult *parsed = [[ENRMInputParser new] parseComposerMarkdown:candidate];
+  return [parsed.plainText isEqualToString:text] &&
+    [ENRMComposerBlockCoverage(text, store.allRanges) isEqual:ENRMComposerBlockCoverage(text, parsed.blockRanges)];
+}
