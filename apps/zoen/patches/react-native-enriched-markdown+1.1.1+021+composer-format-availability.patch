+- (BOOL)composerIsComposing
+{
+  if (_editSession.isComposing) return YES;
+#if !TARGET_OS_OSX
+  return _textView.markedTextRange != nil;
+#else
+  return NO;
+#endif
+}
+- (BOOL)composerMenuMayAct
+{
+  if (![self isComposerRichInput] || ![self draftMayMutate] || !self.window || [self composerIsComposing]) return NO;
+#if !TARGET_OS_OSX
+  return _textView.isFirstResponder && !_textView.markedTextRange;
+#else
+  return _textView.window.firstResponder == _textView;
+#endif
+}
+- (BOOL)composerCanToggleStyle:(ENRMInputStyleType)type range:(NSRange)range
+{
+  return [self composerMenuMayAct] && ENRMComposerCanToggle(ENRMGetPlainText(_textView),
+    _formattingStore.allRanges, type, range, nil);
+}
+- (BOOL)composerCanToggleQuote:(NSRange)range
+{
+  return [self composerMenuMayAct] && ENRMComposerCanToggleBlock(ENRMGetPlainText(_textView),
+    _formattingStore.allRanges, _blockStore.allRanges, ENRMInputBlockTypeQuote, 1, range);
+}
+- (dispatch_block_t)composerMenuAction:(dispatch_block_t)work
+{
+  __weak EnrichedMarkdownTextInput *weakSelf = self;
+  if (!_composer.binding.length) {
+    // The article editor keeps its existing checkpoint admission, without a
+    // composer receipt. This capability cannot cross into a composer binding.
+    return [^{
+      EnrichedMarkdownTextInput *owner = weakSelf;
+      if (owner && !owner->_composer.binding.length) work();
+    } copy];
+  }
+  NSString *binding = _composer.binding;
+  uint64_t count = _composer.eventCount;
+  NSString *markdown = [self currentMarkdown];
+  NSRange selection = _textView.selectedRange;
+  return [^{
+    EnrichedMarkdownTextInput *owner = weakSelf;
+    if (!owner || ![owner composerMenuMayAct] || ![owner->_composer matches:binding eventCount:count] ||
+        ![[owner currentMarkdown] isEqualToString:markdown] ||
+        !NSEqualRanges(owner->_textView.selectedRange, selection)) return;
+    [owner performComposerFormatting:work];
+  } copy];
+}
