+#pragma once
+#import "ENRMFormattingRange.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+// Markdown cannot encode crossing strong/emphasis delimiter runs everywhere.
+// Keep their native model and serialized model identical; Code remains nested.
+NSArray<ENRMFormattingRange *> *ENRMNormalizeComposerRanges(NSString *text, NSArray<ENRMFormattingRange *> *ranges);
+@class ENRMFormattingStore;
+// Only an admitted raw replacement or Code removal introduces this provenance.
+// Imported opaque Markdown remains untouched and Code emits its raw payload.
+void ENRMRetainComposerLiteralText(ENRMFormattingStore *store, NSString *text, NSRange inserted);
+BOOL ENRMComposerHasCrossedEmphasis(NSArray<ENRMFormattingRange *> *ranges);
+NSString *ENRMEncodeComposerInline(NSString *text, NSArray<ENRMFormattingRange *> *ranges, NSInteger variant);
+NSString *_Nullable ENRMRepresentableComposerInline(NSString *text, NSArray<ENRMFormattingRange *> *ranges);
+NSArray<ENRMFormattingRange *> *ENRMCoalescedComposerRanges(NSString *text, NSArray<ENRMFormattingRange *> *ranges);
+
+NS_ASSUME_NONNULL_END
diff --git a/node_modules/react-native-enriched-markdown/ios/input/ENRMComposerRanges.mm b/node_modules/react-native-enriched-markdown/ios/input/ENRMComposerRanges.mm
