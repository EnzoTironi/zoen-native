+static NSInteger ENRMComposerPriority(ENRMInputStyleType type)
+{
+  switch (type) {
+    case ENRMInputStyleTypeLink: return 0;
+    case ENRMInputStyleTypeSpoiler: return 1;
+    case ENRMInputStyleTypeStrikethrough: return 2;
+    case ENRMInputStyleTypeStrong: return 3;
+    case ENRMInputStyleTypeEmphasis: return 4;
+    case ENRMInputStyleTypeCode: return 5;
+    case ENRMInputStyleTypeLiteralEscape: return 6;
+    default: return 7;
+  }
+}
+
+static BOOL ENRMSameComposerMark(ENRMFormattingRange *a, ENRMFormattingRange *b)
+{
+  return a.type == b.type &&
+    (a.type != ENRMInputStyleTypeLiteralEscape || NSEqualRanges(a.range, b.range)) &&
+    ((a.url == b.url) || [a.url isEqualToString:b.url]);
+}
+
+static NSString *ENRMComposerWrap(ENRMFormattingRange *mark, NSString *body,
+  NSUInteger start, NSUInteger end, NSInteger variant)
+{
+  switch (mark.type) {
+    case ENRMInputStyleTypeStrong: return [NSString stringWithFormat:@"**%@**", body];
+    case ENRMInputStyleTypeEmphasis: {
+      BOOL reopened = start > mark.range.location;
+      BOOL interrupted = end < NSMaxRange(mark.range);
+      BOOL alternate = ((variant & 1) && reopened) || ((variant & 2) && interrupted);
+      return [NSString stringWithFormat:alternate ? @"_%@_" : @"*%@*", body];
+    }
+    case ENRMInputStyleTypeStrikethrough: return [NSString stringWithFormat:@"~~%@~~", body];
+    case ENRMInputStyleTypeSpoiler: return [NSString stringWithFormat:@"||%@||", body];
+    case ENRMInputStyleTypeLink: return [NSString stringWithFormat:@"[%@](%@)", body, mark.url ?: @""];
+    case ENRMInputStyleTypeLiteralEscape: return [@"\\" stringByAppendingString:body];
+    case ENRMInputStyleTypeCode: {
+      NSUInteger longest = 0, run = 0;
+      for (NSUInteger i = 0; i < body.length; i++) {
+        run = [body characterAtIndex:i] == '`' ? run + 1 : 0;
+        longest = MAX(longest, run);
+      }
+      NSString *fence = [@"" stringByPaddingToLength:longest + 1 withString:@"`" startingAtIndex:0];
+      BOOL pad = [body hasPrefix:@"`"] || [body hasSuffix:@"`"] ||
+        ([body hasPrefix:@" "] && [body hasSuffix:@" "] &&
+         [body stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet].length);
+      return pad ? [NSString stringWithFormat:@"%@ %@ %@", fence, body, fence]
+                 : [NSString stringWithFormat:@"%@%@%@", fence, body, fence];
+    }
+    default: return body;
+  }
+}
+
+NSString *ENRMEncodeComposerInline(NSString *text, NSArray<ENRMFormattingRange *> *source, NSInteger variant)
+{
+  NSMutableArray<ENRMFormattingRange *> *ranges = [NSMutableArray new];
+  NSMutableIndexSet *boundaries = [NSMutableIndexSet indexSetWithIndex:0];
+  [boundaries addIndex:text.length];
+  for (ENRMFormattingRange *range in source) {
+    if (!range.range.length || range.range.location > text.length ||
+        range.range.length > text.length - range.range.location ||
+        ENRMComposerPriority(range.type) == 7) continue;
+    NSUInteger start = range.range.location, end = NSMaxRange(range.range);
+    for (NSUInteger i = start; i <= end; i++) {
+      BOOL lineBreak = i < end && ([text characterAtIndex:i] == '\n' || [text characterAtIndex:i] == '\r');
+      if (i != end && !(range.type == ENRMInputStyleTypeCode && lineBreak)) continue;
+      if (i > start) {
+        ENRMFormattingRange *part = [ENRMFormattingRange rangeWithType:range.type
+          range:NSMakeRange(start, i - start) url:range.url];
+        [ranges addObject:part];
+        [boundaries addIndex:start];
+        [boundaries addIndex:i];
+      }
+      start = i + 1;
+    }
+  }
+  [ranges sortUsingComparator:^NSComparisonResult(ENRMFormattingRange *a, ENRMFormattingRange *b) {
+    NSInteger x = ENRMComposerPriority(a.type), y = ENRMComposerPriority(b.type);
+    return x < y ? NSOrderedAscending : x > y ? NSOrderedDescending : NSOrderedSame;
+  }];
+  // Frames close and reopen at a crossing boundary. Code always contains raw
+  // characters; other marks wrap it instead of becoming literal code payload.
+  NSMutableArray<ENRMFormattingRange *> *active = [NSMutableArray new];
+  NSMutableArray<NSMutableString *> *frames = [NSMutableArray arrayWithObject:[NSMutableString new]];
+  NSMutableArray<NSNumber *> *starts = [NSMutableArray arrayWithObject:@0];
+  NSUInteger position = boundaries.firstIndex;
+  while (position != NSNotFound) {
+    NSUInteger next = [boundaries indexGreaterThanIndex:position];
+    NSMutableArray<ENRMFormattingRange *> *desired = [NSMutableArray new];
+    BOOL code = NO;
+    for (ENRMFormattingRange *range in ranges) {
+      if (position < range.range.location || position >= NSMaxRange(range.range)) continue;
+      if (range.type == ENRMInputStyleTypeCode) code = YES;
+      if (range.type == ENRMInputStyleTypeLiteralEscape && code) continue;
+      if (!desired.count ||
+          !ENRMSameComposerMark(desired.lastObject, range)) [desired addObject:range];
+    }
+    NSUInteger common = 0;
+    while (common < active.count && common < desired.count &&
+           ENRMSameComposerMark(active[common], desired[common])) common++;
+    while (active.count > common) {
+      NSString *body = frames.lastObject;
+      NSString *wrapped = ENRMComposerWrap(active.lastObject, body, starts.lastObject.unsignedIntegerValue, position, variant);
+      [starts removeLastObject];
+      [frames removeLastObject];
+      [active removeLastObject];
+      [frames.lastObject appendString:wrapped];
+    }
+    for (NSUInteger i = common; i < desired.count; i++) {
+      [active addObject:desired[i]];
+      [frames addObject:[NSMutableString new]];
+      [starts addObject:@(position)];
+    }
+    if (next != NSNotFound)
+      [frames.lastObject appendString:[text substringWithRange:NSMakeRange(position, next - position)]];
+    position = next;
+  }
+  return frames.firstObject;
+}
 
