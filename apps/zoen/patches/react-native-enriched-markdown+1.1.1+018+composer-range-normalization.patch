--- /dev/null
+++ b/node_modules/react-native-enriched-markdown/ios/input/ENRMComposerRanges.mm
@@ -0,0 +1,64 @@
+#import "ENRMComposerRanges.h"
+#import "ENRMFormattingStore.h"
+
+NSArray<ENRMFormattingRange *> *ENRMNormalizeComposerRanges(NSString *text, NSArray<ENRMFormattingRange *> *ranges)
+{
+  ranges = ENRMCoalescedComposerRanges(text, ranges);
+  if (!ENRMComposerHasCrossedEmphasis(ranges) || ENRMRepresentableComposerInline(text, ranges)) return ranges;
+  NSMutableArray<ENRMFormattingRange *> *result = [NSMutableArray new];
+  for (ENRMFormattingRange *range in ranges)
+    if (range.range.length <= NSUIntegerMax - range.range.location) [result addObject:[ENRMFormattingRange rangeWithType:range.type range:range.range url:range.url]];
+  for (ENRMFormattingRange *a in result) {
+    for (ENRMFormattingRange *b in result) {
+      BOOL ambiguous = (a.type == ENRMInputStyleTypeStrong && b.type == ENRMInputStyleTypeEmphasis) ||
+        (a.type == ENRMInputStyleTypeEmphasis && b.type == ENRMInputStyleTypeStrong);
+      if (ambiguous && a.range.location < b.range.location &&
+          b.range.location < NSMaxRange(a.range) && NSMaxRange(a.range) < NSMaxRange(b.range)) {
+        // Preserve both outside fragments and all characters. The later-starting
+        // mark owns only this otherwise unrepresentable crossing intersection.
+        a.range = NSMakeRange(a.range.location, b.range.location - a.range.location);
+      }
+    }
+  }
+  return ENRMCoalescedComposerRanges(text, result);
+}
+
+void ENRMRetainComposerLiteralText(ENRMFormattingStore *store, NSString *text, NSRange inserted)
+{
+  if (inserted.location > text.length || inserted.length > text.length - inserted.location) return;
+  NSMutableArray<ENRMFormattingRange *> *ranges = [store.allRanges mutableCopy];
+  for (NSUInteger i = inserted.location; i < NSMaxRange(inserted); i++) {
+    unichar c = [text characterAtIndex:i];
+    BOOL punctuation = (c >= 33 && c <= 47) || (c >= 58 && c <= 64) ||
+      (c >= 91 && c <= 96) || (c >= 123 && c <= 126);
+    if (punctuation && ![store rangeOfType:ENRMInputStyleTypeLiteralEscape containingPosition:i])
+      [ranges addObject:[ENRMFormattingRange rangeWithType:ENRMInputStyleTypeLiteralEscape
+        range:NSMakeRange(i, 1)]];
+  }
+  [store setRanges:ranges];
+}
+
+NSArray<ENRMFormattingRange *> *ENRMCoalescedComposerRanges(NSString *text, NSArray<ENRMFormattingRange *> *ranges)
+{
+  ENRMFormattingStore *marks = [ENRMFormattingStore new];
+  NSMutableArray<ENRMFormattingRange *> *result = [NSMutableArray new];
+  for (ENRMFormattingRange *range in ranges) {
+    if (range.range.location > text.length || range.range.length > text.length - range.range.location) continue;
+    ENRMFormattingRange *part = [ENRMFormattingRange rangeWithType:range.type range:range.range url:range.url];
+    BOOL delimiters = part.type == ENRMInputStyleTypeStrong || part.type == ENRMInputStyleTypeEmphasis ||
+      part.type == ENRMInputStyleTypeStrikethrough || part.type == ENRMInputStyleTypeSpoiler;
+    if (delimiters) {
+      NSUInteger start = part.range.location, end = NSMaxRange(part.range);
+      NSCharacterSet *space = NSCharacterSet.whitespaceAndNewlineCharacterSet;
+      while (start < end && [space characterIsMember:[text characterAtIndex:start]]) start++;
+      while (end > start && [space characterIsMember:[text characterAtIndex:end - 1]]) end--;
+      if (start == end) continue;
+      part.range = NSMakeRange(start, end - start);
+    }
+    if (part.type == ENRMInputStyleTypeStrong || part.type == ENRMInputStyleTypeEmphasis)
+      [marks addRange:part];
+    else [result addObject:part];
+  }
+  [result addObjectsFromArray:marks.allRanges];
+  return result;
+}
