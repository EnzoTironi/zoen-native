+#pragma once
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+// UI ownership and event acknowledgement only. Text/styles remain in the one
+// native editor; the application owns the canonical durable message draft.
+@interface ENRMComposerInputState : NSObject
+@property (nonatomic, readonly) NSString *binding;
+@property (nonatomic, readonly) uint64_t eventCount;
+@property (nonatomic, readonly) BOOL richText;
+@property (nonatomic, assign) BOOL enabled;
+@property (nonatomic, readonly) NSUInteger undoDepth;
+- (void)beginUndoInManager:(NSUndoManager *)manager markdown:(NSString *)markdown selection:(NSRange)selection;
+- (void)endUndoWithMarkdown:(NSString *)markdown composing:(BOOL)composing
+                   restore:(void (^)(NSString *markdown, NSRange selection, NSString *binding))restore;
+- (BOOL)bind:(NSString *)binding richText:(BOOL)richText;
+- (BOOL)shouldApplyValue:(NSString *)value acknowledged:(double)ack current:(nullable NSString *)current force:(BOOL)force;
+- (nullable NSDictionary *)receiptForMarkdown:(NSString *)markdown;
+- (BOOL)matches:(NSString *)binding eventCount:(uint64_t)eventCount;
+@end
+NS_ASSUME_NONNULL_END
diff --git a/node_modules/react-native-enriched-markdown/ios/input/ENRMComposerInputState.m b/node_modules/react-native-enriched-markdown/ios/input/ENRMComposerInputState.m
