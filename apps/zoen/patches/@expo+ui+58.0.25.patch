@@ -0,0 +1,73 @@
+import Foundation
+
+/// Diagnostic state only. No UIKit state, input delivery or preference authority.
+struct ZoenThemeTouchState {
+  enum Phase { case ended, cancelled, valueChanged, controlCancelled }
+  private(set) var generation: UInt64 = 0
+  private(set) var armed = false
+  private(set) var used = false
+  private var touch: UInt64?
+  private var terminal = false
+  private var changed = false
+  private var controlCancelled = false
+  private var records = 0
+
+  mutating func arm(testID: String?) -> UInt64? {
+    guard testID == "zoen-theme-automatic-probe", !armed, !used, generation < UInt64.max else { return nil }
+    generation += 1
+    armed = true
+    return generation
+  }
+  mutating func begin(generation: UInt64, touch: UInt64) -> Bool {
+    guard current(generation), !used else { return false }
+    used = true
+    self.touch = touch
+    return record(generation)
+  }
+  mutating func phase(_ phase: Phase, generation: UInt64, touch: UInt64) -> Bool {
+    guard current(generation), self.touch == touch else { return false }
+    switch phase {
+    case .ended, .cancelled:
+      guard !terminal else { return false }
+      terminal = true
+    case .valueChanged:
+      guard !changed else { return false }
+      changed = true
+    case .controlCancelled:
+      guard !controlCancelled else { return false }
+      controlCancelled = true
+    }
+    return record(generation)
+  }
+  mutating func record(_ generation: UInt64) -> Bool {
+    guard current(generation), records < 8 else { return false }
+    records += 1
+    return true
+  }
+  func current(_ generation: UInt64) -> Bool { armed && self.generation == generation }
+  mutating func retire() {
+    armed = false
+    touch = nil
+    // A retired lifetime never rearms. A new Host creates a new probe instance.
+    used = true
+  }
+}
+
+/// Shared ceiling includes Binding and UIKit records for the one diagnostic run.
+struct ZoenThemeProbeBudget {
+  private(set) var count = 0
+  private var claimed = false
+  private var active = false
+  mutating func claim() -> Bool {
+    guard !claimed else { return false }
+    claimed = true
+    active = true
+    return true
+  }
+  mutating func stop() { active = false }
+  mutating func take() -> Int? {
+    guard active, count < 8 else { return nil }
+    count += 1
+    return count
+  }
+}
