+++ b/node_modules/@expo/ui/ios/Toggle/ZoenThemeTouchProbe.swift
@@ -0,0 +1,184 @@
+import SwiftUI
+import UIKit
+
+/// A noninteractive background view. It observes exactly one live, opt-in Switch.
+internal struct ZoenThemeTouchProbe: UIViewRepresentable {
+  func makeUIView(context: Context) -> ZoenThemeTouchProbeView { ZoenThemeTouchProbeView() }
+  func updateUIView(_ view: ZoenThemeTouchProbeView, context: Context) { view.scheduleBinding() }
+  static func dismantleUIView(_ view: ZoenThemeTouchProbeView, coordinator: ()) { view.retire() }
+}
+
+@MainActor internal final class ZoenThemeTouchProbeView: UIView {
+  private weak var control: UISwitch?
+  private weak var boundWindow: UIWindow?
+  private var recognizer: ZoenThemePassiveTouchRecognizer?
+  private var inactivity: NSObjectProtocol?
+  private var state = ZoenThemeTouchState()
+  private var bindingScheduled = false
+  private weak var capturedTouch: UITouch?
+  private var touchID: UInt64 = 0
+  private var ticket: UInt64 = 0
+
+  init() {
+    super.init(frame: .zero)
+    isUserInteractionEnabled = false
+    isAccessibilityElement = false
+    backgroundColor = .clear
+  }
+  required init?(coder: NSCoder) { return nil }
+
+  override func didMoveToWindow() {
+    super.didMoveToWindow()
+    if window == nil { retire() } else { scheduleBinding() }
+  }
+  override func willMove(toWindow next: UIWindow?) {
+    if window != nil, next !== window { retire() }
+    super.willMove(toWindow: next)
+  }
+  override func layoutSubviews() { super.layoutSubviews(); scheduleBinding() }
+
+  func scheduleBinding() {
+    guard !bindingScheduled, !state.used, !state.armed, window != nil else { return }
+    bindingScheduled = true
+    DispatchQueue.main.async { [weak self] in
+      guard let self else { return }
+      self.bindingScheduled = false
+      self.bind()
+    }
+  }
+  private func bind() {
+    guard !state.used, !state.armed, let window, UIApplication.shared.applicationState == .active else { return }
+    // Resolve only the hosting controller containing this background, never an
+    // arbitrary window's unrelated Switch or a private SwiftUI class name.
+    var responder: UIResponder? = self
+    var root: UIView?
+    while let current = responder {
+      if let host = current as? UIHostingController<AnyView> { root = host.view; break }
+      responder = current.next
+    }
+    guard let root, root.window === window else { return }
+    var matches: [UISwitch] = []
+    var pending: [(UIView, Int)] = [(root, 0)]
+    var visited = 0
+    while let (view, depth) = pending.popLast() {
+      guard visited < 256, depth < 32 else { return }
+      visited += 1
+      if let candidate = view as? UISwitch,
+         candidate.accessibilityIdentifier == "zoen-theme-automatic-probe" { matches.append(candidate) }
+      guard pending.count + view.subviews.count <= 256 else { return }
+      pending.append(contentsOf: view.subviews.map { ($0, depth + 1) })
+    }
+    guard matches.count == 1, let control = matches.first,
+          let ticket = state.arm(testID: control.accessibilityIdentifier) else { return }
+    guard ZoenThemeInputProbe.claim() else { state.retire(); return }
+    self.ticket = ticket
+    self.control = control
+    boundWindow = window
+    let observer = ZoenThemePassiveTouchRecognizer(owner: self)
+    recognizer = observer
+    window.addGestureRecognizer(observer)
+    control.addTarget(self, action: #selector(valueChanged(_:)), for: .valueChanged)
+    control.addTarget(self, action: #selector(controlCancelled(_:)), for: .touchCancel)
+    inactivity = NotificationCenter.default.addObserver(forName: UIApplication.willResignActiveNotification,
+                                                       object: nil, queue: .main) { [weak self] _ in
+      MainActor.assumeIsolated { self?.retire() }
+    }
+    report(.armed)
+  }
+  func retire() {
+    if state.armed { ZoenThemeInputProbe.stop() }
+    state.retire() // Revoke queued callbacks before detaching either observer.
+    if let recognizer { boundWindow?.removeGestureRecognizer(recognizer) }
+    recognizer = nil
+    control?.removeTarget(self, action: #selector(valueChanged(_:)), for: .valueChanged)
+    control?.removeTarget(self, action: #selector(controlCancelled(_:)), for: .touchCancel)
+    if let inactivity { NotificationCenter.default.removeObserver(inactivity) }
+    inactivity = nil
+    capturedTouch = nil
+    control = nil
+    boundWindow = nil
+  }
+  private func current() -> UISwitch? {
+    guard state.current(ticket), let control, let boundWindow,
+          window === boundWindow, control.window === boundWindow,
+          UIApplication.shared.applicationState == .active else {
+      if state.armed { retire() }
+      return nil
+    }
+    return control
+  }
+  func receive(_ touch: UITouch) -> Bool {
+    guard let control = current(), touch.window === boundWindow,
+          control.bounds.contains(touch.location(in: control)),
+          state.begin(generation: ticket, touch: 1) else { return false }
+    capturedTouch = touch
+    touchID = 1
+    report(.began, detail: describe(touch, control: control))
+    return true
+  }
+  func terminal(_ touches: Set<UITouch>, cancelled: Bool) {
+    guard let control = current(), let touch = capturedTouch,
+          touches.contains(where: { $0 === touch }),
+          state.phase(cancelled ? .cancelled : .ended, generation: ticket, touch: touchID) else { return }
+    report(cancelled ? .cancelled : .ended, detail: describe(touch, control: control))
+    if cancelled { retire(); return }
+    let captured = ticket
+    // UIKit may emit valueChanged after recognizer touchesEnded. Finish after
+    // this event's delivery, not after a guessed timer or an additional input.
+    DispatchQueue.main.async { [weak self] in
+      guard let self, self.state.current(captured) else { return }
+      self.retire()
+    }
+  }
+  @objc private func valueChanged(_ sender: UISwitch) {
+    guard sender === current(), state.phase(.valueChanged, generation: ticket, touch: touchID) else { return }
+    report(.valueChanged, detail: "isOn=\(sender.isOn)")
+  }
+  @objc private func controlCancelled(_ sender: UISwitch) {
+    guard sender === current(), state.phase(.controlCancelled, generation: ticket, touch: touchID) else { return }
+    report(.controlCancelled)
+  }
+  private func report(_ stage: ZoenThemeInputProbe.TouchStage, detail: String = "") {
+    ZoenThemeInputProbe.touch(stage, detail: detail)
+  }
+  private func describe(_ touch: UITouch, control: UISwitch) -> String {
+    let target = touch.view
+    let branch = target.map { $0 === control || $0.isDescendant(of: control) } ?? false
+    let name = target.map { String(NSStringFromClass(type(of: $0)).prefix(96)) } ?? "nil"
+    var gestures: [String] = []
+    var ancestor = target
+    var depth = 0
+    while let view = ancestor, depth < 32, gestures.count < 6 {
+      for gesture in view.gestureRecognizers ?? [] where !(gesture is ZoenThemePassiveTouchRecognizer) {
+        guard gestures.count < 6 else { break }
+        gestures.append("\(String(NSStringFromClass(type(of: gesture)).prefix(80))):\(gesture.state.rawValue):cancel=\(gesture.cancelsTouchesInView)")
+      }
+      ancestor = view.superview; depth += 1
+    }
+    return "target=\(name) branch=\(branch) recognizers=\(gestures.joined(separator: ","))"
+  }
+}
+
+@MainActor private final class ZoenThemePassiveTouchRecognizer: UIGestureRecognizer, UIGestureRecognizerDelegate {
+  private weak var owner: ZoenThemeTouchProbeView?
+  init(owner: ZoenThemeTouchProbeView) {
+    self.owner = owner
+    super.init(target: nil, action: nil)
+    cancelsTouchesInView = false
+    delaysTouchesBegan = false
+    delaysTouchesEnded = false
+    delegate = self
+  }
+  override func canPrevent(_ preventedGestureRecognizer: UIGestureRecognizer) -> Bool { false }
+  override func canBePrevented(by preventingGestureRecognizer: UIGestureRecognizer) -> Bool { false }
+  func gestureRecognizer(_ recognizer: UIGestureRecognizer, shouldReceive touch: UITouch) -> Bool { owner?.receive(touch) ?? false }
+  func gestureRecognizer(_ recognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith other: UIGestureRecognizer) -> Bool { true }
+  override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+    owner?.terminal(touches, cancelled: false)
+    state = .failed // Never recognize an action.
+  }
+  override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
+    owner?.terminal(touches, cancelled: true)
+    state = .failed
+  }
+}
