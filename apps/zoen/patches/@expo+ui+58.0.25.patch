@@ -0,0 +1,33 @@
+// Temporary #440 diagnostic; opt-in testID, no control-state changes.
+import OSLog
+
+@MainActor
+internal enum ZoenThemeInputProbe {
+  enum Stage: String {
+    case bindingSet = "native-binding-set"
+    case dispatchAttempt = "native-dispatch-attempt"
+    case dispatchReturned = "native-dispatch-returned"
+  }
+  enum TouchStage: String {
+    case armed = "native-touch-probe-armed"
+    case began = "native-touch-began"
+    case ended = "native-touch-ended"
+    case cancelled = "native-observer-touch-cancelled"
+    case valueChanged = "native-control-value-changed"
+    case controlCancelled = "native-control-touch-cancelled"
+  }
+  private static var budget = ZoenThemeProbeBudget()
+  private static let logger = Logger(subsystem: "com.zoen.theme-input", category: "Automatic")
+
+  static func claim() -> Bool { budget.claim() }
+  static func stop() { budget.stop() }
+  static func record(_ stage: Stage, testID: String?) {
+    guard testID == "zoen-theme-automatic-probe" else { return }
+    emit(stage.rawValue, detail: "")
+  }
+  static func touch(_ stage: TouchStage, detail: String) { emit(stage.rawValue, detail: detail) }
+  private static func emit(_ stage: String, detail: String) {
+    guard let count = budget.take() else { return }
+    logger.notice("[ZoenThemeInput] \(stage, privacy: .public) count=\(count, privacy: .public) \(detail, privacy: .public)")
+  }
+}
diff --git a/node_modules/@expo/ui/ios/Toggle/ZoenThemeTouchProbe.swift b/node_modules/@expo/ui/ios/Toggle/ZoenThemeTouchProbe.swift
