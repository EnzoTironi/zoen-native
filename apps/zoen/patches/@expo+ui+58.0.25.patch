@@ -0,0 +1,29 @@
+// Owns only touch-handler attachment, not application actions or view identity.
+internal final class RNHostTouchBinding<Child: AnyObject, Handler: AnyObject> {
+  private weak var handler: Handler?
+  private weak var child: Child?
+  private let attach: (Child) -> Handler?
+  private let detach: (Handler, Child) -> Void
+
+  init(attach: @escaping (Child) -> Handler?, detach: @escaping (Handler, Child) -> Void) {
+    self.attach = attach
+    self.detach = detach
+  }
+
+  func update(layoutRoot: Bool, child next: Child?) {
+    guard layoutRoot, let next else { retire(); return }
+    if child === next, handler != nil { return }
+    retire()
+    guard let handler = attach(next) else { return }
+    child = next
+    self.handler = handler
+  }
+
+  func retire() {
+    if let handler, let child { detach(handler, child) }
+    handler = nil
+    child = nil
+  }
+
+  deinit { retire() }
+}
