{
  "name": "@zoen/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Zoen React UI, with mini-app components and an independent application shell.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./tokens.css": "./src/tokens.css",
    "./shell": "./src/shell.tsx",
    "./shell.css": "./src/shell.css"
  },
  "scripts": {
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "test:web": "node --test web/*.test.ts",
    "build:web": "node web/build.mjs",
    "web": "node web/server.mjs",
    "typecheck:shell": "tsc --noEmit -p preview/tsconfig.json",
    "test:shell": "node --test preview/shell.test.mjs",
    "build:preview": "node preview/build.mjs",
    "preview": "node preview/build.mjs --serve"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.10",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
