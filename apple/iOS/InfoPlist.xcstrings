{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoen"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mini-app que você permitiu pode ver quando você está ocupado (não o que são seus eventos) para achar um horário."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-apps podem adicionar um evento que você revisa antes, como a trilha que o grupo escolheu."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zoen abre a câmera dentro da conversa para você fotografar algo para o grupo."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escolhe um contato para compartilhar o nome com um mini-app. O Zoen nunca lê sua agenda."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mini-app que você permitiu pode ver mais ou menos onde você está, por exemplo a que distância fica uma trilha. Fica neste iPhone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the mic in a chat to record a voice message. Zoen only listens while you hold or lock it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o microfone numa conversa para gravar um áudio. O Zoen só escuta enquanto você segura ou trava a gravação."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoen transcribes your voice messages on this iPhone so the chat can read them. The audio isn’t sent anywhere to be transcribed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zoen transcreve seus áudios neste iPhone para a conversa poder ler. O áudio não é enviado a lugar nenhum para ser transcrito."
          }
        }
      }
    }
  },
  "version": "1.0"
}