#!/usr/bin/env python3
"""Limit staged, maintained text files to 5,000 estimated tokens (bytes / 4)."""

import os
from pathlib import PurePosixPath
import subprocess
import sys


MAX_BYTES = 20_000
LOCKFILES = {
    "Cargo.lock", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock",
    "pnpm-lock.yaml", "bun.lock", "bun.lockb", "Podfile.lock", "Package.resolved",
    "Gemfile.lock", "composer.lock", "poetry.lock", "uv.lock", "Pipfile.lock",
    "packages.lock.json", "flake.lock", "deno.lock", ".terraform.lock.hcl",
}
GENERATED_DIRS = {"generated", "__generated__"}
THIRD_PARTY_DIRS = {"node_modules", "vendor", "vendored", "third_party", "third-party"}
GENERATED_ROOTS = ("apps/zoen/ios/", "apps/zoen/android/")
UPSTREAM_ROOTS = ("miniapps/deckcraft-ui/licenses/",)
UPSTREAM_FILES = {"miniapps/deckcraft-ui/BOOTSTRAP-LICENSES.txt"}
# Exact unmodified upstream imports only. A locally edited fork loses its
# exception automatically; both Git object formats identify the same bytes.
PINNED_UPSTREAM_BLOBS = {
    "miniapps/excalidraw-ui/src/sounds.ts": {
        b"c8bb01d991a35e0ea20157a7e7623425e6c99fd8",
        b"77cea53cf77e68e06eaeb276d379057e0dcdad72e0de7d8ca4e49d52e956ee9a",
    },
    "apps/zoen/modules/zoen-core/ios/TelegramAttachmentPresentation/Resources/TabArticle.json": {
        b"f8a9d152fc7666a9016ed1a9f6f567cda6e729a6",
        b"5067b06d24eac4b3d608ef4c1f5a1cfb539dab5f318af87c951d101c1f1909b0",
    },
}
# Compiled outputs: the authored entry points/builders remain checked. Producer
# and upstream provenance are recorded in docs/dev/file-size-artifact-exclusions.md.
GENERATED_FILES = {
    "crates/miniapps/resources/" + name + ".html"
    for name in ("countdown", "deckcraft", "excalidraw", "hike", "list", "maptap",
                 "pet", "poll", "recipe", "schedule")
} | {"apps/zoen/modules/zoen-core/ios/EmojiKeyboard/ZoenEmojiKeyboardData.swift"}
EXTERNAL_FILES = {
    "LICENSE", "LICENSES/GPL-3.0.txt",
    "miniapps/excalidraw-ui/THIRD-PARTY-LICENSES.txt",
    "apps/zoen/modules/zoen-core/ios/EmojiKeyboard/emoji1.txt",
} | {
    "apps/zoen/modules/zoen-core/ios/TelegramAttachmentPresentation/Resources/" + name
    for name in ("TabPhoto.json", "TabFile.json", "TabAudio.json", "TabLocation.json",
                 "TabPoll.json", "Files.json", "Notices/Telegram-GPL-3.0.txt")
} | {
    "apps/zoen/modules/zoen-core/ios/TelegramFileAttachment/Resources/Notices/Telegram-GPL-3.0.txt",
    "apps/zoen/modules/zoen-core/ios/TelegramVideoEditing/Resources/Notices/GPL-3.0.txt",
}
BINARY_SUFFIXES = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".heic", ".heif", ".ico",
    ".avif", ".icns", ".mp4", ".mov", ".webm", ".mkv", ".m4a", ".mp3",
    ".wav", ".ogg", ".flac", ".aac", ".pdf", ".woff", ".woff2", ".ttf",
    ".otf", ".wasm", ".zip", ".gz", ".bz2", ".xz", ".7z", ".tar",
    ".a", ".so", ".dylib", ".dll", ".exe", ".o", ".rlib", ".rmeta",
    ".pptx", ".docx", ".xlsx", ".deckcraft",
}


def git(*args, input_bytes=None):
    return subprocess.run(
        ["git", *args], input=input_bytes, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, check=True,
    ).stdout


def exempt(path, oid=None):
    """Repository conventions and pinned imports, never author identity or claims."""
    name = PurePosixPath(path)
    return (
        name.name in LOCKFILES
        or bool(set(name.parts) & (GENERATED_DIRS | THIRD_PARTY_DIRS))
        or ".generated." in name.name
        or path.startswith(GENERATED_ROOTS + UPSTREAM_ROOTS)
        or path in UPSTREAM_FILES
        or path in GENERATED_FILES
        or path in EXTERNAL_FILES
        or oid in PINNED_UPSTREAM_BLOBS.get(path, ())
        or name.suffix.lower() in BINARY_SUFFIXES
    )


def staged_candidates():
    # --no-renames represents a rename as delete/add; only its new blob is checked.
    fields = git(
        "diff", "--cached", "--raw", "--no-abbrev", "--no-renames",
        "--diff-filter=ACMT", "-z", "--",
    ).split(b"\0")
    candidates = []
    for index in range(0, len(fields) - 1, 2):
        header = fields[index].split()
        if len(header) != 5 or not header[0].startswith(b":"):
            raise ValueError("Cannot parse staged file metadata")
        path = os.fsdecode(fields[index + 1])
        # Symlinks contain link text, not the target file; submodules aren't files.
        if header[1] in (b"100644", b"100755") and not exempt(path, header[3]):
            candidates.append((path, header[3]))
    return candidates


def object_sizes(candidates):
    ids = sorted({oid for _, oid in candidates})
    if not ids:
        return {}
    result = git(
        "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)",
        input_bytes=b"\n".join(ids) + b"\n",
    )
    sizes = {}
    for line in result.splitlines():
        fields = line.split()
        if len(fields) != 3 or fields[1] != b"blob":
            raise ValueError("Cannot inspect a staged blob")
        sizes[fields[0]] = int(fields[2])
    if set(sizes) != set(ids):
        raise ValueError("Missing staged blob metadata")
    return sizes


def is_binary(oid):
    # Git's usual binary heuristic. Read a bounded prefix, never a whole large blob.
    process = subprocess.Popen(
        ["git", "cat-file", "blob", oid.decode("ascii")],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    try:
        prefix = process.stdout.read(8192)
    finally:
        process.stdout.close()
        process.wait()
    if len(prefix) != 8192:
        raise ValueError("Cannot read a staged blob")
    return b"\0" in prefix


def main():
    try:
        candidates = staged_candidates()
        sizes = object_sizes(candidates)
        violations = [
            (path, sizes[oid]) for path, oid in candidates
            if sizes[oid] > MAX_BYTES and not is_binary(oid)
        ]
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print("pre-commit: unable to check staged file sizes: " + str(error), file=sys.stderr)
        return 1
    if not violations:
        return 0
    print(
        "\nCommit blocked: staged authored files must be <= 5,000 tokens "
        "(20,000 bytes; tokens = bytes / 4).", file=sys.stderr,
    )
    for path, size in violations:
        print("  {}: {:,} bytes = {:,.2f} tokens".format(ascii(path), size, size / 4),
              file=sys.stderr)
    print(
        "\nSplit the staged files before committing:\n"
        "  1. Extract cohesive responsibilities into sibling modules; keep the public\n"
        "     entry point thin. Each resulting file must be <= 20,000 bytes.\n"
        "  2. Split tests by behavior and share intentional helpers/fixtures. Split\n"
        "     documents by topic with index links; use supported includes for configs.\n"
        "  3. Update imports, exports and callers; run the affected checks.\n"
        "  4. git add the revised files and new modules, then commit again.\n"
        "Do not minify, strip comments, arbitrarily chunk lines, or label authored\n"
        "code as generated/vendor to evade the limit. Only staged blobs are checked.\n"
        "Policy and exclusions: docs/dev/staged-file-size.md\n",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
