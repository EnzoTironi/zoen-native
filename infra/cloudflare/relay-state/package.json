{
  "name": "zoen-cloudflare-relay-state",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:remote": "node test/remote.mjs",
    "check": "node --check src/index.mjs",
    "deploy": "wrangler deploy",
    "build:closed": "node ../../../scripts/build-cloudflare-closed.mjs",
    "test:closed": "node --test tests/closed-state.test.mjs",
    "verify:closed": "node ../../../scripts/verify-cloudflare-closed.mjs",
    "deploy:closed": "wrangler deploy --config wrangler.closed.jsonc",
    "test:directory": "node --test tests/directory-state.test.mjs",
    "verify:directory": "node ../../../scripts/verify-cloudflare-directory.mjs",
    "deploy:directory": "wrangler deploy --config wrangler.directory.jsonc",
    "test:provider": "node --test tests/provider-state.test.mjs",
    "verify:provider": "node ../../../scripts/verify-cloudflare-provider.mjs --host",
    "test:media": "node --test tests/media-blobs.test.mjs",
    "verify:media": "node ../../../scripts/verify-cloudflare-directory.mjs --media"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta"
  }
}
