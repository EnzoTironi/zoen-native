{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zoen-relay-closed",
  "main": "src/closed-index.mjs",
  "account_id": "86e8a5b2686413989e8bef1f75c29079",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "services": [
    {
      "binding": "RELAY_DIRECTORY",
      "service": "zoen-relay-directory",
      "entrypoint": "RelayDispatch"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOSED_SPACE",
        "class_name": "ClosedSpace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ClosedSpace"
      ]
    }
  ],
  "build": {
    "command": "node \"$(git rev-parse --show-toplevel)/scripts/build-cloudflare-closed.mjs\""
  }
}
