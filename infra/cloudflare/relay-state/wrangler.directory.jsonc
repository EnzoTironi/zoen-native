{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zoen-relay-directory",
  "account_id": "86e8a5b2686413989e8bef1f75c29079",
  "main": "src/directory-index.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "zoen-private-blobs" }],
  "vars": {
    "DIRECTORY_CELL": "zoen-private-directory-v1",
    "RELAY_NAME": "zoen-cloudflare-private",
    "RELAY_PROTOCOL_ENABLED": "false",
    "RELAY_ALLOWED_ORIGINS": "[\"https://app.tryzoen.com\"]"
  },
  "durable_objects": { "bindings": [{ "name": "DIRECTORY", "class_name": "DirectoryState" }] },
  "migrations": [{ "tag": "directory-v1", "new_sqlite_classes": ["DirectoryState"] }],
  "services": [{ "binding": "CLOSED_RELAY", "service": "zoen-relay-closed" }],
  "build": { "command": "node \"$(git rev-parse --show-toplevel)/scripts/build-cloudflare-closed.mjs\"" }
}
