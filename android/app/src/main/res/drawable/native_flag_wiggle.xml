<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/native_flag">
    <target android:name="symbol">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="-12" android:valueType="floatType" android:duration="70" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-12" android:valueTo="12" android:valueType="floatType" android:duration="70" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="12" android:valueTo="-8" android:valueType="floatType" android:duration="70" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-8" android:valueTo="8" android:valueType="floatType" android:duration="70" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="8" android:valueTo="0" android:valueType="floatType" android:duration="70" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
