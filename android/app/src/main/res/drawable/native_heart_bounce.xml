<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/native_heart">
    <target android:name="symbol">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-4" android:valueType="floatType" android:duration="134" android:interpolator="@android:interpolator/fast_out_slow_in"/>
                <objectAnimator android:propertyName="translateY" android:valueFrom="-4" android:valueTo="0" android:valueType="floatType" android:duration="134" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            </set>
        </aapt:attr>
